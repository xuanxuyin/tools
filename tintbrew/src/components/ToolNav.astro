---
/**
 * Quick hop between the site's main sections — one pill bar under the hero
 * so the flagship pages are always one tap from each other (user call,
 * 2026-10-29: page-to-page navigation was buried in footer links only).
 * Pure SSR, no island.
 */
const links = [
  { href: '/color-mixer', label: 'Color Mixer' },
  { href: '/color-converter', label: 'Converter' },
  { href: '/mix/', label: 'Color Mixes' },
  { href: '/color-guides/', label: 'Guides' },
  { href: '/perler-bead-patterns/', label: 'Bead Patterns' },
];

const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<nav class="tool-nav" aria-label="Site tools">
  {
    links.map((l) => (
      <a href={l.href} aria-current={current === normalize(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .tool-nav {
    display: flex;
    gap: var(--sp-1);
    flex-wrap: wrap;
    margin-top: var(--sp-3);
  }

  .tool-nav a {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .tool-nav a:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tool-nav a[aria-current='page'] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    cursor: default;
  }
</style>
