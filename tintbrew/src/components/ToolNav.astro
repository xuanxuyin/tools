---
/**
 * Quick hop between the site's main sections — one pill bar under the hero
 * so the flagship pages are always one tap from each other (user call,
 * 2026-10-29: page-to-page navigation was buried in footer links only).
 * Pure SSR, no island.
 *
 * Icons sit OUTSIDE the [data-i18n] span: i18n apply() rewrites the tagged
 * node's textContent and would wipe a child SVG on language switch.
 */
import { ICONS } from '../lib/icons';

const links = [
  {
    href: '/color-mixer',
    label: 'Color Mixer',
    i18n: 'nav.mixer',
    icon: ICONS.mixer,
  },
  {
    href: '/color-converter',
    label: 'Converter',
    i18n: 'nav.converter',
    icon: ICONS.converter,
  },
  {
    href: '/mix/',
    label: 'Color Mixes',
    i18n: 'nav.mixes',
    icon: ICONS.mixes,
  },
  {
    href: '/color-guides/',
    label: 'Guides',
    i18n: 'toolnav.guides',
    icon: ICONS.guides,
  },
  {
    href: '/perler-bead-patterns/',
    label: 'Bead Patterns',
    i18n: 'toolnav.patterns',
    icon: ICONS.patterns,
  },
  {
    href: '/gallery/',
    label: 'Gallery',
    i18n: 'toolnav.gallery',
    icon: ICONS.gallery,
  },
];

const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<nav class="tool-nav" aria-label="Site tools">
  {
    links.map((l) => (
      <a href={l.href} aria-current={current === normalize(l.href) ? 'page' : undefined}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
        <span data-i18n={l.i18n}>{l.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .tool-nav {
    display: flex;
    gap: var(--sp-1);
    flex-wrap: wrap;
    margin-top: var(--sp-3);
  }

  .tool-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: var(--shadow-xs);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .tool-nav a svg {
    flex: none;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .tool-nav a:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tool-nav a:hover svg {
    opacity: 1;
  }

  .tool-nav a[aria-current='page'] {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(120deg, #7c3aed, #a855f7);
    cursor: default;
  }

  .tool-nav a[aria-current='page'] svg {
    opacity: 1;
  }
</style>
