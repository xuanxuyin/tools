---
/**
 * Shared gallery template for the bead family landing pages: the hub (all
 * categories as sections), the three category galleries, and the easy
 * cross-category gallery. Cards carry the server-rendered reference figure,
 * so the gallery is complete without JS.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BeadFigure from './BeadFigure.astro';
import type { PatternView } from '../lib/beadContent';
import type { BeadSeoDef } from '../data/beadSeo';
import { SITE } from '../consts';

export interface BeadGroup {
  label: string;
  /** uiStrings key for the label, when the group header translates */
  labelKey?: string;
  /** link out when the group has its own landing page */
  href?: string;
  blurb?: string;
  blurbKey?: string;
  patterns: PatternView[];
}

interface Props {
  seo: BeadSeoDef;
  groups: BeadGroup[];
}

const { seo, groups } = Astro.props;
const [lead, ...prose] = seo.intro;
const totalCount = groups.reduce((s, g) => s + g.patterns.length, 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: seo.h1, item: `${SITE.url}${seo.path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: seo.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={seo.title} description={seo.description} path={seo.path.replace(/\/$/, '')} jsonLd={jsonLd}>
  <section class="hero">
    <p class="crumbs">
      <a href="/" data-i18n="a11y.home">Home</a> <span aria-hidden="true">›</span>
      <span>{seo.h1}</span>
    </p>
    <h1 data-i18n={seo.k?.h1}>{seo.h1}</h1>
    <p class="lead" data-i18n={seo.k?.intro[0]}>{lead}</p>
    <p class="stat-row" aria-label="Collection facts">
      <span class="stat">
        <strong>{totalCount}</strong>
        <span data-i18n="bs.statPatterns">patterns</span>
      </span>
      <span class="stat">
        <span data-i18n="bs.statFreeA">all</span> <strong data-i18n="bs.statFreeM">free</strong>
        <span data-i18n="bs.statFreeB">to print</span>
      </span>
      <span class="stat">
        <strong>32</strong>
        <span data-i18n="bs.statColors">bead colors</span>
      </span>
    </p>
  </section>

  {prose.length > 0 && (
    <section class="prose" style="margin-top: var(--sp-4);">
      {prose.map((p, i) => <p data-i18n={seo.k?.intro[i + 1]}>{p}</p>)}
    </section>
  )}

  <!-- optional per-page slot between the intro and the first gallery -->
  <slot />

  {groups.map((g) => (
    <section class="gallery" style="margin-top: var(--sp-6);">
      <h2>
        {g.href ? (
          <a href={g.href} data-i18n={g.labelKey}>{g.label}</a>
        ) : (
          <span data-i18n={g.labelKey}>{g.label}</span>
        )}
        <span class="count" data-i18n="bs.countN" data-i18n-args={JSON.stringify({ n: String(g.patterns.length) })}> — {g.patterns.length} patterns</span>
      </h2>
      {g.blurb && <p class="group-blurb" data-i18n={g.blurbKey}>{g.blurb}</p>}
      <div class="card-grid">
        {g.patterns.map((p) => (
          <a class="pattern-card" href={p.url}>
            <BeadFigure view={p} mode="reference" thumb />
            <span class="card-name">{p.def.name}</span>
            <span class="card-tag">{p.def.tagline}</span>
            <span
              class="card-meta"
              data-i18n="bs.cardMeta"
              data-i18n-args={JSON.stringify({ n: String(p.totalBeads), z: String(p.regions.length), d: p.def.difficulty })}
            >
              {p.totalBeads} beads · {p.regions.length} zones · {p.def.difficulty}
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="bs.faqH">FAQ</h2>
    {seo.faqs.map((f, i) => (
      <details class="faq">
        <summary data-i18n={seo.k?.fq[i]}>{f.q}</summary>
        <p data-i18n={seo.k?.fa[i]}>{f.a}</p>
      </details>
    ))}
  </section>
</BaseLayout>

<style>
  .stat-row { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }
  .stat {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
  }
  .gallery h2 .count { font-weight: 400; font-size: 0.9em; color: var(--ink-soft, #666); }
  .gallery h2 a { color: inherit; }
  .group-blurb { color: var(--ink-soft, #666); margin: var(--sp-2) 0 0; }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .pattern-card {
    display: grid;
    gap: 6px;
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    background: var(--bg, #fff);
  }
  .pattern-card:hover { border-color: var(--accent, #b3552e); }
  .card-name { font-weight: 600; }
  .card-tag { font-size: 0.8rem; color: var(--ink-soft, #666); line-height: 1.35; }
  .card-meta { font-size: 0.75rem; color: var(--ink-soft, #999); font-variant-numeric: tabular-nums; }
</style>
