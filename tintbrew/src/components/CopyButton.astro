---
/** Copy button. `data-copy` is read at click time by scripts/copy.ts, so the
 *  island can update the attribute when a value changes — no rewiring.
 *  `link` renders a data-copy-link button instead: copies the live page URL
 *  (the island keeps it in sync via history.replaceState).
 *
 *  Icons sit OUTSIDE the [data-i18n] span: i18n apply() rewrites the tagged
 *  node's textContent, which would wipe any child SVG. copy.ts swaps ONLY
 *  the .copy-label span on success (official Lucide copy/check pair swap via
 *  the .copied class — see global.css). */
import { iconSvg } from '../lib/icons';

interface Props {
  value?: string;
  /** Accessible description of what is copied */
  label?: string;
  /** Copy the current page URL (share link) instead of a static value */
  link?: boolean;
}

const { value, label, link } = Astro.props;
---

{
  link ? (
    <button type="button" class="btn btn-copy" data-copy-link aria-label={`Copy ${label ?? 'link'}`}>
      <span class="copy-ic" aria-hidden="true">
        <Fragment set:html={iconSvg('copy', 14)} />
      </span>
      <span class="copy-ic copy-ic-ok" aria-hidden="true">
        <Fragment set:html={iconSvg('check', 14)} />
      </span>
      <span class="copy-label" data-i18n="btn.copyLink">
        Copy link
      </span>
    </button>
  ) : (
    <button type="button" class="btn btn-copy" data-copy={value} aria-label={`Copy ${label ?? 'value'}`}>
      <span class="copy-ic" aria-hidden="true">
        <Fragment set:html={iconSvg('copy', 14)} />
      </span>
      <span class="copy-ic copy-ic-ok" aria-hidden="true">
        <Fragment set:html={iconSvg('check', 14)} />
      </span>
      <span class="copy-label" data-i18n="btn.copy">
        Copy
      </span>
    </button>
  )
}
