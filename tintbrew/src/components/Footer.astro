---
import { SITE } from '../consts';
import { scenarioContents } from '../lib/scenarioContent';
import { outfitContents } from '../lib/outfitContent';
import { BEAD_HUB_SEO } from '../data/beadSeo';
import { iconSvg } from '../lib/icons';

// V2.1 scenario + V2.2 pairing pages — data-driven so later waves appear here automatically.
const guides = [...scenarioContents, ...outfitContents].map((s) => s.def);

// Footer shows only the head terms (user call, 2026-11-10: "列举的太多了，
// 弄两三个用的多就好了") — brown is the volume king, purple/green are the
// three-color head cluster; the rest stay linked from /color-guides/ hub.
const FOOTER_GUIDE_SLUGS = [
  'what-colors-make-brown',
  'what-colors-make-purple',
  'what-colors-make-green',
];
const footerGuides = FOOTER_GUIDE_SLUGS.map(
  (slug) => guides.find((g) => g.slug === slug)!,
).filter(Boolean);

// V2.2 bead family. Footer shows only the head entries (user call,
// 2026-11-10, same trim as the color guides column): the hub is the head
// term and photo/editor are the two unique tools — every category and
// collection landing stays linked from the hub page itself.
// (food + christmas galleries retired with the hand-drawn set, 2026-10-28;
// halloween got its own gallery back 2026-10-29)
const beadLinks = [
  BEAD_HUB_SEO,
  { path: '/photo-to-perler-bead-pattern/', h1: 'Photo to Bead Pattern' },
  { path: '/bead-editor/', h1: 'Bead Pattern Editor' },
];

// Popular mixes — varied anchor text on purpose (internal-link diversity).
// i18n: one template per phrasing; {a}/{b} are color ids that resolve
// through the color.* dictionary at swap time (label is the English SSR text).
const popularMixes = [
  { href: '/mix/red-blue', key: 'mix.qWhat', a: 'red', b: 'blue', label: 'What red and blue make' },
  { href: '/mix/blue-yellow', key: 'mix.qPlus', a: 'blue', b: 'yellow', label: 'Blue + yellow result' },
  { href: '/mix/red-green', key: 'mix.qAnd', a: 'red', b: 'green', label: 'Red and green mixed' },
  { href: '/mix/black-white', key: 'mix.qMixing', a: 'black', b: 'white', label: 'Mixing black and white' },
  { href: '/mix/red-yellow', key: 'mix.qPlusWord', a: 'red', b: 'yellow', label: 'Red plus yellow' },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="foot-head">
          <span class="foot-ic" aria-hidden="true"><Fragment set:html={iconSvg('palette', 14)} /></span>
          <h3 data-i18n="foot.tools">Tools</h3>
        </div>
        <ul>
          <li><a href="/color-mixer" data-i18n="nav.mixer">Color Mixer</a></li>
          <li><a href="/color-converter" data-i18n="nav.converter">Color Converter</a></li>
          <li><a href="/hue-test" data-i18n="nav.hueTest">Hue Test</a></li>
          <li><a href="/gallery/" data-i18n="toolnav.gallery">Gallery</a></li>
          <li><a href="/coloring/" data-i18n="toolnav.coloring">Coloring</a></li>
          <li><a href="/mix" data-i18n="foot.allMixes">All Color Mixes</a></li>
        </ul>
      </div>
      <div>
        <div class="foot-head">
          <span class="foot-ic" aria-hidden="true"><Fragment set:html={iconSvg('mixes', 14)} /></span>
          <h3 data-i18n="foot.popular">Popular mixes</h3>
        </div>
        <ul>
          {popularMixes.map((m) => (
            <li>
              <a href={m.href} data-i18n={m.key} data-i18n-args={JSON.stringify({ a: m.a, b: m.b })}>
                {m.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="foot-head">
          <span class="foot-ic" aria-hidden="true"><Fragment set:html={iconSvg('guides', 14)} /></span>
          <h3 data-i18n="foot.guides">Color guides</h3>
        </div>
        <ul>
          {footerGuides.map((g) => <li><a href={`/${g.slug}`} data-i18n={`guide.${g.slug}`}>{g.h1}</a></li>)}
          <li><a href="/color-guides" data-i18n="foot.allGuides">All guides</a></li>
        </ul>
      </div>
      <div>
        <div class="foot-head">
          <span class="foot-ic" aria-hidden="true"><Fragment set:html={iconSvg('patterns', 14)} /></span>
          <h3 data-i18n="foot.beads">Bead patterns</h3>
        </div>
        <ul>
          {beadLinks.map((b) => {
            const key = 'k' in b && b.k?.h1
              ? b.k.h1
              : b.path === '/photo-to-perler-bead-pattern/'
                ? 'home.cardPhoto'
                : b.path === '/bead-editor/'
                  ? 'foot.editor'
                  : undefined;
            return (
              <li>
                <a href={b.path} data-i18n={key}>{b.h1}</a>
              </li>
            );
          })}
        </ul>
      </div>
      <div>
        <div class="foot-head">
          <span class="foot-ic" aria-hidden="true"><Fragment set:html={iconSvg('info', 14)} /></span>
          <h3 data-i18n="foot.site">Site</h3>
        </div>
        <ul>
          <li><a href="/about" data-i18n="foot.about">About</a></li>
          <li><a href="/privacy" data-i18n="foot.privacy">Privacy Policy</a></li>
          <li><a href="/contact" data-i18n="foot.contact">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {SITE.name}. <span data-i18n="foot.rights">All rights reserved.</span></span>
      <span data-i18n="foot.tagline">Free color tools. Everything runs in your browser.</span>
    </div>
  </div>
</footer>
