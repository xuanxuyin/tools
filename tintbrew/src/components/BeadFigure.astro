---
/**
 * One pattern rendered as an SVG pegboard. Two modes from the same data:
 *
 *  - reference: every zone filled with its default bead color (static)
 *  - blank:     paper-tinted zones with the zone key letter in each bead —
 *               the coloring canvas. The island recolors zones by setting
 *               `--bd-<key>` custom properties on the wrapper; beads read
 *               fill from those vars, so one assignment recolors a whole
 *               zone with zero per-bead DOM work.
 *
 * Board rendering matches the source-site editor (user call, 2026-10-29):
 * beads are contiguous full cells — no inset, no rounding — so color areas
 * read as one solid picture, and empty cells are gray pegboard with a small
 * round peg hole. No-JS guarantee unchanged: the blank figure still shows
 * every zone divided and labeled, printable as a complete template.
 */
import type { PatternView } from '../lib/beadContent';

interface Props {
  view: PatternView;
  mode: 'reference' | 'blank';
  /**
   * Card-thumbnail mode. Boards wider than 40 beads collapse each f×f
   * block to its majority zone — at 150px card size the loss is invisible,
   * and hub/gallery pages stay far under Cloudflare Pages' 25 MiB
   * single-file cap (the all-bead hub hit 25.3 MiB and every deploy
   * failed at asset validation). Detail pages never pass thumb: every
   * bead always renders there.
   */
  thumb?: boolean;
}

const { view, mode, thumb = false } = Astro.props;
const U = 10; // viewBox units per bead cell
const { grid, def } = view;

let rows = grid;
if (thumb && def.width > 40) {
  const f = Math.ceil(def.width / 40);
  const out: string[] = [];
  for (let y = 0; y < grid.length; y += f) {
    let line = '';
    for (let x = 0; x < def.width; x += f) {
      const counts = new Map<string, number>();
      for (let dy = 0; dy < f && y + dy < grid.length; dy++) {
        for (let dx = 0; dx < f && x + dx < def.width; dx++) {
          const ch = grid[y + dy]![x + dx]!;
          counts.set(ch, (counts.get(ch) ?? 0) + 1);
        }
      }
      // majority non-empty key; '.' only wins when empty pegs strictly
      // outnumber it, so one-bead outlines survive the decimation
      let best = '.';
      let n = 0;
      for (const [ch, c] of counts) {
        if (ch !== '.' && c > n) { n = c; best = ch; }
      }
      line += (counts.get('.') ?? 0) > n ? '.' : best;
    }
    out.push(line);
  }
  rows = out;
}
const cols = rows[0]?.length ?? def.width;
const w = cols * U;
const h = rows.length * U;

const cells: { x: number; y: number; key: string }[] = [];
const holes: { x: number; y: number }[] = [];
rows.forEach((row, y) => {
  for (let x = 0; x < row.length; x++) {
    const ch = row[x]!;
    if (ch !== '.') cells.push({ x: x * U, y: y * U, key: ch });
    else holes.push({ x: x * U, y: y * U });
  }
});

const hexFor = (key: string) =>
  view.regions.find((r) => r.key === key)?.hex ?? '#888888';

const label =
  mode === 'reference'
    ? `${def.name} bead pattern, colored reference`
    : `${def.name} bead template, zones outlined for coloring`;
---

<svg
  class="bead-fig"
  data-bead-mode={mode}
  data-pattern={def.slug}
  viewBox={`0 0 ${w} ${h}`}
  role="img"
  aria-label={label}
>
  <g class="bd-pegs" aria-hidden="true">
    {holes.map((p) => (
      <circle class="bd-peg" cx={p.x + U / 2} cy={p.y + U / 2} r={1.6} />
    ))}
  </g>
  {cells.map((c) => {
    const hex = hexFor(c.key);
    return mode === 'reference' ? (
      <rect
        class="bd bd-fill"
        data-region={c.key}
        x={c.x}
        y={c.y}
        width={U}
        height={U}
        fill={hex}
      />
    ) : (
      <g class="bd bd-blank" data-region={c.key}>
        <rect
          x={c.x}
          y={c.y}
          width={U}
          height={U}
          fill={hex}
          fill-opacity="0.14"
          stroke={hex}
          stroke-opacity="0.5"
          stroke-width="0.5"
          style={`--z:${hex}`}
        />
        <text
          class="bd-key"
          x={c.x + U / 2}
          y={c.y + U / 2}
          text-anchor="middle"
          dominant-baseline="central"
          fill={hex}
          fill-opacity="0.75"
        >
          {c.key}
        </text>
      </g>
    );
  })}
</svg>

<style>
  .bead-fig {
    display: block;
    width: 100%;
    height: auto;
    /* pegboard simulation: gray base with round peg holes where no bead
       sits — same look as the source-site editor (user call, 2026-10-29) */
    background: #e2e4df;
    border-radius: 10px;
  }
  .bead-fig .bd-peg {
    fill: rgba(0, 0, 0, 0.15);
  }
  .bead-fig .bd-key {
    font-size: 4.6px;
    font-weight: 600;
    user-select: none;
    pointer-events: none;
  }
  /* Zone fills for the blank canvas — the island overrides these per zone. */
  .bead-fig[data-bead-mode='blank'] .bd-blank rect {
    cursor: pointer;
    transition: fill 120ms ease;
  }
  .bead-fig[data-bead-mode='blank'] .bd-blank.colored rect {
    fill: var(--zone, #fff);
    fill-opacity: 1;
    stroke-opacity: 0.22;
  }
  .bead-fig[data-bead-mode='blank'] .bd-blank.colored .bd-key {
    display: none;
  }
</style>
