---
import { SITE } from '../consts';

interface Props {
  /** Full <title> content (page-level caller composes brand suffix) */
  title: string;
  /** Meta description, ≤155 chars */
  description: string;
  /** Canonical path only, e.g. '/mix/red-blue' — never a query string */
  path: string;
  /** JSON-LD object(s) to emit in <head> */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** true only for 404 */
  noindex?: boolean;
  /** Site-rooted path, defaults to /og-default.png */
  ogImage?: string;
}

const { title, description, path, jsonLd, noindex = false, ogImage = '/og-default.png' } = Astro.props;

const canonical = new URL(path, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;
const jsonLdItems: Record<string, unknown>[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION ?? SITE.gscVerification;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

{gsc && <meta name="google-site-verification" content={gsc} />}
{jsonLdItems.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
