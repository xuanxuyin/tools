---
import { ICONS } from '../lib/icons';
import { SITE } from '../consts';
import LangSwitch from './LangSwitch.astro';

// Icons live OUTSIDE the [data-i18n] span on purpose: i18n apply() rewrites
// the tagged node's textContent, which would wipe any child SVG on language
// switch. SVGs carry no <title>/<text> — i18n.test pins the link text.
const nav = [
  {
    href: '/color-mixer',
    label: 'Color Mixer',
    i18n: 'nav.mixer',
    icon: ICONS.mixer,
  },
  {
    href: '/color-converter',
    label: 'Color Converter',
    i18n: 'nav.converter',
    icon: ICONS.converter,
  },
  {
    href: '/hue-test',
    label: 'Hue Test',
    i18n: 'nav.hueTest',
    icon: ICONS.hueTest,
  },
  {
    href: '/bead-editor/',
    label: 'Bead Editor',
    i18n: 'nav.editor',
    icon: ICONS.penTool,
  },
  {
    href: '/mix',
    label: 'Color Mixes',
    i18n: 'nav.mixes',
    icon: ICONS.mixes,
  },
  {
    href: '/color-guides/',
    label: 'Guides',
    i18n: 'toolnav.guides',
    icon: ICONS.guides,
  },
  {
    href: '/perler-bead-patterns/',
    label: 'Bead Patterns',
    i18n: 'toolnav.patterns',
    icon: ICONS.patterns,
  },
];

const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="tb-logo" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#7c3aed"></stop>
            <stop offset="0.5" stop-color="#a855f7"></stop>
            <stop offset="1" stop-color="#db2777"></stop>
          </linearGradient>
        </defs>
        <rect width="64" height="64" rx="16" fill="url(#tb-logo)"></rect>
        <circle cx="25" cy="34" r="13" fill="#ffffff" opacity="0.9"></circle>
        <circle cx="39" cy="34" r="13" fill="#ffffff" opacity="0.55"></circle>
      </svg>
      <span>TintBrew</span>
    </a>
    <nav aria-label="Main navigation">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current === normalize(item.href) ? 'page' : undefined}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
            <span data-i18n={item.i18n}>{item.label}</span>
          </a>
        ))
      }
    </nav>
    <LangSwitch />
  </div>
</header>
