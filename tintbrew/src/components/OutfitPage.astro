---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mixer from './Mixer.astro';
import OutfitFigure from './OutfitFigure.astro';
import { outfitJsonLd, type OutfitView } from '../lib/outfitContent';

/**
 * Shared template for V2.2 outfit-pairing pages. All numeric copy (nearest
 * names, Oklab reads, ladders) arrives computed from lib/outfitContent.ts;
 * the page is fully server-rendered — scripts/mixer.ts only adds interaction.
 */
interface Props {
  v: OutfitView;
}

const { v } = Astro.props;
const { def } = v;
const roleLabel: Record<string, string> = {
  top: 'top',
  pants: 'pants / skirt',
  outer: 'layer',
  shoes: 'shoes',
  accent: 'accent',
};
---

<BaseLayout
  title={def.metaTitle}
  description={def.metaDescription}
  path={`/${def.slug}`}
  jsonLd={outfitJsonLd(v)}
  ogImage={`/og/${def.slug}.png`}
>
  <section class="hero no-print">
    <p class="crumbs">
      <a href="/">Home</a> <span aria-hidden="true">›</span>
      <a href="/color-guides">Color Guides</a> <span aria-hidden="true">›</span>
      <span>{def.h1}</span>
    </p>
    <h1>{def.h1}</h1>
    <p class="lead">{def.lead}</p>

    <div class="hero-answer" aria-label="The anchor color at a glance">
      <span class="hero-swatches" aria-hidden="true">
        <span class="hero-result" style={`background:${def.baseHex}`}></span>
        <span class="hero-plus">+</span>
        {v.heroStrip.slice(1).map((h) => <span style={`background:${h}`}></span>)}
      </span>
      <strong>{def.baseName}</strong>
      <code>{def.baseHex}</code>
    </div>
  </section>

  <div class="no-print">
    <Mixer initialColors={def.mixerColors} compact title="Try a pairing yourself" />
  </div>

  <section class="prose no-print" style="margin-top: var(--sp-6);">
    <h2>{def.introHeading}</h2>
    {def.intro.map((p) => <p>{p}</p>)}
  </section>

  <section class="combos-section" style="margin-top: var(--sp-6);">
    <div class="combos-head no-print">
      <h2>{def.combosHeading}</h2>
      <p>
        Each card shows the outfit on a figure, the exact swatches with copyable HEX codes, and a
        computed read-out: the Oklab lightness gap and hue relation between the anchor piece and
        its strongest partner. Print this page and the cards become tear-off palette sheets.
      </p>
      <button type="button" class="btn no-print" onclick="window.print()">
        Print the palette cards
      </button>
    </div>

    <div class="combos">
      {v.combos.map((c) => (
        <article class="combo-card">
          <OutfitFigure items={c.items} />
          <div class="combo-body">
            <h3>{c.name}</h3>
            <p class="combo-scene">{c.scene}</p>
            <ul class="combo-swatches">
              {c.items.map((it) => (
                <li>
                  <span class="combo-swatch" style={`background:${it.hex}`} aria-hidden="true"></span>
                  <span class="combo-meta">
                    <span class="combo-role">{roleLabel[it.role] ?? it.role}</span>
                    <span class="combo-label">{it.label} · <em>{it.name}</em></span>
                    <button
                      type="button"
                      class="btn btn-copy combo-hex"
                      data-copy={it.hex}
                      aria-label={`Copy ${it.label} hex code`}
                    >
                      {it.hex}
                    </button>
                  </span>
                </li>
              ))}
            </ul>
            <p class="combo-note">{c.note}</p>
            <p class="combo-read">{c.read}</p>
            <div class="combo-ladder" aria-hidden="true">
              {c.ladder.map((h) => <span style={`background:${h}`}></span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="decor-section" style="margin-top: var(--sp-6);">
    <h2>The same color, in your rooms</h2>
    <p class="no-print">
      Four decor palettes built on the same anchor color, for the paint-store version of the
      question. Ladders show the Oklab blend between the first three colors.
    </p>
    <div class="decor-grid">
      {v.decor.map((d) => (
        <article class="decor-card">
          <h3>{d.name}</h3>
          <div class="decor-swatches">
            {d.colors.map((col) => (
              <span class="decor-swatch" style={`background:${col.hex}`} title={col.label}>
                <span class="decor-hex">{col.hex}</span>
              </span>
            ))}
          </div>
          <ul class="decor-labels">
            {d.colors.map((col) => <li>{col.label}</li>)}
          </ul>
          <div class="combo-ladder" aria-hidden="true">
            {d.ladder.map((h) => <span style={`background:${h}`}></span>)}
          </div>
          <p class="decor-note">{d.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2>What doesn’t go with it</h2>
    <div class="avoid-grid">
      {v.avoid.map((a) => (
        <article class="avoid-card">
          <div class="avoid-head">
            <span class="avoid-swatch" style={`background:${a.hex}`} aria-hidden="true"></span>
            <div>
              <h3>{a.name}</h3>
              <code>{a.hex}</code>
            </div>
          </div>
          <p>{a.why}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="prose no-print" style="margin-top: var(--sp-6);">
    <h2>Practical tips</h2>
    <ul class="tips">
      {def.tips.map((t) => (
        <li>
          <strong>{t.title}.</strong> {t.body}
        </li>
      ))}
    </ul>
  </section>

  <section class="prose no-print" style="margin-top: var(--sp-6);">
    <h2>Frequently asked questions</h2>
    <div class="faq">
      {def.faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="prose no-print" style="margin-top: var(--sp-6);">
    <h2>Keep reading</h2>
    <ul class="keep-reading">
      {def.related.map((r) => (
        <li><a href={r.href}>{r.label}</a></li>
      ))}
      <li><a href="/color-guides">All color guides</a></li>
      <li><a href="/mix">All color mixes</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }

  .crumbs a {
    color: var(--muted);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .hero-answer {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-3);
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent) 4%, transparent);
  }

  .hero-answer code {
    font-family: var(--mono);
    font-size: 0.95rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .hero-swatches {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-swatches > span {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    display: inline-block;
  }

  .hero-plus {
    width: auto !important;
    height: auto !important;
    border: 0 !important;
    background: none !important;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hero-result {
    box-shadow: 0 0 0 2px var(--accent-soft);
  }

  /* --- combo cards --- */
  .combos-head {
    max-width: 46rem;
  }

  .combos-head .btn {
    margin-top: var(--sp-2);
  }

  .combos {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
  }

  .combo-card {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .combo-card h3 {
    margin-bottom: var(--sp-1);
    font-size: 1.08rem;
  }

  .combo-body {
    flex: 1;
    min-width: 0;
  }

  .combo-scene {
    margin: 0 0 var(--sp-2);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .combo-swatches {
    list-style: none;
    display: grid;
    gap: var(--sp-2);
    padding: 0;
    margin: 0 0 var(--sp-2);
  }

  .combo-swatches li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .combo-swatch {
    width: 1.7rem;
    height: 1.7rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--border);
  }

  .combo-meta {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .combo-role {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 5.2rem;
  }

  .combo-label {
    font-size: 0.9rem;
  }

  .combo-label em {
    color: var(--muted);
    font-style: normal;
  }

  .combo-hex {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 0.1rem 0.4rem;
  }

  .combo-note {
    margin: 0 0 var(--sp-2);
    font-size: 0.95rem;
  }

  .combo-read {
    margin: 0 0 var(--sp-2);
    padding: 0.45rem 0.7rem;
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--accent) 5%, transparent);
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .combo-ladder {
    display: flex;
    height: 0.9rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    max-width: 22rem;
  }

  .combo-ladder span {
    flex: 1;
  }

  /* --- decor --- */
  .decor-grid {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
  }

  @media (min-width: 48rem) {
    .decor-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .decor-card {
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .decor-card h3 {
    font-size: 1.05rem;
    margin-bottom: var(--sp-2);
  }

  .decor-swatches {
    display: flex;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .decor-swatch {
    flex: 1;
    min-height: 3.2rem;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0.2rem;
  }

  .decor-hex {
    font-family: var(--mono);
    font-size: 0.62rem;
    padding: 0.05rem 0.25rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.72);
    color: #222;
  }

  .decor-labels {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    padding: 0;
    margin: var(--sp-2) 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .decor-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* --- avoid --- */
  .avoid-grid {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  @media (min-width: 48rem) {
    .avoid-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .avoid-card {
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .avoid-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: var(--sp-2);
  }

  .avoid-head h3 {
    margin: 0;
    font-size: 1rem;
  }

  .avoid-head code {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .avoid-swatch {
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid var(--border);
  }

  .avoid-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* --- tips / reading --- */
  .tips {
    display: grid;
    gap: var(--sp-2);
    padding-left: 1.1rem;
  }

  .keep-reading {
    display: grid;
    gap: var(--sp-1);
  }

  /* --- mobile: figure above the body --- */
  @media (max-width: 34rem) {
    .combo-card {
      flex-direction: column;
      align-items: center;
      text-align: left;
    }
  }

</style>

<style is:global>
  /* --- print: outfit pages become tear-off palette cards --- */
  @media print {
    .site-header,
    .site-footer,
    .mixer,
    .no-print {
      display: none !important;
    }
    body {
      background: #fff;
    }
    .combo-card,
    .decor-card,
    .avoid-card {
      break-inside: avoid;
      border: 1px dashed #888;
    }
    .decor-grid,
    .avoid-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
