---
/**
 * Language picker for the in-page UI switch (en/zh/ko, user call
 * 2026-10-29). <details> gives open/close with zero JS; scripts/i18n.ts
 * keeps aria-current in sync, applies the choice and closes the menu.
 * Visual pattern copied from perlerbeadpatterns.org's site-language menu
 * (user call: match the competitor): full word + rotating caret in the
 * pill, borderless list items edge-to-edge under a rounded sheet, the
 * active row highlighted by fill rather than color alone.
 */
import { LANGS } from '../data/uiStrings';
---

<details class="lang-switch">
  <summary aria-label="Language" data-i18n-aria="lang.label">
    <span class="lang-current">English</span>
    <span class="lang-caret" aria-hidden="true">▼</span>
  </summary>
  <ul class="lang-menu">
    {
      LANGS.map((l) => (
        <li>
          <button type="button" data-lang={l.code} aria-current={l.code === 'en' ? 'true' : 'false'}>
            {l.label}
          </button>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch {
    position: relative;
    font-size: 0.85rem;
  }

  .lang-switch summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .lang-switch summary::-webkit-details-marker {
    display: none;
  }

  .lang-switch summary:hover {
    background: var(--accent-soft);
  }

  .lang-caret {
    font-size: 10px;
    color: var(--muted);
    transition: transform 0.15s ease;
  }

  .lang-switch[open] .lang-caret {
    transform: rotate(180deg);
  }

  /* competitor shape: one rounded sheet, items edge-to-edge — the active
     row reads by fill, the rest dim to 70% and lift on hover */
  .lang-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 50;
    min-width: 9rem;
    padding: 0;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 8px 24px rgb(28 25 23 / 0.12);
    list-style: none;
    overflow: hidden;
  }

  .lang-menu button {
    display: block;
    width: 100%;
    padding: 0.55rem 1rem;
    border: 0;
    background: transparent;
    color: var(--text);
    opacity: 0.7;
    font: inherit;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.12s ease, opacity 0.12s ease;
  }

  .lang-menu button:hover {
    background: var(--accent-soft);
    opacity: 1;
  }

  .lang-menu button[aria-current='true'] {
    background: var(--accent-soft);
    opacity: 1;
    font-weight: 600;
  }
</style>
