---
/**
 * Free-paint canvas: the pattern silhouette as an all-white pegboard. Third
 * studio card — pick a bead color, then click or drag in any of the eight
 * directions to paint; the eraser turns beads back to white; a live
 * materials list counts what you placed (scripts/beadPaint.ts).
 * No-JS/print contract: the SSR figure is already a complete blank
 * template of the shape — printable as a "draw your own colors" sheet.
 */
import type { PatternView } from '../lib/beadContent';
import { BEAD_COLORS } from '../lib/beadPalette';

interface Props {
  view: PatternView;
}

const { view } = Astro.props;
const U = 10; // viewBox units per bead cell, matches BeadFigure
const G = 16; // coordinate gutter (viewBox units) above and left of the grid —
// wide enough for 12-unit bold labels (two digits) to stay legible at screen and print scale
const MAX_SCALE = 1.25; // rendered-width cap: 12-unit labels land at ≤15px screen px
// (the vision-verified comfortable size), and mini patterns stay mini instead
// of the blank canvas stretching to full column width
const { grid, def } = view;
const w = def.width * U;
const h = grid.length * U;

const colTicks: number[] = []; // every-5 column numbers along the top edge
for (let c = 5; c <= def.width; c += 5) colTicks.push(c);
const rowTicks: number[] = []; // every-5 row numbers along the left edge
for (let r = 5; r <= grid.length; r += 5) rowTicks.push(r);

const paintable: { x: number; y: number }[] = [];
const pegs: { x: number; y: number }[] = [];
grid.forEach((row, y) => {
  for (let x = 0; x < def.width; x++) {
    (row[x]! !== '.' ? paintable : pegs).push({ x: x * U, y: y * U });
  }
});
---

<div class="paint-card" data-bead-paint>
  <div class="paint-body">
    <figure class="fig-card">
      <figcaption>
        Blank canvas <span class="hint">your colors, bead by bead</span>
      </figcaption>
      <svg
        class="bead-fig"
        data-bead-canvas
        data-cols={def.width}
        data-rows={grid.length}
        viewBox={`0 0 ${w + G} ${h + G}`}
        style={`max-width:${Math.round((w + G) * MAX_SCALE)}px`}
        role="img"
        aria-label={`${def.name} blank bead canvas — paint it in your own colors`}
      >
        <g class="cv-coords" aria-hidden="true">
          {colTicks.map((c) => (
            <text class="cv-label" x={G + c * U - U / 2} y={G / 2}>
              {c}
            </text>
          ))}
          {rowTicks.map((r) => (
            <text class="cv-label" x={G / 2} y={G + r * U - U / 2}>
              {r}
            </text>
          ))}
        </g>
        {pegs.map((p) => (
          <circle class="cv-peg" cx={p.x + G + U / 2} cy={p.y + G + U / 2} r={1.1} />
        ))}
        {paintable.map((c) => (
          <rect
            class="cv-cell"
            data-cx={c.x / U}
            data-cy={c.y / U}
            x={c.x + G + 0.8}
            y={c.y + G + 0.8}
            width={U - 1.6}
            height={U - 1.6}
            rx={2.6}
            fill="#f5f4ef"
          />
        ))}
      </svg>
    </figure>

    <div class="paint-tools no-print">
      <h3>Draw your own version</h3>
      <p class="side-note">
        Every bead of the {def.name.toLowerCase()} is white and waiting. Pick a color,
        then click — or drag in any of the eight directions — and the brush carries it
        along your stroke. Turn on <strong>Mirror</strong> and every stroke lands on both
        halves of the board at once, so symmetric designs paint in half the time. The
        eraser wipes beads back to white, and the list below counts exactly what you've
        placed.
      </p>
      <div class="tool-row" role="group" aria-label="Paint tools">
        <button type="button" class="btn tool-btn active" data-cv-tool="brush" aria-pressed="true">
          Brush
        </button>
        <button type="button" class="btn tool-btn" data-cv-tool="eraser" aria-pressed="false">
          Eraser
        </button>
        <button
          type="button"
          class="btn tool-btn"
          data-cv-mirror
          aria-pressed="false"
          title="Every stroke lands on the mirrored cell too"
        >
          Mirror
        </button>
        <button type="button" class="btn tool-btn" data-cv-clear>Clear all</button>
      </div>
      <div class="cv-palette" role="group" aria-label="Bead colors">
        {BEAD_COLORS.map((b) => (
          <button
            type="button"
            class:list={['cv-swatch', { active: b.id === 'black' }]}
            data-cv-color={b.id}
            style={`background:${b.hex}`}
            title={b.name}
            aria-label={`Paint with ${b.name}`}
            aria-pressed={b.id === 'black' ? 'true' : 'false'}
          ></button>
        ))}
      </div>
      <label class="cv-custom">
        custom color
        <input type="color" data-cv-custom aria-label="Custom paint color, snapped to the nearest bead" />
        <span class="cv-custom-hint">snapped to the nearest bead</span>
      </label>
      <ul class="bead-list cv-list" data-cv-list>
        <li class="cv-empty">Nothing painted yet — your bead list builds as you draw.</li>
      </ul>
    </div>
  </div>
</div>

<style>
  .paint-card {
    /* spans the studio's side column too: the canvas needs the full row width
       to keep coordinate labels readable while the palette sits beside it */
    grid-column: 1 / -1;
    position: relative; /* anchors the island's floating cursor badge */
  }
  /* Same figure dressing as the reference/blank cards — the page's .fig-card
  rules are scoped to its own template and never reach this component's tree. */
  .fig-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: var(--sp-3);
    background: var(--bg, #fff);
  }
  .fig-card figcaption {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft, #666);
    margin-bottom: var(--sp-2);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .fig-card .hint { font-weight: 400; font-style: italic; }
  .fig-card .bead-fig {
    display: block;
    width: 100%; /* without this the svg falls back to intrinsic ~416px, shrinking every label */
    margin-inline: auto; /* centers the board when the max-width cap binds (minis) */
    height: auto;
    background: var(--paper, #fbfaf7);
    border-radius: 10px;
  }
  .paint-body {
    display: grid; /* single stacked column on narrow screens */
    gap: var(--sp-4);
    align-items: start;
  }
  /* Canvas left, tools right — with the tools below, the palette sat a full
     screen-height under the board (user: can't see colors and canvas together). */
  @media (min-width: 901px) {
    .paint-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: var(--sp-4);
      align-items: start;
    }
    .paint-tools {
      position: sticky;
      top: 12px; /* palette stays on screen while painting a tall board */
    }
  }
  .paint-tools h3 {
    font-size: 1.15rem;
    margin-bottom: var(--sp-2);
  }
  .tool-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 var(--sp-3);
  }
  .tool-btn.active {
    border-color: var(--accent, #b3552e);
    box-shadow: inset 0 0 0 1px var(--accent, #b3552e);
  }
  .cv-palette {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    margin: 0 0 var(--sp-2);
  }
  .cv-swatch {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.18);
    cursor: pointer;
    padding: 0;
  }
  .cv-swatch.active {
    outline: 2px solid var(--accent, #b3552e);
    outline-offset: 1px;
  }
  .cv-custom {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--ink-soft, #666);
    margin-bottom: var(--sp-2);
  }
  .cv-custom input {
    width: 34px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: none;
    cursor: pointer;
  }
  .cv-custom-hint { font-style: italic; }
  @media print {
    .paint-card { break-inside: avoid; }
  }
</style>

<style is:global>
  /* Runtime pieces created by scripts/beadPaint.ts live outside the scoped tree. */
  .bead-fig[data-bead-canvas] {
    touch-action: none;
    user-select: none;
  }
  .bead-fig[data-bead-canvas] .cv-peg {
    fill: rgba(0, 0, 0, 0.12);
    pointer-events: none;
  }
  .bead-fig[data-bead-canvas] .cv-label {
    fill: rgba(0, 0, 0, 0.8);
    font-size: 12px;
    font-weight: 700;
    font-family: ui-monospace, monospace;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }
  /* island-created floating readout: current cell under the pointer */
  .cv-cursor {
    position: absolute;
    z-index: 6;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(35, 35, 38, 0.92);
    color: #fff;
    font: 600 12px/1.3 ui-monospace, monospace;
    letter-spacing: 0.02em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.08s ease;
    white-space: nowrap;
  }
  .cv-cursor.on {
    opacity: 1;
  }
  .bead-fig[data-bead-canvas] .cv-cell {
    stroke: rgba(0, 0, 0, 0.16);
    stroke-width: 0.5;
    cursor: crosshair;
  }
  .bead-fig[data-bead-canvas] .cv-cell.colored {
    stroke: rgba(0, 0, 0, 0.12);
  }
  .cv-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cv-list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg, #fff);
    font-size: 0.9rem;
  }
  .cv-empty {
    border-style: dashed;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
  }
  .cv-total {
    border: none;
    padding: 0;
    background: none;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
  }
  .cv-item-swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    flex: none;
  }
</style>
