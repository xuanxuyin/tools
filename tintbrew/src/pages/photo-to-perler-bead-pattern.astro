---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const title = 'Photo to Perler Bead Pattern — Free Picture-to-Bead Converter | TintBrew';
const description =
  'Turn any photo into a printable fuse bead pattern. Up to 8, 12 or 16 colors, background removal and a dark outline, pegboard counts and a bead list with real P-codes. Nothing uploads.';

const faqs = [
  {
    q: 'How does my photo become a bead pattern?',
    a: 'The picture is scanned and divided into color regions, then each region is matched to a real bead color. Matching runs in Oklab, a color space built around how different two colors look to the human eye, so skin stays skin-toned and reds stay red instead of drifting muddy.',
  },
  {
    q: 'What kind of photo works best?',
    a: 'A bold subject on a light or transparent background is where the converter shines — clear shapes, only a few colors to juggle. Shaded, 3D-looking art carries subtle color, so push the bead width up and raise the color count to do it justice. Prefer the whole scene? Turn off Remove background and widen the board.',
  },
  {
    q: 'What does Color simplification do?',
    a: 'It merges near-identical shades into one bead so the pattern has fewer, cleaner colors. Keep shades preserves the subtle steps, Bold collapses whole color families, and Balanced sits between the two. Every level keeps the colors you actually place on the board.',
  },
  {
    q: 'What do the P-codes in the bead list mean?',
    a: 'Each of the 103 colors carries a P-code — the catalog number for this site’s bead line, shown next to the color name and its hex. Chips, canvas swatches and the bead list all use the same code, so P49 always means the same bead from the list to the pegboard.',
  },
  {
    q: 'Why does the preview show lines through the pattern?',
    a: 'Those seams mark pegboard edges — one large square pegboard holds 29 × 29 beads. A 58-wide pattern spans two boards across, and the seam lines show exactly where one board ends and the next snaps on, so you can split the work (and the boards) before you start placing.',
  },
  {
    q: 'Can I fix a bead the converter got wrong?',
    a: 'Yes — hit Edit in editor under the preview. The whole board carries over to the bead editor, where you can repaint any bead, erase, mirror strokes, simplify colors and export a PNG. Your work autosaves in the browser.',
  },
  {
    q: 'Does my photo get uploaded anywhere?',
    a: 'No. The whole conversion runs in your browser — the picture never leaves your device, and the pattern disappears when you close the tab. Print it or download the PNG if you want to keep it.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TintBrew Photo to Bead Pattern',
    url: `${SITE.url}/photo-to-perler-bead-pattern/`,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Perler Bead Patterns',
        item: `${SITE.url}/perler-bead-patterns/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Photo to Bead Pattern',
        item: `${SITE.url}/photo-to-perler-bead-pattern/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/photo-to-perler-bead-pattern" jsonLd={jsonLd}>
  <section class="hero">
    <h1>Photo to Perler Bead Pattern</h1>
    <p class="lead">
      Upload an image and it converts into a bead board automatically — matched to real fuse-bead
      colors, counted by color, and ready to print or finish in the editor. Adjust any setting and
      the pattern regenerates on the spot. Nothing uploads; the photo never leaves your device.
    </p>
  </section>

  <section class="tool-shell" data-photo-bead>
    <div class="pm-grid">
      <div class="pm-left no-print">
        <div
          class="upload-row"
          data-photo-drop
          role="button"
          tabindex="0"
          aria-label="Choose a photo, or drop one here"
        >
          <span class="choose-btn">Choose image</span>
          <span class="file-name" data-photo-filename>No image selected yet.</span>
        </div>
        <input type="file" accept="image/*" data-photo-file hidden />

        <div class="source-slot" data-photo-source hidden></div>

        <div class="settings">
          <div class="setting">
            <p class="setting-title">Maximum color count</p>
            <div class="opt-pills" role="group" aria-label="Maximum color count" data-photo-colors>
              <button type="button" data-value="8" aria-checked="false">Up to 8</button>
              <button type="button" data-value="12" class="active" aria-checked="true">Up to 12</button>
              <button type="button" data-value="16" aria-checked="false">Up to 16</button>
            </div>
            <p class="setting-help">Up to this many bead colors — the bead list caps with it.</p>
          </div>

          <div class="setting">
            <p class="setting-title">Color simplification</p>
            <div class="opt-pills" role="group" aria-label="Color simplification" data-photo-simplify>
              <button type="button" data-value="keep" aria-checked="false">Keep shades</button>
              <button type="button" data-value="balanced" class="active" aria-checked="true">Balanced</button>
              <button type="button" data-value="bold" aria-checked="false">Bold</button>
            </div>
            <p class="setting-help">
              Merges near-identical shades into one bead so the pattern has fewer, cleaner colors.
            </p>
          </div>

          <div class="setting">
            <p class="setting-title">Bead width</p>
            <div class="width-duo">
              <div class="width-box">
                <p class="width-box-title">Presets</p>
                <div class="opt-pills" role="group" aria-label="Bead width presets" data-photo-size>
                  <button type="button" data-value="auto" class="active" aria-checked="true">Auto</button>
                  <button type="button" data-value="29" aria-checked="false">29 · Compact</button>
                  <button type="button" data-value="58" aria-checked="false">58 · Balanced</button>
                  <button type="button" data-value="87" aria-checked="false">87 · Detailed</button>
                  <button type="button" data-value="116" aria-checked="false">116 · Extra detailed</button>
                </div>
              </div>
              <div class="width-box">
                <div class="opt-pills" role="group" aria-label="Custom bead width">
                  <button
                    type="button"
                    data-value="custom"
                    data-photo-custom-toggle
                    aria-checked="false"
                  >
                    Custom
                  </button>
                </div>
                <div class="custom-row hidden" data-photo-custom-row>
                  <input
                    type="number"
                    inputmode="numeric"
                    min="10"
                    max="200"
                    value="58"
                    aria-label="Custom bead width"
                    data-photo-custom-width
                  />
                  <span class="custom-unit">beads wide</span>
                </div>
                <p class="setting-help">Enter 10 to 200 beads.</p>
              </div>
            </div>
            <p class="width-error hidden" data-photo-width-error role="alert">
              Enter a width from 10 to 200 beads.
            </p>
          </div>

          <label class="check-card">
            <input type="checkbox" checked data-photo-bg />
            <span class="check-body">
              <strong>Remove background</strong>
              <span>
                Clears the solid color connected to the edges and leaves it off the bead count. Turn
                it off to keep the whole scene.
              </span>
            </span>
          </label>

          <label class="check-card">
            <input type="checkbox" checked data-photo-outline />
            <span class="check-body">
              <strong>Dark outline</strong>
              <span>
                Traces the cut-out subject's edge with the darkest bead in the palette, so the shape
                stays crisp even where sampling lightened the rim.
              </span>
            </span>
          </label>

          <p class="auto-note">Changes apply automatically as you adjust the settings.</p>
        </div>

        <p class="photo-status" data-photo-status aria-live="polite">
          Pick a photo to start — it converts right on this page, nothing uploads.
        </p>
      </div>
      <div class="photo-stage" data-photo-stage>
        <div class="stage-empty">
          Your pattern preview will appear here — upload an image and the pattern generates
          automatically.
        </div>
      </div>
    </div>
  </section>

  <section class="prose" style="margin-top: var(--sp-8);">
    <h2>How it works</h2>
    <p>From image to bead pattern in four steps:</p>
    <ol>
      <li>
        <strong>Upload your image.</strong> Drop in a photo, logo, drawing or piece of pixel art.
        Clean shapes and strong contrast convert best, but you can refine anything after the fact.
      </li>
      <li>
        <strong>Convert to a bead grid.</strong> The converter maps your image onto a pegboard
        grid, snaps every cell to the closest real bead color, and shows a live preview you can
        steer with the settings above.
      </li>
      <li>
        <strong>Refine the result.</strong> No converter nails every image — hit Edit in editor
        and fix stray beads by hand: repaint, erase, mirror strokes, simplify colors.
      </li>
      <li>
        <strong>Print or make it.</strong> The printed sheet carries the board with its pegboard
        seams plus the bead list with P-codes — or download a PNG for your phone or tablet.
      </li>
    </ol>

    <h2>Different images, different settings</h2>
    <p>
      The converter does the heavy lifting, but a couple of settings decide how close the first
      pass lands:
    </p>
    <ul>
      <li>
        <strong>A clean, simple subject just works.</strong> One bold shape on a light background,
        12 colors, Auto width — convert once and place beads.
      </li>
      <li>
        <strong>Shaded, 3D-looking art needs more beads.</strong> Soft shading carries a lot of
        subtle color; push the bead width up (87 or 116) and raise the color count to 16.
      </li>
      <li>
        <strong>Want the whole scene? Keep it.</strong> Turn off Remove background so the
        surroundings stay in, and widen the board — a full scene needs more beads than a cut-out.
      </li>
      <li>
        <strong>Logos, text and icons.</strong> Keep shades + a dark outline keeps letterforms
        readable at 29 wide; pixel art converts near-lossless at its native grid size with Custom
        width.
      </li>
    </ul>

    <h2>What your pattern includes</h2>
    <ul>
      <li>A printable pattern sheet with pegboard seams every 29 beads</li>
      <li>Bead counts per color, each with its P-code, name and hex</li>
      <li>Pegboard count — how many 29 × 29 boards the design spans</li>
      <li>A PNG export and a one-click jump into the bead editor</li>
    </ul>

    <h2>A note on what you convert</h2>
    <p>
      Convert photos you own or have the right to use. Bead versions of other people's artwork or
      characters are for your own shelf, not for sale.
    </p>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <p class="keep-reading">
      Rather start from a ready-made design? Browse the
      <a href="/perler-bead-patterns/">full perler bead pattern set</a> — 116 animal, character, food
      and Halloween boards at every size, each with the same printable template and bead list.
    </p>
  </section>
</BaseLayout>

<script>
  import '../scripts/photoBead';
</script>

<style>
  .tool-shell {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: var(--sp-4);
    background: var(--bg, #fff);
  }
  /* source-site layout: photo + settings left, result right — originals and
     the converted board sit side by side for direct comparison (user call,
     2026-10-29); narrow screens stack the same order */
  .pm-grid {
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 981px) {
    .pm-grid {
      grid-template-columns: minmax(340px, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }
  /* compact upload row — a dashed card the size of a setting, not a hero
     banner (user call: the drop zone was eating the page) */
  .upload-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1.5px dashed var(--border);
    border-radius: 12px;
    background: var(--paper, #fbfaf7);
    cursor: pointer;
    transition: border-color 0.12s ease;
  }
  .upload-row:hover,
  .upload-row:focus-visible,
  .upload-row.over {
    border-color: var(--accent, #b3552e);
  }
  .choose-btn {
    flex: none;
    padding: 8px 14px;
    border-radius: 999px;
    background: #1c1c1c;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .file-name {
    min-width: 0;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .settings {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .setting-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .setting-help {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: var(--ink-soft, #666);
  }
  .opt-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .opt-pills button {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg, #fff);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .opt-pills button:hover {
    border-color: var(--accent, #b3552e);
  }
  .opt-pills button.active {
    border-color: var(--accent, #b3552e);
    background: #fffaf0;
    box-shadow: inset 0 0 0 1px var(--accent, #b3552e);
    font-weight: 600;
  }
  /* bead width lives in two separate cards — Presets and Custom are peer
     options, not one merged pill row (user call, 2026-10-29) */
  .width-duo {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .width-box {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--paper, #fbfaf7);
  }
  .width-box .opt-pills {
    margin-top: 0;
  }
  .width-box-title {
    margin: 0 0 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft, #666);
  }
  .custom-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
  }
  .custom-row input {
    width: 90px;
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font: inherit;
  }
  .width-error {
    margin: 6px 0 0;
    font-size: 0.82rem;
    color: #b45309;
  }
  .check-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--paper, #fbfaf7);
    cursor: pointer;
  }
  .check-card input {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    accent-color: var(--accent, #b3552e);
  }
  .check-card .check-body {
    display: grid;
    gap: 2px;
    font-size: 0.85rem;
  }
  .check-card .check-body span {
    color: var(--ink-soft, #666);
  }
  .auto-note {
    margin: 0;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--ink-soft, #666);
  }
  .photo-status {
    margin: var(--sp-3) 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft, #666);
    min-height: 1.4em;
  }
  .photo-stage {
    margin-top: 0;
  }
  @media (max-width: 980px) {
    .photo-stage {
      margin-top: var(--sp-2);
    }
  }
  .stage-empty {
    padding: var(--sp-8) var(--sp-4);
    border: 1px dashed var(--border);
    border-radius: 12px;
    text-align: center;
    color: var(--ink-soft, #666);
    font-style: italic;
  }
  .hidden {
    display: none !important;
  }
</style>

<style is:global>
  /* Runtime result built by scripts/photoBead.ts lives outside the scoped
     tree — these rules mirror the source-site result layout: cream panels,
     a paper preview board with peg holes and pegboard seams, and per-color
     rows with the P-codes shoppers order by. */
  .photo-stage .paint-card {
    display: grid;
    gap: var(--sp-4);
  }
  .photo-stage .fig-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: var(--sp-3);
    background: var(--bg, #fff);
  }
  .photo-stage .fig-card figcaption {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft, #666);
    margin-bottom: var(--sp-2);
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .photo-stage .fig-card .hint {
    font-weight: 400;
    font-style: italic;
  }
  .photo-stage .photo-preview {
    display: block;
    width: 100%;
    margin-inline: auto;
    height: auto;
    background: #f4efe8;
    border-radius: 10px;
  }
  .photo-stage .pv-cell {
    stroke: rgba(0, 0, 0, 0.08);
    stroke-width: 0.6;
  }
  .photo-stage .pv-peg {
    fill: #ffffff;
    stroke: rgba(0, 0, 0, 0.1);
    stroke-width: 0.5;
  }
  .photo-stage .pv-seam {
    stroke: rgba(0, 0, 0, 0.32);
    stroke-width: 0.8;
  }
  .photo-stage .pv-border {
    fill: none;
    stroke: rgba(0, 0, 0, 0.18);
    stroke-width: 1;
  }
  .photo-stage .photo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .photo-stage .act-primary {
    border-color: var(--accent, #b3552e);
    box-shadow: inset 0 0 0 1px var(--accent, #b3552e);
    font-weight: 600;
  }
  .photo-stage .panel-grid {
    display: grid;
    gap: var(--sp-3);
  }
  @media (min-width: 701px) {
    .photo-stage .panel-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .photo-stage .panel-card {
    padding: 12px 16px;
    border-radius: 16px;
    background: #fffaf0;
    font-size: 0.9rem;
  }
  .photo-stage .panel-label {
    margin: 0 0 8px;
    color: rgba(0, 0, 0, 0.45);
    font-weight: 600;
  }
  .photo-stage .panel-lines p {
    margin: 2px 0;
  }
  .photo-stage .panel-lines .strong {
    font-weight: 700;
  }
  .photo-stage .panel-lines .warn {
    color: #b45309;
  }
  .photo-stage .beads-card {
    padding: 16px;
  }
  .photo-stage .panel-title {
    margin: 0 0 10px;
    font-weight: 600;
  }
  .photo-stage .bead-rows {
    display: grid;
    gap: 8px;
  }
  .photo-stage .bead-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 16px;
    background: #fff;
    font-size: 0.9rem;
  }
  .photo-stage .row-swatch {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
    flex: none;
  }
  .photo-stage .row-label {
    min-width: 0;
    flex: 1;
  }
  .photo-stage .row-label strong {
    margin-right: 4px;
  }
  .photo-stage .row-count {
    font-weight: 600;
  }
  /* source photo lives in the LEFT column next to the settings — runtime
     DOM carries no scoping attribute, so its rules sit here like the
     board's (user call: compare original and board side by side) */
  .pm-left .source-slot {
    margin-top: var(--sp-3);
  }
  .pm-left .source-slot .source-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft, #666);
    margin: 0 0 var(--sp-1);
  }
  .pm-left .source-slot .source-img {
    display: block;
    max-width: 100%;
    max-height: 240px;
    width: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
    object-fit: contain;
    background: var(--paper, #fbfaf7);
  }

  /* Print must live in a GLOBAL block: the runtime-built board carries no
     astro scoping attribute, so scoped rules (compiled with
     [data-astro-cid-…]) never match it — the board would print its tools
     panel and lose print-color-adjust. Same pattern as BeadPatternPage. */
  @media print {
    .site-header,
    .site-footer,
    .no-print,
    .stage-empty,
    .keep-reading,
    .hero,
    .prose {
      display: none !important;
    }
    .tool-shell {
      border: none;
      padding: 0;
    }
    .pm-grid {
      display: block;
    }
    .photo-stage .paint-card,
    .photo-stage .panel-card {
      break-inside: avoid;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
