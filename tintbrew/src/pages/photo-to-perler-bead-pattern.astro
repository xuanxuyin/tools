---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoFigure from '../components/DemoFigure.astro';
import { SITE } from '../consts';

const title = 'Photo to Perler Bead Pattern — Free Picture-to-Bead Converter | TintBrew';
const description =
  'Turn any photo into a printable fuse bead pattern. Up to 8, 16, 24 or all 291 colors, background removal and a dark outline, pegboard counts and a bead list with real Mardiy codes. Nothing uploads.';

const faqs = [
  {
    q: 'How does my photo become a bead pattern?',
    a: 'The picture is scanned and divided into color regions, then each region is matched to a real bead color. Matching runs in Oklab, a color space built around how different two colors look to the human eye, so skin stays skin-toned and reds stay red instead of drifting muddy.',
  },
  {
    q: 'What kind of photo works best?',
    a: 'A bold subject on a light or transparent background is where the converter shines — clear shapes, only a few colors to juggle. Shaded, 3D-looking art carries subtle color, so push the bead width up and raise the color count to do it justice. Prefer the whole scene? Leave Remove background off and widen the board.',
  },
  {
    q: 'What does Color simplification do?',
    a: 'It merges near-identical shades into one bead so the pattern has fewer, cleaner colors. Keep shades preserves the subtle steps, Bold collapses whole color families, and Balanced sits between the two. Every level keeps the colors you actually place on the board.',
  },
  {
    q: 'What do the codes in the bead list mean?',
    a: 'Every one of the 291 colors carries a Mardiy catalog code — A1 through ZG8, the number you order beads by, shown next to the color’s hex. Swatches and the bead list use the same code, so A1 always means the same bead from the list to the pegboard.',
  },
  {
    q: 'Why does the preview show lines through the pattern?',
    a: 'Those seams mark pegboard edges — one large square pegboard holds 29 × 29 beads. A 58-wide pattern spans two boards across, and the seam lines show exactly where one board ends and the next snaps on, so you can split the work (and the boards) before you start placing.',
  },
  {
    q: 'Can I fix a bead the converter got wrong?',
    a: 'Yes — hit Edit in editor under the preview. The whole board carries over to the bead editor, where you can repaint any bead, erase, mirror strokes, simplify colors and export a PNG. Your work autosaves in the browser.',
  },
  {
    q: 'Does my photo get uploaded anywhere?',
    a: 'No. The whole conversion runs in your browser — the picture never leaves your device, and the pattern disappears when you close the tab. Print it or download the PNG if you want to keep it.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TintBrew Photo to Bead Pattern',
    url: `${SITE.url}/photo-to-perler-bead-pattern/`,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Perler Bead Patterns',
        item: `${SITE.url}/perler-bead-patterns/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Photo to Bead Pattern',
        item: `${SITE.url}/photo-to-perler-bead-pattern/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/photo-to-perler-bead-pattern" jsonLd={jsonLd}>
  <section class="hero">
    <h1>Photo to Perler Bead Pattern</h1>
    <p class="lead">
      Upload an image and it converts into a bead board automatically — matched to real fuse-bead
      colors, counted by color, and ready to print or finish in the editor. Adjust any setting and
      the pattern regenerates on the spot. Nothing uploads; the photo never leaves your device.
    </p>
  </section>

  <section class="tool-shell" data-photo-bead>
    <div class="pm-grid">
      <div class="pm-left no-print">
        <div
          class="upload-row"
          data-photo-drop
          role="button"
          tabindex="0"
          aria-label="Choose a photo, or drop one here"
        >
          <span class="choose-btn">Choose image</span>
          <span class="file-name" data-photo-filename>No image selected yet.</span>
        </div>
        <input type="file" accept="image/*" data-photo-file hidden />

        <div class="source-slot" data-photo-source>
          <div class="source-empty">Your photo preview will appear here.</div>
        </div>
        <p class="auto-note">Changes apply automatically as you adjust the settings.</p>

        <p class="photo-status" data-photo-status aria-live="polite">
          Pick a photo to start — it converts right on this page, nothing uploads.
        </p>

        <div class="settings">
          <div class="setting">
            <p class="setting-title">Maximum color count</p>
            <div class="opt-pills" role="group" aria-label="Maximum color count" data-photo-colors>
              <button type="button" data-value="8" aria-checked="false">Up to 8</button>
              <button type="button" data-value="12" class="active" aria-checked="true">Up to 12</button>
              <button type="button" data-value="16" aria-checked="false">Up to 16</button>
              <button type="button" data-value="24" aria-checked="false">Up to 24</button>
              <button type="button" data-value="all" aria-checked="false">All 291</button>
            </div>
            <p class="setting-help">Up to this many bead colors — the bead list caps with it.</p>
          </div>

          <div class="setting">
            <p class="setting-title">Color simplification</p>
            <div class="opt-pills" role="group" aria-label="Color simplification" data-photo-simplify>
              <button type="button" data-value="keep" aria-checked="false">Keep shades</button>
              <button type="button" data-value="balanced" class="active" aria-checked="true">Balanced</button>
              <button type="button" data-value="bold" aria-checked="false">Bold</button>
            </div>
            <p class="setting-help">
              Merges near-identical shades into one bead so the pattern has fewer, cleaner colors.
            </p>
          </div>

          <div class="setting">
            <p class="setting-title">Bead width</p>
            <div class="width-duo">
              <div class="width-box">
                <p class="width-box-title">Presets</p>
                <div class="opt-pills" role="group" aria-label="Bead width presets" data-photo-size>
                  <button type="button" data-value="auto" class="active" aria-checked="true">Auto</button>
                  <button type="button" data-value="29" aria-checked="false">29 · Compact</button>
                  <button type="button" data-value="58" aria-checked="false">58 · Balanced</button>
                  <button type="button" data-value="87" aria-checked="false">87 · Detailed</button>
                  <button type="button" data-value="116" aria-checked="false">116 · Extra detailed</button>
                </div>
              </div>
              <div class="width-box">
                <div class="opt-pills" role="group" aria-label="Custom bead width">
                  <button
                    type="button"
                    data-value="custom"
                    data-photo-custom-toggle
                    aria-checked="false"
                  >
                    Custom
                  </button>
                </div>
                <div class="custom-row hidden" data-photo-custom-row>
                  <input
                    type="number"
                    inputmode="numeric"
                    min="10"
                    max="200"
                    value="58"
                    aria-label="Custom bead width"
                    data-photo-custom-width
                  />
                  <span class="custom-unit">beads wide</span>
                </div>
                <p class="setting-help">Enter 10 to 200 beads.</p>
              </div>
            </div>
            <p class="width-error hidden" data-photo-width-error role="alert">
              Enter a width from 10 to 200 beads.
            </p>
          </div>

          <label class="check-card">
            <input type="checkbox" data-photo-bg />
            <span class="check-body">
              <strong>Remove background</strong>
              <span>
                Clears the solid color connected to the edges and leaves it off the bead count. Turn
                it on to cut the subject out of its background.
              </span>
            </span>
          </label>

          <label class="check-card">
            <input type="checkbox" data-photo-outline />
            <span class="check-body">
              <strong>Dark outline</strong>
              <span>
                Traces the cut-out subject's edge with the darkest bead in the palette, so the shape
                stays crisp even where sampling lightened the rim.
              </span>
            </span>
          </label>
        </div>
      </div>
      <div class="photo-stage" data-photo-stage>
        <div class="stage-empty">
          Your pattern preview will appear here — upload an image and the pattern generates
          automatically.
        </div>
      </div>
    </div>
  </section>

  <div class="guide-stack">
    <section class="guide-card" aria-label="For the best results">
      <h2>For the best results</h2>
      <p class="guide-sub">Different images, different settings</p>
      <p>
        The converter does the heavy lifting, but a couple of settings decide how close the first
        pass lands. Here is what to reach for depending on what you are turning into beads.
      </p>
      <div class="guide-items">
        <div class="guide-item">
          <DemoFigure name="sweet-spot" />
          <h3>The sweet spot — a clean, simple subject just works</h3>
          <p>
            A bold subject on a light or transparent background is where the converter shines.
            Clear shapes, only a few colors to juggle — every bead lands on what matters, and it
            looks great straight out of the box on the default settings. If you can start here,
            start here.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="detailed-3d" />
          <h3>Detailed &amp; 3D art needs more beads</h3>
          <p>
            Renders with soft shading, gradients, or a 3D feel carry a lot of subtle color. To do
            them justice, push the bead width up and raise the color count so the shading has
            enough beads and shades to land on. A little tuning here is the difference between a
            muddy blob and something that genuinely reads.
          </p>
          <div class="demo-chips">
            <span>Colors → 16 or 24</span>
            <span>Bead width → higher</span>
          </div>
        </div>
        <div class="guide-item">
          <DemoFigure name="keep-bg" />
          <h3>Want the whole scene? You can keep it</h3>
          <p>
            Prefer the backdrop and all? Leave Remove background off so the surroundings stay in,
            and push the bead width up — a full scene needs more beads to hold both the subject
            and its background without turning to mush. Set Color simplification to Keep shades
            so the sky, sea and sand keep their soft gradients, and leave Dark outline off so the
            figure isn't forced into a hard silhouette against the scene.
          </p>
          <div class="demo-chips">
            <span>Remove background → off</span>
            <span>Width → higher (Custom)</span>
            <span>Simplification → Keep shades</span>
            <span>Dark outline → off</span>
          </div>
        </div>
      </div>
    </section>

    <section class="guide-card" aria-label="How it works">
      <h2>How it works</h2>
      <p class="guide-sub">From image to bead pattern in four steps</p>
      <div class="guide-items">
        <div class="guide-item">
          <DemoFigure name="step-upload" />
          <h3>1 · Upload your image</h3>
          <p>
            Drop in a photo, logo, drawing or piece of pixel art. Clean shapes and strong contrast
            convert best, but you can refine anything after the first pass.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="step-convert" />
          <h3>2 · Convert to a bead grid</h3>
          <p>
            The converter maps your image onto a pegboard grid, snaps every cell to the closest
            real bead color, and shows a live preview you can steer with the settings above.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="step-refine" />
          <h3>3 · Refine the result</h3>
          <p>
            No converter nails every image — hit Edit in editor and fix stray beads by hand:
            repaint, erase, mirror strokes, simplify colors.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="step-print" />
          <h3>4 · Print or make it</h3>
          <p>
            The printed sheet carries the board with its pegboard seams plus the bead list with
            Mardiy codes — or download a PNG for your phone or tablet.
          </p>
        </div>
      </div>
    </section>

    <section class="guide-card" aria-label="What you can control">
      <h2>What you can control</h2>
      <p class="guide-sub">A converter you can actually steer</p>
      <p>
        Most image-to-bead tools give you a single automatic output. This one keeps you in
        control of size, colors, and every individual bead, so the result matches the beads you
        own and the look you want.
      </p>
      <div class="guide-items">
        <div class="guide-item">
          <DemoFigure name="ctl-colors" />
          <h3>Colors: 8 to all 291</h3>
          <p>
            Fewer colors read cleaner and are easier to source — 8 or 12 covers most bold
            subjects. Raise it to 16 or 24 when the subject needs extra shades, or open it to all
            291 to keep every color the converter sees.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="ctl-width" />
          <h3>Bead width: Auto, presets or Custom</h3>
          <p>
            Leave width on Auto for the size that keeps detail readable, pick a preset board
            (29 / 58 / 87 / 116), or type an exact width from 10 to 200 to hit a specific
            finished size.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="ctl-bg" />
          <h3>Remove background</h3>
          <p>
            Off by default, so full scenes convert as-is. Turn it on to clear the solid color
            connected to the edges — it works best when your subject already sits on a plain
            backdrop.
          </p>
        </div>
        <div class="guide-item">
          <DemoFigure name="ctl-simplify" />
          <h3>Simplify shades &amp; dark outline</h3>
          <p>
            Keep shades, Balanced or Bold decides how aggressively near-duplicate colors merge.
            Dark outline, also off by default, traces the silhouette in the darkest bead when you
            do cut the subject out.
          </p>
        </div>
      </div>
    </section>

    <section class="guide-card" aria-label="What your pattern includes">
      <h2>What your pattern includes</h2>
      <ul class="pattern-includes">
        <li>A printable pattern sheet with pegboard seams every 29 beads</li>
        <li>Bead counts per color, each with its Mardiy code and hex</li>
        <li>Pegboard count — how many 29 × 29 boards the design spans</li>
        <li>A PNG export and a one-click jump into the bead editor</li>
      </ul>
      <p class="fine-print">
        Convert photos you own or have the right to use. Bead versions of other people's artwork
        or characters are for your own shelf, not for sale.
      </p>
    </section>

    <section class="guide-card" aria-label="Frequently asked questions">
      <h2>Frequently asked questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="keep-reading">
        Rather start from a ready-made design? Browse the
        <a href="/perler-bead-patterns/">full perler bead pattern set</a> — 116 animal, character,
        food and Halloween boards at every size, each with the same printable template and bead
        list.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import '../scripts/photoBead';
</script>

<style>
  .tool-shell {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: var(--sp-4);
    background: var(--bg, #fff);
  }
  /* every guide block gets its own framed card — one border per section so
     the long bottom half reads as blocks instead of a wall (user call,
     2026-10-29) */
  .guide-stack {
    max-width: 56rem;
    margin-top: var(--sp-8);
    display: grid;
    gap: var(--sp-4);
  }
  .guide-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: var(--sp-4);
  }
  .guide-card > h2 {
    margin-top: 0;
  }
  .guide-sub {
    color: var(--muted);
    font-weight: 600;
    margin-top: calc(-1 * var(--sp-2));
  }
  .guide-card > p:not(.guide-sub):not(.fine-print):not(.keep-reading) {
    max-width: 46rem;
  }
  .guide-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .guide-item {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: var(--sp-3);
    background: var(--bg);
    display: flex;
    flex-direction: column;
  }
  .guide-item h3 {
    font-size: 0.98rem;
    margin: var(--sp-2) 0 0;
  }
  .guide-item p {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.4rem;
  }
  .demo-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: var(--sp-2);
  }
  .demo-chips span {
    font-family: var(--mono);
    font-size: 0.72rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
  }
  .pattern-includes {
    margin-top: var(--sp-2);
  }
  .pattern-includes li {
    margin-top: 0.3rem;
  }
  .fine-print {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px dashed var(--border);
  }
  .guide-card .faq {
    margin-top: var(--sp-3);
  }
  /* source-site layout: photo + settings left, result right — originals and
     the converted board sit side by side for direct comparison (user call,
     2026-10-29); narrow screens stack the same order */
  .pm-grid {
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 981px) {
    .pm-grid {
      grid-template-columns: minmax(340px, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }
  /* compact upload row — a dashed card the size of a setting, not a hero
     banner (user call: the drop zone was eating the page) */
  .upload-row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 14px;
    border: 1.5px dashed var(--border);
    border-radius: 12px;
    background: var(--paper, #fbfaf7);
    cursor: pointer;
    transition: border-color 0.12s ease;
  }
  .upload-row:hover,
  .upload-row:focus-visible,
  .upload-row.over {
    border-color: var(--accent, #b3552e);
  }
  .choose-btn {
    flex: none;
    padding: 8px 14px;
    border-radius: 999px;
    background: #1c1c1c;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .file-name {
    min-width: 0;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .settings {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .setting-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .setting-help {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: var(--ink-soft, #666);
  }
  .opt-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
  .opt-pills button {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg, #fff);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .opt-pills button:hover {
    border-color: var(--accent, #b3552e);
  }
  .opt-pills button.active {
    border-color: var(--accent, #b3552e);
    background: #fffaf0;
    box-shadow: inset 0 0 0 1px var(--accent, #b3552e);
    font-weight: 600;
  }
  /* bead width lives in two separate cards — Presets and Custom are peer
     options, not one merged pill row (user call, 2026-10-29) */
  .width-duo {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .width-box {
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--paper, #fbfaf7);
  }
  .width-box .opt-pills {
    margin-top: 0;
  }
  .width-box-title {
    margin: 0 0 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft, #666);
  }
  .custom-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
  }
  .custom-row input {
    width: 90px;
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font: inherit;
  }
  .width-error {
    margin: 6px 0 0;
    font-size: 0.82rem;
    color: #b45309;
  }
  .check-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--paper, #fbfaf7);
    cursor: pointer;
  }
  .check-card input {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    accent-color: var(--accent, #b3552e);
  }
  .check-card .check-body {
    display: grid;
    gap: 2px;
    font-size: 0.85rem;
  }
  .check-card .check-body span {
    color: var(--ink-soft, #666);
  }
  /* source-photo slot sits between the settings and the auto-apply note —
     the source-site position (user call: the original must show right
     above "Changes apply automatically…"). Ships with a dashed placeholder
     so the slot is visible before any upload. */
  .source-empty {
    padding: var(--sp-5) var(--sp-3);
    border: 1.5px dashed var(--border);
    border-radius: 12px;
    text-align: center;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-soft, #666);
  }
  .auto-note {
    margin: var(--sp-3) 0 0;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--ink-soft, #666);
  }
  .photo-status {
    margin: var(--sp-3) 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft, #666);
    min-height: 1.4em;
  }
  .photo-stage {
    margin-top: 0;
  }
  @media (max-width: 980px) {
    .photo-stage {
      margin-top: var(--sp-2);
    }
  }
  .stage-empty {
    padding: var(--sp-8) var(--sp-4);
    border: 1px dashed var(--border);
    border-radius: 12px;
    text-align: center;
    color: var(--ink-soft, #666);
    font-style: italic;
  }
  .hidden {
    display: none !important;
  }
</style>

<style is:global>
  /* Runtime result built by scripts/photoBead.ts lives outside the scoped
     tree — these rules mirror the source-site result layout: cream panels,
     a paper preview board with peg holes and pegboard seams, and per-color
     rows with the Mardiy codes shoppers order by. */
  .photo-stage .paint-card {
    display: grid;
    gap: var(--sp-4);
  }
  .photo-stage .fig-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: var(--sp-3);
    background: var(--bg, #fff);
  }
