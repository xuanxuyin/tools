---
import BeadCategoryPage from '../components/BeadCategoryPage.astro';
import { BEAD_COLLECTION_SEO } from '../data/beadSeo';
import { patternsByCategory } from '../lib/beadContent';

const groups = [
  {
    label: 'Animals',
    labelKey: 'bs.gAnL',
    href: '/perler-bead-animals/',
    blurb: 'Corgis, shibas, huskies, cats, carrot bunnies and pandas — community designs converted bead for bead.',
    blurbKey: 'bs.fuAnB',
    patterns: patternsByCategory('animals'),
  },
  {
    label: 'Characters',
    labelKey: 'bs.gChL',
    href: '/perler-bead-characters/',
    blurb: 'Big-eyed girls, chibi heroes and friendly spooks — portrait boards on real bead colors.',
    blurbKey: 'bs.fuChB',
    patterns: patternsByCategory('characters'),
  },
  {
    label: 'Halloween',
    labelKey: 'bs.gHaL',
    href: '/perler-bead-halloween/',
    blurb: 'Kawaii bats, witch cats and pumpkin ghosts — the spooky set on its own page.',
    blurbKey: 'bs.fuHaB',
    patterns: patternsByCategory('halloween'),
  },
  {
    label: 'Quick Makes',
    labelKey: 'bs.gQkL',
    blurb: 'Snacks, hearts and other quick makes — mostly small boards for one quiet evening.',
    patterns: [...patternsByCategory('food'), ...patternsByCategory('minis')],
  },
];
---

<BeadCategoryPage seo={BEAD_COLLECTION_SEO.fuse!} groups={groups}>
  <p class="collection-strip"><span data-i18n="bs.fuNarrow">Looking for something narrower?</span>
    <a href="/cute-perler-bead-patterns/" data-i18n="bs.fuCute">Cute patterns</a> ·
    <a href="/small-perler-bead-patterns/" data-i18n="bs.fuSm">Small one-board patterns</a> ·
    <a href="/easy-perler-bead-patterns/" data-i18n="bs.fuEz">Easy patterns</a> ·
    <a href="/perler-bead-letters/" data-i18n="bs.fuLe">Letters &amp; numbers</a>
  </p>
</BeadCategoryPage>

<style>
  .collection-strip {
    margin-top: var(--sp-5);
    font-size: 0.95rem;
    color: var(--ink-soft, #666);
  }
  .collection-strip a {
    color: var(--accent, #b3552e);
    white-space: nowrap;
  }
</style>
