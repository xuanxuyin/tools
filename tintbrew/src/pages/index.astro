---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeadFigure from '../components/BeadFigure.astro';
import { BEAD_PATTERNS } from '../data/beadPatterns';
import { categoryCounts, patternContents } from '../lib/beadContent';
import { SITE } from '../consts';

// one flagship board per category stands in for the whole set — the figures
// render server-side from the same pattern data as the gallery pages, so the
// homepage shows real bead art with zero image assets
const bySlug = (slug: string) => patternContents.find((p) => p.def.slug === slug)!;

const title = 'TintBrew — Mix Colors Online & Convert HEX, RGB, HSL, CMYK';
const description =
  'Free online color mixer that blends colors perceptually (Oklab), plus a HEX/RGB/HSL/CMYK converter. See exactly what two colors make — with live ratios and code snippets.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <h1>Brew colors, precisely.</h1>
    <p class="lead">
      Mix any colors online in a perceptual color space, convert between every format, and get copy-ready
      CSS code. Free, instant, and private — everything runs in your browser.
    </p>
  </section>

  <section aria-label="Color tools" class="tool-grid">
    <a class="tool-card" href="/color-mixer">
      <h2>Color Mixer</h2>
      <p>
        Blend 2–5 colors with ratio sliders. Perceptual Oklab mixing matches how paint behaves, and every
        result ships with HEX, RGB, HSL, CMYK and a CSS <code>color-mix()</code> snippet.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#ef4444"></span>
        <span style="background:#8b5cf6"></span>
        <span style="background:#3b82f6"></span>
      </div>
    </a>
    <a class="tool-card" href="/color-converter">
      <h2>Color Converter</h2>
      <p>
        Paste a HEX code or dial in RGB, HSL or CMYK — every other format updates as you type, with
        one-click copy for each.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#f59e0b"></span>
        <span style="background:#fbbf24"></span>
        <span style="background:#fde68a"></span>
      </div>
    </a>
    <a class="tool-card" href="/photo-to-perler-bead-pattern/">
      <h2>Photo to Bead Pattern</h2>
      <p>
        Turn any photo into a fuse-bead board on the official 103-color Perler line — real color
        names and P-codes on the shopping list, printable grid and bead counts included.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#278cc9"></span>
        <span style="background:#fd5918"></span>
        <span style="background:#4dab64"></span>
      </div>
    </a>
  </section>

  <section aria-label="Perler bead patterns" class="tool-grid bead-grid" style="margin-top: var(--sp-8);">
    <h2 class="grid-title">
      <span>
        Perler bead patterns <span class="hint">— color work you can hold</span>
      </span>
      <a class="all-link" href="/perler-bead-patterns/">All {BEAD_PATTERNS.length} patterns →</a>
    </h2>
    <a class="bead-card" href="/perler-bead-animals/">
      <span class="bead-thumb"><BeadFigure view={bySlug('cat')} mode="reference" /></span>
      <span class="bead-count">{categoryCounts.animals} patterns</span>
      <h3>Animals</h3>
      <p>Cat, panda, fox — and a whole kennel of dogs. Recolor any board online before you print.</p>
    </a>
    <a class="bead-card" href="/perler-bead-characters/">
      <span class="bead-thumb"><BeadFigure view={bySlug('blue-alien')} mode="reference" /></span>
      <span class="bead-count">{categoryCounts.characters} patterns</span>
      <h3>Characters</h3>
      <p>Big-eyed girls, chibi heroes and friendly spooks — portrait boards on real bead colors.</p>
    </a>
    <a class="bead-card" href="/perler-bead-food/">
      <span class="bead-thumb"><BeadFigure view={bySlug('cupcake')} mode="reference" /></span>
      <span class="bead-count">{categoryCounts.food} patterns</span>
      <h3>Food</h3>
      <p>Fruit, snacks and sweets that look good enough to eat — each with exact bead counts.</p>
    </a>
    <a class="bead-card" href="/christmas-perler-bead-patterns/">
      <span class="bead-thumb"><BeadFigure view={bySlug('christmas-tree')} mode="reference" /></span>
      <span class="bead-count">{categoryCounts.christmas} patterns</span>
      <h3>Christmas</h3>
      <p>Trees, snowmen and stockings — seasonal boards sized for small hands, one sheet each.</p>
    </a>
    <p class="bead-more">
      First board? The <a href="/easy-perler-bead-patterns/">easy patterns</a> keep it small — and
      the <a href="/perler-bead-patterns/">Halloween set</a> lives on the main pattern page.
    </p>
  </section>

  <section class="prose" style="margin-top: var(--sp-8);">
    <h2>What two colors make?</h2>
    <p>
      Mixing colors isn't one question — screens blend light (additive) while paint blends pigments
      (subtractive), and the results differ. Our mix guides answer the classic combinations with live
      examples, exact HEX codes, and ratio tables:
    </p>
    <ul>
      <li><a href="/mix/red-blue">What color does red and blue make?</a></li>
      <li><a href="/mix/blue-yellow">What color does blue and yellow make?</a></li>
      <li><a href="/mix/red-green">What color does red and green make?</a></li>
      <li><a href="/what-colors-make-brown">What colors make brown?</a> — every route, computed</li>
      <li><a href="/mix/red-yellow">What color does red and yellow make?</a></li>
      <li><a href="/mix/black-white">What color does black and white make?</a></li>
    </ul>
    <p>Browse <a href="/mix">all color mixes</a> for the full list.</p>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2>Frosting and icing color guides</h2>
    <p>
      Real-world mixing questions answered with computed swatches — the exact color each drop
      count or recipe lands on, not a photograph:
    </p>
    <ul>
      <li><a href="/how-to-make-black-frosting">How to make black frosting</a> (that's actually black)</li>
      <li><a href="/how-to-make-brown-icing">How to make brown icing</a> — five ways, exact colors</li>
      <li><a href="/icing-color-chart">Icing color chart</a> — gel drops to HEX codes</li>
      <li><a href="/buttercream-color-chart">Buttercream color chart</a> — with the yellow shift explained</li>
    </ul>
    <p>See <a href="/color-guides">all color guides</a> for more.</p>
  </section>
</BaseLayout>

<style>
  /* the section heading lives inside the card grid — span it full width */
  .grid-title {
    grid-column: 1 / -1;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .grid-title .hint {
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .all-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent, #b3552e);
  }
  .all-link:hover {
    text-decoration: underline;
  }
  /* four type cards across on wide screens — tighter floor than .tool-grid's 16rem */
  .bead-grid {
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
  }
  .bead-card {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg, #fff);
    text-decoration: none;
    color: inherit;
  }
  .bead-card:hover {
    border-color: var(--accent, #b3552e);
  }
  .bead-thumb {
    display: flex;
    justify-content: center;
    height: 150px;
  }
  .bead-count {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent, #b3552e);
  }
  .bead-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .bead-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft, #666);
  }
  .bead-more {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft, #666);
  }
  .bead-more a {
    color: var(--accent, #b3552e);
  }
</style>

<style is:global>
  /* BeadFigure's own scoped `.bead-fig { width: 100%; height: auto }` fills
     the card — on the homepage the figure must fit INSIDE a fixed-height
     thumb instead, keeping each board's aspect via its viewBox. Global (not
     scoped) because .bead-fig is rendered by the child component and never
     carries this page's scope id. */
  .bead-thumb .bead-fig {
    width: auto;
    max-width: 100%;
    height: 100%;
  }
</style>
