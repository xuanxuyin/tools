---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeadFigure from '../components/BeadFigure.astro';
import ToolNav from '../components/ToolNav.astro';
import { BEAD_PATTERNS } from '../data/beadPatterns';
import { categoryCounts, easyPatterns, patternContents } from '../lib/beadContent';
import { mixes } from '../data/mixes';
import { buildMixContent } from '../lib/mixContent';
import { formatCss, hexToRgb, mixSteps, rgbToHex } from '../lib/color';
import { SITE } from '../consts';

// one flagship board per category stands in for the whole set — the figures
// render server-side from the same pattern data as the gallery pages, so the
// homepage shows real bead art with zero image assets
const bySlug = (slug: string) => patternContents.find((p) => p.def.slug === slug)!;

// decorative dots for the mix links carry the REAL computed answer color,
// same engine the mix pages use — not a hand-picked approximation
const mixHex = new Map(mixes.map((m) => {
  const c = buildMixContent(m);
  return [c.slug, c.resultHex] as const;
}));

// card demos are real tool output, not decoration (user call, 2026-10-29):
// the mixer strip is the engine's actual blend path; the converter rows are
// the same purple run through every format
const blendPath = mixSteps([hexToRgb('#ef4444'), hexToRgb('#3b82f6')], 9).map(rgbToHex);
const convRgb = hexToRgb('#6d28d9');
const convRows = ['#6d28d9', formatCss('rgb', convRgb), formatCss('hsl', convRgb)];

const title = 'TintBrew — Mix Colors Online & Convert HEX, RGB, HSL, CMYK';
const description =
  'Free online color mixer that blends colors perceptually (Oklab), plus a HEX/RGB/HSL/CMYK converter. See exactly what two colors make — with live ratios and code snippets.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <h1 data-i18n="home.h1">Brew colors, precisely.</h1>
    <p class="lead" data-i18n="home.lead">
      Mix any colors online in a perceptual color space, convert between every format, and get copy-ready
      CSS code. Free, instant, and private — everything runs in your browser.
    </p>
  </section>

  <ToolNav />

  <section aria-label="Color tools" class="tool-grid">
    <a class="tool-card" href="/color-mixer">
      <h2 data-i18n="nav.mixer">Color Mixer</h2>
      <p>
        <span data-i18n="home.mixDescA">Blend 2–5 colors with ratio sliders. Perceptual Oklab mixing matches how paint behaves, and every result ships with HEX, RGB, HSL, CMYK and a CSS</span>{' '}
        <code>color-mix()</code> <span data-i18n="home.mixDescB">snippet.</span>
      </p>
      <div class="card-demo" aria-hidden="true">
        <div class="demo-strip">
          {blendPath.map((s) => (
            <span style={`background:${s}`}></span>
          ))}
        </div>
      </div>
      <span class="card-cta" data-i18n="home.mixCta">Mix colors</span>
    </a>
    <a class="tool-card" href="/color-converter">
      <h2 data-i18n="nav.converter">Color Converter</h2>
      <p data-i18n="home.convDesc">
        Paste a HEX code or dial in RGB, HSL or CMYK — every other format updates as you type, with
        one-click copy for each.
      </p>
      <div class="card-demo" aria-hidden="true">
        <div class="conv-demo">
          <span class="conv-swatch" style="background:#6d28d9"></span>
          <span class="conv-formats">
            {convRows.map((r) => (
              <span>{r}</span>
            ))}
          </span>
        </div>
      </div>
      <span class="card-cta" data-i18n="home.convCta">Convert a color</span>
    </a>
    <a class="tool-card" href="/photo-to-perler-bead-pattern/">
      <h2 data-i18n="home.cardPhoto">Photo to Bead Pattern</h2>
      <p data-i18n="home.photoDesc">
        Turn any photo into a fuse-bead board matched to a real 291-color bead line — Mardiy
        codes on the shopping list, printable grid and bead counts included.
      </p>
      <div class="card-demo" aria-hidden="true">
        <div class="bead-demo">
          <BeadFigure view={bySlug('shiba')} mode="reference" thumb />
        </div>
      </div>
      <span class="card-cta" data-i18n="home.photoCta">Convert a photo</span>
    </a>
  </section>

  <section aria-label="Perler bead patterns" class="tool-grid bead-grid" style="margin-top: var(--sp-8);">
    <h2 class="grid-title">
      <span>
        <span data-i18n="home.beadTitle">Perler bead patterns</span> <span class="hint" data-i18n="home.beadHint">— color work you can hold</span>
      </span>
      <a class="all-link" href="/perler-bead-patterns/" data-i18n="home.allPatterns" data-i18n-args={JSON.stringify({ count: String(BEAD_PATTERNS.length) })}>All {BEAD_PATTERNS.length} patterns →</a>
    </h2>
    <a class="bead-card" href="/perler-bead-animals/">
      <span class="bead-thumb"><BeadFigure view={bySlug('shiba')} mode="reference" thumb /></span>
      <span class="bead-count" data-i18n="home.nPatterns" data-i18n-args={JSON.stringify({ count: String(categoryCounts.animals) })}>{categoryCounts.animals} patterns</span>
      <h3 data-i18n="home.catAnimals">Animals</h3>
      <p data-i18n="home.animDesc">Corgis, shibas, cats and carrot bunnies — a whole kennel of community designs. Recolor any board online before you print.</p>
    </a>
    <a class="bead-card" href="/perler-bead-characters/">
      <span class="bead-thumb"><BeadFigure view={bySlug('blue-alien')} mode="reference" thumb /></span>
      <span class="bead-count" data-i18n="home.nPatterns" data-i18n-args={JSON.stringify({ count: String(categoryCounts.characters) })}>{categoryCounts.characters} patterns</span>
      <h3 data-i18n="home.catCharacters">Characters</h3>
      <p data-i18n="home.charDesc">Big-eyed girls, chibi heroes and friendly spooks — portrait boards on real bead colors.</p>
    </a>
    <a class="bead-card" href="/perler-bead-halloween/">
      <span class="bead-thumb"><BeadFigure view={bySlug('spooky-ghost')} mode="reference" thumb /></span>
      <span class="bead-count" data-i18n="home.nPatterns" data-i18n-args={JSON.stringify({ count: String(categoryCounts.halloween) })}>{categoryCounts.halloween} patterns</span>
      <h3 data-i18n="home.catHalloween">Halloween</h3>
      <p data-i18n="home.halloDesc">Kawaii bats, witch cats and pumpkin ghosts — the spooky set on its own page.</p>
    </a>
    <a class="bead-card" href="/easy-perler-bead-patterns/">
      <span class="bead-thumb"><BeadFigure view={bySlug('corgi-butt-peek')} mode="reference" thumb /></span>
      <span class="bead-count" data-i18n="home.nPatterns" data-i18n-args={JSON.stringify({ count: String(easyPatterns.length) })}>{easyPatterns.length} patterns</span>
      <h3 data-i18n="home.catEasy">Easy</h3>
      <p data-i18n="home.easyDesc">Small boards, big color areas — first-timers finish any of these in one sitting.</p>
    </a>
    <p class="bead-more">
      <span data-i18n="home.beadMoreA">Plus quick makes — snacks, hearts and other small boards — on the</span>{' '}
      <a href="/perler-bead-patterns/" data-i18n="home.beadMoreLink">main pattern page</a>.
    </p>
  </section>

  <section class="prose" style="margin-top: var(--sp-8);">
    <h2 data-i18n="home.mixTitle">What two colors make?</h2>
    <p data-i18n="home.mixIntro">
      Mixing colors isn't one question — screens blend light (additive) while paint blends pigments
      (subtractive), and the results differ. These guides answer the classic combinations with live
      examples, exact HEX codes, and ratio tables. The dot on each card is the real computed answer:
    </p>
    <div class="link-grid">
      <a class="link-tile" href="/mix/red-blue">
        <span class="dot" style={`background:${mixHex.get('red-blue')}`}></span>
        <span data-i18n="home.qRedBlue">What does red and blue make?</span>
      </a>
      <a class="link-tile" href="/mix/blue-yellow">
        <span class="dot" style={`background:${mixHex.get('blue-yellow')}`}></span>
        <span data-i18n="home.qBlueYellow">What does blue and yellow make?</span>
      </a>
      <a class="link-tile" href="/mix/red-green">
        <span class="dot" style={`background:${mixHex.get('red-green')}`}></span>
        <span data-i18n="home.qRedGreen">What does red and green make?</span>
      </a>
      <a class="link-tile" href="/what-colors-make-brown">
        <span class="dot" style="background:#8a5a3b"></span>
        <span data-i18n="home.qBrown">What colors make brown? — every route</span>
      </a>
      <a class="link-tile" href="/mix/red-yellow">
        <span class="dot" style={`background:${mixHex.get('red-yellow')}`}></span>
        <span data-i18n="home.qRedYellow">What does red and yellow make?</span>
      </a>
      <a class="link-tile" href="/mix/black-white">
        <span class="dot" style={`background:${mixHex.get('black-white')}`}></span>
        <span data-i18n="home.qBlackWhite">What does black and white make?</span>
      </a>
    </div>
    <p><span data-i18n="home.browseA">Browse</span> <a href="/mix" data-i18n="home.allMixes">all color mixes</a> <span data-i18n="home.browseB">for the full list.</span></p>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="home.frostTitle">Frosting and icing color guides</h2>
    <p data-i18n="home.frostIntro">
      Real-world mixing questions answered with computed swatches — the exact color each drop
      count or recipe lands on, not a photograph:
    </p>
    <div class="link-grid">
      <a class="link-tile" href="/how-to-make-black-frosting">
        <span class="dot" style="background:#2b2b2b"></span>
        <span data-i18n="home.tBlackFrost">How to make black frosting</span>
      </a>
      <a class="link-tile" href="/how-to-make-brown-icing">
        <span class="dot" style="background:#7a4a2b"></span>
        <span data-i18n="home.tBrownIcing">How to make brown icing — five ways</span>
      </a>
      <a class="link-tile" href="/icing-color-chart">
        <span class="dot" style="background:#ef8fb5"></span>
        <span data-i18n="home.tIcingChart">Icing color chart</span>
      </a>
      <a class="link-tile" href="/buttercream-color-chart">
        <span class="dot" style="background:#f6e3a1"></span>
        <span data-i18n="home.tButterChart">Buttercream color chart</span>
      </a>
    </div>
    <p><span data-i18n="home.seeA">See</span> <a href="/color-guides" data-i18n="home.allGuides">all color guides</a> <span data-i18n="home.seeB">for more.</span></p>
  </section>
</BaseLayout>

<style>
  /* the section heading lives inside the card grid — span it full width */
  .grid-title {
    grid-column: 1 / -1;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .grid-title .hint {
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .all-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent, #b3552e);
  }
  .all-link:hover {
    text-decoration: underline;
  }
  /* four type cards across on wide screens — tighter floor than .tool-grid's 16rem */
  .bead-grid {
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
  }
  .bead-card {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg, #fff);
    text-decoration: none;
    color: inherit;
  }
  .bead-card:hover {
    border-color: var(--accent, #b3552e);
  }
  .bead-thumb {
    display: flex;
    justify-content: center;
    height: 150px;
  }
  .bead-count {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent, #b3552e);
  }
  .bead-card h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .bead-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft, #666);
  }
  .bead-more {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft, #666);
  }
  .bead-more a {
    color: var(--accent, #b3552e);
  }
  /* tool-card demos: one framed 4.5rem band per card, real content inside —
     the mixer's blend path, the converter's format rows, an actual board */
  .card-demo {
    margin-top: auto;
    height: 4.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #fff;
  }
  .demo-strip {
    display: flex;
    height: 100%;
  }
  .demo-strip > span {
    flex: 1;
  }
  .conv-demo {
    display: flex;
    height: 100%;
  }
  .conv-swatch {
    width: 4.5rem;
    height: 100%;
  }
  .conv-formats {
    flex: 1;
    display: grid;
    place-content: center;
    gap: 0.22rem;
    padding: 0 0.8rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .bead-demo {
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.3rem;
  }
</style>

<style is:global>
  /* BeadFigure's own scoped `.bead-fig { width: 100%; height: auto }` fills
     the card — on the homepage the figure must fit INSIDE a fixed-height
     thumb instead, keeping each board's aspect (svg via viewBox, img via
     object-fit). Global (not scoped) because both are rendered by the child
     component and never carry this page's scope id. */
  .bead-thumb .bead-fig {
    width: auto;
    max-width: 100%;
    height: 100%;
  }
  .bead-thumb .bead-thumb-img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .card-demo .bead-fig {
    width: auto;
    max-width: 100%;
    height: 100%;
  }
  .card-demo .bead-thumb-img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
