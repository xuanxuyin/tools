---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const title = 'TintBrew — Mix Colors Online & Convert HEX, RGB, HSL, CMYK';
const description =
  'Free online color mixer that blends colors perceptually (Oklab), plus a HEX/RGB/HSL/CMYK converter. See exactly what two colors make — with live ratios and code snippets.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <h1>Brew colors, precisely.</h1>
    <p class="lead">
      Mix any colors online in a perceptual color space, convert between every format, and get copy-ready
      CSS code. Free, instant, and private — everything runs in your browser.
    </p>
  </section>

  <section aria-label="Color tools" class="tool-grid">
    <a class="tool-card" href="/color-mixer">
      <h2>Color Mixer</h2>
      <p>
        Blend 2–5 colors with ratio sliders. Perceptual Oklab mixing matches how paint behaves, and every
        result ships with HEX, RGB, HSL, CMYK and a CSS <code>color-mix()</code> snippet.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#ef4444"></span>
        <span style="background:#8b5cf6"></span>
        <span style="background:#3b82f6"></span>
      </div>
    </a>
    <a class="tool-card" href="/color-converter">
      <h2>Color Converter</h2>
      <p>
        Paste a HEX code or dial in RGB, HSL or CMYK — every other format updates as you type, with
        one-click copy for each.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#f59e0b"></span>
        <span style="background:#fbbf24"></span>
        <span style="background:#fde68a"></span>
      </div>
    </a>
    <a class="tool-card" href="/photo-to-perler-bead-pattern/">
      <h2>Photo to Bead Pattern</h2>
      <p>
        Turn any photo into a fuse-bead board on the official 103-color Perler line — real color
        names and P-codes on the shopping list, printable grid and bead counts included.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#278cc9"></span>
        <span style="background:#fd5918"></span>
        <span style="background:#4dab64"></span>
      </div>
    </a>
  </section>

  <section aria-label="Perler bead patterns" class="tool-grid" style="margin-top: var(--sp-8);">
    <h2 class="grid-title">
      Perler bead patterns <span class="hint">— color work you can hold</span>
    </h2>
    <a class="tool-card" href="/perler-bead-patterns/">
      <h3>All free Perler patterns</h3>
      <p>
        Every pattern on one page — animals, food, holidays and minis, each with a printable grid,
        a bead shopping list, and a paint-it-yourself canvas.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#323234"></span>
        <span style="background:#eaefee"></span>
        <span style="background:#fd5918"></span>
      </div>
    </a>
    <a class="tool-card" href="/perler-bead-animals/">
      <h3>Perler bead animals</h3>
      <p>
        Cats, dogs and more — full-size boards in the real Perler palette, ready to print or play
        online.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#936848"></span>
        <span style="background:#f6ca69"></span>
        <span style="background:#323234"></span>
      </div>
    </a>
    <a class="tool-card" href="/perler-bead-food/">
      <h3>Perler bead food</h3>
      <p>
        Fruit, snacks and sweets that look good enough to eat — with exact bead counts for each
        color.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#fd5918"></span>
        <span style="background:#f6d901"></span>
        <span style="background:#d14337"></span>
      </div>
    </a>
    <a class="tool-card" href="/christmas-perler-bead-patterns/">
      <h3>Christmas Perler patterns</h3>
      <p>
        Trees, ornaments and gifts — seasonal boards sized for small hands, printed on one sheet
        each.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#007b4e"></span>
        <span style="background:#b0353c"></span>
        <span style="background:#eaefee"></span>
      </div>
    </a>
    <a class="tool-card" href="/easy-perler-bead-patterns/">
      <h3>Easy Perler patterns</h3>
      <p>
        Small boards, few colors, big win — the right first project for beginners and kids.
      </p>
      <div class="swatch-strip" aria-hidden="true">
        <span style="background:#f2afb7"></span>
        <span style="background:#96d1d4"></span>
        <span style="background:#a3de6f"></span>
      </div>
    </a>
  </section>

  <section class="prose" style="margin-top: var(--sp-8);">
    <h2>What two colors make?</h2>
    <p>
      Mixing colors isn't one question — screens blend light (additive) while paint blends pigments
      (subtractive), and the results differ. Our mix guides answer the classic combinations with live
      examples, exact HEX codes, and ratio tables:
    </p>
    <ul>
      <li><a href="/mix/red-blue">What color does red and blue make?</a></li>
      <li><a href="/mix/blue-yellow">What color does blue and yellow make?</a></li>
      <li><a href="/mix/red-green">What color does red and green make?</a></li>
      <li><a href="/what-colors-make-brown">What colors make brown?</a> — every route, computed</li>
      <li><a href="/mix/red-yellow">What color does red and yellow make?</a></li>
      <li><a href="/mix/black-white">What color does black and white make?</a></li>
    </ul>
    <p>Browse <a href="/mix">all color mixes</a> for the full list.</p>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2>Frosting and icing color guides</h2>
    <p>
      Real-world mixing questions answered with computed swatches — the exact color each drop
      count or recipe lands on, not a photograph:
    </p>
    <ul>
      <li><a href="/how-to-make-black-frosting">How to make black frosting</a> (that's actually black)</li>
      <li><a href="/how-to-make-brown-icing">How to make brown icing</a> — five ways, exact colors</li>
      <li><a href="/icing-color-chart">Icing color chart</a> — gel drops to HEX codes</li>
      <li><a href="/buttercream-color-chart">Buttercream color chart</a> — with the yellow shift explained</li>
    </ul>
    <p>See <a href="/color-guides">all color guides</a> for more.</p>
  </section>
</BaseLayout>

<style>
  /* the section heading lives inside the card grid — span it full width */
  .grid-title {
    grid-column: 1 / -1;
    margin: 0;
  }
  .grid-title .hint {
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--muted);
  }
  /* category cards sit one heading level under the tools row's h2 cards */
  .tool-card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
  }
</style>
