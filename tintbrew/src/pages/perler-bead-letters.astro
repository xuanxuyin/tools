---
/**
 * Perler bead letters — the alphabet and digits as one printable sheet of
 * inline 5×7 boards (perler bead letters 260 + perler bead alphabet 110).
 * Custom page rather than BeadCategoryPage: glyphs are not catalog patterns,
 * so cards render as figures with computed bead counts instead of links.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BeadFigure from '../components/BeadFigure.astro';
import { BEAD_COLLECTION_SEO } from '../data/beadSeo';
import { BEAD_LETTERS } from '../data/beadLetters';
import { buildPattern } from '../lib/beadContent';
import { SITE } from '../consts';

const seo = BEAD_COLLECTION_SEO.letters!;
const bySlug = (slug: string) => buildPattern(BEAD_LETTERS.find((l) => l.slug === slug)!);
const letters = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].map((ch) => bySlug(`letter-${ch.toLowerCase()}`));
const digits = [...'0123456789'].map((d) => bySlug(`digit-${d}`));

const allGlyphs = [...letters, ...digits];
const totalCount = allGlyphs.reduce((s, g) => s + g.totalBeads, 0);

// spell-a-name math, computed from the real grids (anti-thin-content rule)
const DEMO_NAME = 'EMMA';
const demoBeads = [...DEMO_NAME].reduce(
  (s, ch) => s + bySlug(`letter-${ch.toLowerCase()}`).totalBeads,
  0,
);

const [lead, ...prose] = seo.intro;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: seo.h1, item: `${SITE.url}${seo.path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: seo.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={seo.title} description={seo.description} path={seo.path.replace(/\/$/, '')} jsonLd={jsonLd}>
  <section class="hero">
    <p class="crumbs">
      <a href="/">Home</a> <span aria-hidden="true">›</span>
      <a href="/perler-bead-patterns/">Perler Bead Patterns</a> <span aria-hidden="true">›</span>
      <span>{seo.h1}</span>
    </p>
    <h1>{seo.h1}</h1>
    <p class="lead">{lead}</p>
    <p class="stat-row" aria-label="Sheet facts">
      <span class="stat"><strong>36</strong> glyphs — A to Z, 0 to 9</span>
      <span class="stat"><strong>{totalCount}</strong> beads for the whole sheet</span>
      <span class="stat">one letter ≈ <strong>1 in</strong> tall</span>
      <span class="stat">all <strong>free</strong> to print</span>
    </p>
  </section>

  <section class="prose" style="margin-top: var(--sp-4);">
    {prose.map((p) => <p>{p}</p>)}
    <p>
      Try it with a name: <strong>{DEMO_NAME}</strong> spells out in {demoBeads} beads across four
      boards — print the sheet once and you have every letter it needs. The count under each glyph
      below is exact, so a tub of assorted beads covers dozens of names.
    </p>
    <p>
      <a href="/easy-perler-bead-patterns/">First time placing from a grid?</a> Start with the
      single-color letters here, then move to the two-color minis —
      <a href="/small-perler-bead-patterns/">all the small boards live here</a>.
    </p>
  </section>

  <section class="glyph-section" style="margin-top: var(--sp-6);">
    <h2>Letters A–Z <span class="count">— 26 boards</span></h2>
    <div class="glyph-grid">
      {letters.map((g) => (
        <div class="glyph-card">
          <BeadFigure view={g} mode="reference" />
          <span class="glyph-name">{g.def.name.replace('Letter ', '')}</span>
          <span class="glyph-meta">{g.totalBeads} beads · {g.regions[0]!.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="glyph-section" style="margin-top: var(--sp-6);">
    <h2>Numbers 0–9 <span class="count">— 10 boards</span></h2>
    <div class="glyph-grid">
      {digits.map((g) => (
        <div class="glyph-card">
          <BeadFigure view={g} mode="reference" />
          <span class="glyph-name">{g.def.name.replace('Number ', '')}</span>
          <span class="glyph-meta">{g.totalBeads} beads · {g.regions[0]!.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2>FAQ</h2>
    {seo.faqs.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
</BaseLayout>

<style>
  .stat-row { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }
  .stat {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
  }
  .glyph-section h2 .count { font-weight: 400; font-size: 0.9em; color: var(--ink-soft, #666); }
  .glyph-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }
  .glyph-card {
    display: grid;
    gap: 6px;
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg, #fff);
    text-align: center;
  }
  .glyph-card :global(.bead-fig) {
    /* 5-wide glyphs render narrow — cap so cards stay tidy */
    max-width: 90px;
    margin: 0 auto;
  }
  .glyph-name { font-weight: 700; font-size: 1.15rem; }
  .glyph-meta { font-size: 0.75rem; color: var(--ink-soft, #999); font-variant-numeric: tabular-nums; }
</style>
