---
/**
 * /coloring/gallery/ — published colored artwork, ranked by likes. Same
 * shape as the perler /gallery/ page: SSR copy, island renders the UGC
 * list. Cards carry the publish date (createdAt) and link back to the base
 * coloring page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const title = 'Coloring Gallery — Finished Pages by Real Visitors, Ranked | TintBrew';
const description =
  'Colored artwork made by TintBrew visitors, ranked by likes and dated. Paint a coloring page, hit Publish whenever you like, and your art joins the board — no account needed.';

const faqs = [
  {
    q: 'How do I get my artwork into the gallery?',
    a: 'Hit the Publish button on any coloring page, whenever you like. Give your artwork a name, pick a nickname, confirm — it appears here immediately with the date you published it. Publishing is free and needs no account.',
  },
  {
    q: 'How often can I like a piece?',
    a: 'Each visitor gets one like per hour in this gallery, and it can go to any artwork. That keeps the ranking about what people genuinely enjoy rather than who can click fastest. The counter updates the moment your like lands.',
  },
  {
    q: 'How many artworks can I have?',
    a: 'Your coloring gallery starts with one slot and holds up to five — a separate pool from the bead gallery, sharing one credit wallet. Each like another visitor leaves on your pieces earns you a credit, and 100 credits unlock one more slot. Deleting a piece frees its slot right away; its likes are not refunded.',
  },
  {
    q: 'Do I need an account or sign-up?',
    a: 'No. Your identity is a random ID that lives in your own browser — the server only ever stores a scrambled hash of it, never your email or any login. Pick any nickname to show with your artwork; clearing your browser storage removes your pieces and your votes.',
  },
  {
    q: 'What does the date on each card mean?',
    a: 'It is the day the artwork was first published. If the artist repaints the same page and publishes again, the artwork updates in place and keeps its original date — the ranking position survives too.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TintBrew Coloring Gallery',
    url: `${SITE.url}/coloring/gallery/`,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript for the live ranking',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Coloring Pages', item: `${SITE.url}/coloring/` },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Coloring Gallery',
        item: `${SITE.url}/coloring/gallery/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/coloring/gallery" jsonLd={jsonLd}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/coloring/" data-i18n="col.p.crumb">Coloring pages</a>
    <span aria-hidden="true"> / </span>
    <strong data-i18n="col.g.h1">Coloring gallery</strong>
  </nav>

  <section class="hero">
    <h1 data-i18n="col.g.h1">Coloring gallery</h1>
    <p class="lead" data-i18n="col.g.lead">
      Finished coloring pages made by real visitors, ranked by likes. Every card shows the artwork,
      its artist, and the day it was published — and every card links back to the page it was
      painted on, so you can color the same picture your own way.
    </p>
    <p class="note" data-i18n="col.note">
      A new page every day · publish one to unlock the next · paint with a brush · no account, no cost.
    </p>
  </section>

  <div class="gallery" data-coloring-gallery>
    <p class="gal-status" data-col-gal-status aria-live="polite" hidden></p>

    <section class="gal-mine" data-col-gal-mine>
      <h2 data-i18n="col.g.mineH">Your gallery</h2>
      <p class="gal-minenone" data-i18n="col.g.mineNone">
        You haven’t published yet. Paint a page and hit Publish — whenever it looks good to you.
      </p>
    </section>

    <section>
      <h2 data-i18n="col.g.rankH">Top artwork</h2>
      <ol class="gal-list" data-col-gal-list>
        <li class="gal-empty" data-i18n="col.g.loading">Loading the gallery…</li>
      </ol>
      <noscript>
        <p class="note">
          <span data-i18n="col.g.nojs">The live ranking needs JavaScript. Everything else on this page — how publishing
          works, the rules, the FAQ — reads fine without it.</span>
        </p>
      </noscript>
    </section>
  </div>

  <section class="prose band" style="margin-top: var(--sp-8);">
    <h2 data-i18n="col.howH">How daily coloring works</h2>
    <p><strong data-i18n="col.how1H">Start simple.</strong><span data-i18n="col.how1B">
      The pages are sorted by detail level, so page one is a warm-up with barely a dozen regions and
      the last pages pack well over a thousand. The curve is the same one the original
      paint-by-number books used: small wins first, marathon pages later.</span></p>
    <p><strong data-i18n="col.how2H">One page a day.</strong><span data-i18n="col.how2B">
      Publish your current page and the next unlocks instantly — or wait for tomorrow’s free unlock,
      your choice. No account needed: your progress lives quietly in your own browser, and the
      server only ever stores a scrambled hash of that ID.</span></p>
    <p><strong data-i18n="col.how3H">Paint and publish.</strong><span data-i18n="col.how3B">
      Pick a color, pick a brush size, and drag on the picture — the ink lines stay on top.
      Painting isn’t saved between visits, and Publish is always yours to hit: one colored corner
      or the whole picture, whenever it looks good to you. Likes from other visitors earn credits
      that unlock more gallery slots.</span></p>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="pg.faqTitle">Frequently asked questions</h2>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <details>
            <summary data-i18n={`colg.fq${i + 1}`}>{f.q}</summary>
            <p data-i18n={`colg.fa${i + 1}`}>{f.a}</p>
          </details>
        ))
      }
    </div>
    <p style="margin-top: var(--sp-4);">
      <span data-i18n="col.gal.readyA">Ready to make one? </span
      ><a href="/coloring/" data-i18n="col.g.lPages">Browse the coloring pages</a
      ><span data-i18n="col.gal.readyD"> and color your own.</span>
    </p>
  </section>
</BaseLayout>

<style>
  .crumb {
    margin-top: var(--sp-4);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .gallery {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-6);
  }
  .gal-status {
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  /* mine + list internals are injected by the island — :global required */
  .gal-mine :global(.gal-card) {
    max-width: 22rem;
  }
  .gal-mine :global(.gal-minenone) {
    color: var(--muted);
    margin: 0;
  }
  .gal-mine :global(.gal-underreview) {
    margin-bottom: var(--sp-2);
  }
  .gal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: var(--sp-3);
  }
  @media (max-width: 40rem) {
    .gal-list {
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    }
  }
  /* injected card internals — :global required */
  .gal-list :global(.col-gthumb) {
    line-height: 0;
  }
  .gal-list :global(.col-gthumb img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .gal-list :global(.col-date) {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .gal-list :global(.col-basename) {
    text-transform: capitalize;
  }
  .gal-mine :global(.col-gthumb) {
    line-height: 0;
  }
  .gal-mine :global(.col-gthumb img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .gal-mine :global(.col-date) {
    display: block;
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
</style>

<script>
  import '../../scripts/coloringGallery';
</script>
