---
/**
 * /coloring/[slug]/ — one coloring page. The SSR shell carries the crawlable
 * copy (title, meta, how-to, FAQ) plus the public line art inside the canvas
 * frame; the paint island fetches the region payload from the unlock-gated
 * API and takes over the canvas. No-JS visitors still see the line art and
 * can save/print it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { COLORING_PIECES, getPiece } from '../../data/coloring';

export function getStaticPaths() {
  return COLORING_PIECES.map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}

const { piece } = Astro.props;
const ord = COLORING_PIECES.indexOf(piece);
const total = COLORING_PIECES.length;

// difficulty tier copy — varied per position so 210 pages don't read as
// clones. SSR renders the English copy (crawlable, no-JS safe); the island
// swap replaces it via the col.tier* keys ({n} regions, {t} title) so zh/ko
// readers get the same text in their language.
function tierCopy(n: number): { h: string; p: string; tier: number } {
  if (n < 12)
    return {
      tier: 1,
      h: 'A gentle warm-up',
      p: `With just ${piece.regions} regions, “${piece.title}” is a short, satisfying session — most people finish it in a few minutes. Perfect first page, or a calm wind-down between the bigger pictures.`,
    };
  if (n < 60)
    return {
      tier: 2,
      h: 'An easy, relaxing page',
      p: `“${piece.title}” has ${piece.regions} regions to color — enough variety to stay interesting, small enough to finish in one sitting. A good everyday coloring page.`,
    };
  if (n < 150)
    return {
      tier: 3,
      h: 'A step up in detail',
      p: `${piece.regions} regions make “${piece.title}” a proper project: half an hour or more of steady brushwork, with plenty of small areas that reward a careful color choice.`,
    };
  if (n < 400)
    return {
      tier: 4,
      h: 'A detailed picture',
      p: `With ${piece.regions} separate regions, “${piece.title}” is for the dedicated colorist. Take it a section at a time — the page doesn’t keep your painting between visits, so publish the parts you love.`,
    };
  return {
    tier: 5,
    h: 'A marathon page',
    p: `“${piece.title}” packs ${piece.regions} regions into one picture — one of the most detailed pages in the collection. Spread it over a few sittings; your progress is saved in your browser after every stroke.`,
  };
}
const tier = tierCopy(ord);
const tierArgs = JSON.stringify({ n: String(piece.regions), t: piece.title });

const prev = ord > 0 ? COLORING_PIECES[ord - 1] : null;
const next = ord < total - 1 ? COLORING_PIECES[ord + 1] : null;

const title = `${piece.title} Coloring Page — Free Online, ${piece.regions} Regions | TintBrew`;
const description = `Color “${piece.title}” online for free. Paint with a real brush — pick a color and drag with your finger or mouse. Automatic saving, a new coloring page unlocked every day, and publish to the community gallery whenever you like.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${piece.title} — TintBrew Coloring Page`,
    url: `${SITE.url}/coloring/${piece.slug}/`,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript for the coloring canvas',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Coloring Pages', item: `${SITE.url}/coloring/` },
      {
        '@type': 'ListItem',
        position: 3,
        name: piece.title,
        item: `${SITE.url}/coloring/${piece.slug}/`,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={`/coloring/${piece.slug}`} jsonLd={jsonLd}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/coloring/" data-i18n="col.p.crumb">Coloring pages</a>
    <span aria-hidden="true"> / </span>
    <strong data-i18n-piece={piece.slug}>{piece.title}</strong>
  </nav>

  <section class="hero">
    <h1><span data-i18n-piece={piece.slug}>{piece.title}</span> <span class="col-h1-note" data-i18n="col.h1n">Coloring Page</span></h1>
    <p class="lead">
      <span data-i18n="col.p.metaA">Page</span> {ord + 1}
      <span data-i18n="col.p.metaB" data-i18n-args={JSON.stringify({ total: String(total) })}>
        of {total} ·</span
      >
      <span class="col-regions" data-col-regions>{piece.regions} areas to color</span>
    </p>
  </section>

  <div class="col-app" data-coloring-paint data-slug={piece.slug} data-regions={piece.regions}>
    <p class="col-status" data-col-status aria-live="polite" hidden></p>

    <div class="col-frame">
      <!-- the public line art: visible before the payload loads, printable no-JS -->
      <img
        class="col-lineart"
        src={`/coloring/line/${piece.slug}.webp?v=7`}
        alt={`${piece.title} coloring page line art`}
        width={piece.w}
        height={piece.h}
        fetchpriority="high"
      />
      <canvas class="col-canvas" data-col-canvas hidden data-i18n-aria="col.p.canvasAria"
        aria-label="Coloring canvas — paint freehand with your finger or mouse"></canvas>
    </div>

    <div class="col-toolbar" data-col-toolbar hidden>
      <p class="col-hint" data-i18n="col.p.hint">Pick a color, then drag on the picture to paint.</p>
      <div class="col-tools">
        <div class="col-toolgroup" role="group" aria-label="Tool">
          <button
            type="button"
            class="col-tool is-active"
            data-col-tool="brush"
            aria-pressed="true"
          >
            <img src="/coloring/icons/brush.png" alt="" width="26" height="26" />
            <span data-i18n="col.p.brush">Brush</span>
          </button>
          <button
            type="button"
            class="col-tool"
            data-col-tool="erase"
            aria-pressed="false"
          >
            <img src="/coloring/icons/eraser.png" alt="" width="26" height="26" />
            <span data-i18n="col.p.eraser">Eraser</span>
          </button>
        </div>
        <div class="col-toolgroup" role="group" data-i18n-aria="col.p.sizeGroup" aria-label="Brush size">
          <button type="button" class="col-tool" data-col-size="s" aria-pressed="false">
            <span data-i18n="col.p.sizeS">Small</span>
          </button>
          <button type="button" class="col-tool is-active" data-col-size="m" aria-pressed="true">
            <span data-i18n="col.p.sizeM">Medium</span>
          </button>
          <button type="button" class="col-tool" data-col-size="l" aria-pressed="false">
            <span data-i18n="col.p.sizeL">Large</span>
          </button>
        </div>
      </div>
      <div class="col-palette" data-col-palette role="listbox" aria-label="Colors"></div>
      <div class="col-actions">
        <button
          type="button"
          class="btn btn-sm col-iconbtn"
          data-col-undo
          data-i18n="col.p.undo"
          disabled
        >
          <img src="/coloring/icons/undo.png" alt="" width="18" height="18" /><span>Undo</span>
        </button>
        <button
          type="button"
          class="btn btn-sm col-iconbtn"
          data-col-redo
          data-i18n="col.p.redo"
          disabled
        >
          <img src="/coloring/icons/redo.png" alt="" width="18" height="18" /><span>Redo</span>
        </button>
        <button type="button" class="btn btn-sm" data-col-reset data-i18n="col.p.reset">
          Start over
        </button>
        <button type="button" class="btn btn-primary" data-col-publish data-i18n="col.p.pub">
          Publish
        </button>
      </div>
      <p class="col-autonote" data-i18n="col.p.autoNote">
        Your painting isn’t saved between visits — publish it to keep it.
      </p>
    </div>

    <p class="col-loadnote" data-col-loadnote data-i18n="col.p.loading">
      Loading the coloring canvas…
    </p>
  </div>

  <section class="prose band" style="margin-top: var(--sp-8);">
    <h2
      data-i18n={`col.tier${tier.tier}h`}
      data-i18n-args={tierArgs}
    >{tier.h}</h2>
    <p
      data-i18n={`col.tier${tier.tier}p`}
      data-i18n-args={tierArgs}
    >{tier.p}</p>
    <p data-i18n="col.p.printB">
      Want it on paper? The line art above is a real image — right-click or long-press to save it,
      print it, and color it with pencils.
    </p>
  </section>

  <nav class="col-neighbors" aria-label="More coloring pages">
    {
      prev && (
        <a href={`/coloring/${prev.slug}/`} class="btn btn-sm">
          ← <span data-i18n-piece={prev.slug}>{prev.title}</span>
        </a>
      )
    }
    <a href="/coloring/" class="btn btn-sm" data-i18n="col.gal.backPages">← All coloring pages</a>
    {
      next && (
        <a href={`/coloring/${next.slug}/`} class="btn btn-sm"><span data-i18n-piece={next.slug}>{next.title}</span> →</a>
      )
    }
  </nav>

  <section class="prose" style="margin-top: var(--sp-6);">
    <p>
      <a href="/coloring/gallery/" data-i18n="col.p.viewGal">View the coloring gallery</a>
      <span data-i18n="col.p.viewGalB"> — finished versions of these pages, ranked by likes.</span>
    </p>
  </section>
</BaseLayout>

<style>
  .crumb {
    margin-top: var(--sp-4);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .col-h1-note {
    font-size: 0.5em;
    color: var(--muted);
    font-weight: 500;
  }
  .col-app {
    margin-top: var(--sp-5);
    display: grid;
    gap: var(--sp-4);
  }
  .col-status {
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  .col-frame {
    position: relative;
    max-width: 46rem;
    line-height: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #fff;
  }
  .col-lineart,
  .col-canvas {
    width: 100%;
    height: auto;
    display: block;
  }
  .col-canvas {
    position: absolute;
    inset: 0;
    cursor: crosshair;
    /* freehand brush: a touch drag paints — scrolling is handled by the
       page around the canvas, never by dragging across the picture */
    touch-action: none;
  }
  .col-frame.is-live .col-lineart {
    display: none; /* visibility:hidden keeps layout space → blank gap above canvas */
  }
  .col-frame.is-live .col-canvas {
    position: static;
  }
  .col-toolbar {
    display: grid;
    gap: var(--sp-3);
    max-width: 46rem;
  }
  .col-hint,
  .col-autonote,
  .col-loadnote {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
  /* palette — full toolbar row of its own (was squeezed next to brush/eraser),
     auto-fill so dots stay ≥3.5rem even on narrow screens. Buttons are
     created at RUNTIME by coloringPaint.ts, so scoped selectors never match:
     must stay :global (runtime DOM carries no Astro scope id). */
  :global(.col-palette) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.5rem, 1fr));
    gap: 10px;
    max-width: 46rem;
  }
  :global(.col-swatch) {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid rgb(0 0 0 / 0.25);
    cursor: pointer;
    padding: 0;
    box-shadow: inset 0 -3px 5px rgb(0 0 0 / 0.18);
  }
  :global(.col-swatch[aria-checked='true']) {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  /* brush / eraser tool toggle — game icon assets, island flips is-active */
  .col-tools {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .col-toolgroup {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* runtime-toggled class → scoped selectors never match, must stay :global */
  :global(.col-tool) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--ink, inherit);
  }
  :global(.col-tool img) {
    display: block;
  }
  :global(.col-tool.is-active) {
    border-color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }
  /* undo / redo: text button with the game icon in front */
  :global(.col-iconbtn img) {
    display: inline-block;
    vertical-align: -0.18rem;
    margin-right: 0.3rem;
  }
  .col-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  /* publish dialog — same form the bead editor uses. Built at RUNTIME by
     coloringPaint.ts (no Astro scope id): every selector must stay :global,
     otherwise the dialog renders as a raw form dumped at the body end. */
  :global(.col-dialog) {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    background: rgb(20 16 30 / 0.55);
    padding: var(--sp-4);
  }
  :global(.col-dialog[hidden]) {
    display: none;
  }
  :global(.col-dialog-box) {
    background: var(--panel, #fff);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg, 0 18px 40px rgb(0 0 0 / 0.25));
    padding: var(--sp-5);
    max-width: 24rem;
    width: 100%;
    display: grid;
    gap: var(--sp-3);
  }
  :global(.col-dialog-box h2) {
    margin: 0;
    font-size: 1.15rem;
  }
  :global(.col-dialog-box .col-autonote) {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  :global(.col-dialog-box label) {
    display: grid;
    gap: 0.3rem;
    font-size: 0.9rem;
  }
  :global(.col-dialog-box input[type='text']) {
    width: 100%;
    font: inherit;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border, #ccc);
    border-radius: var(--radius-sm, 6px);
    background: var(--surface, #fff);
  }
  :global(.col-dialog-box input[type='text']:focus) {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-color: transparent;
  }
  :global(.col-dialog-box .col-actions) {
    display: flex;
    justify-content: flex-end;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .col-neighbors {
    margin-top: var(--sp-5);
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
</style>

<script>
  import '../../scripts/coloringPaint';
</script>
