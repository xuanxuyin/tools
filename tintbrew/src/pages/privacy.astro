---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const title = 'Privacy Policy';
const description = 'TintBrew privacy policy: no accounts, no cookies, no personal data collection.';
---

<BaseLayout title={`${title} | ${SITE.name}`} description={description} path="/privacy">
  <section class="hero">
    <h1>Privacy Policy</h1>
    <p class="lead">Short version: TintBrew works entirely in your browser and collects no personal data.</p>
  </section>

  <section class="prose">
    <h2>What we collect</h2>
    <p>
      Nothing that identifies you. TintBrew uses <strong>Cloudflare Web Analytics</strong>, a
      cookieless service that reports aggregate page views and referrers. It does not set cookies,
      does not build user profiles, and cannot identify individual visitors. Your mixes, converted
      colors and everything else you do on this site never leave your browser.
    </p>

    <h2>Cookies</h2>
    <p>
      TintBrew sets no cookies. If advertising is added in the future, this policy will be updated
      before any ad script goes live.
    </p>

    <h2>Third parties</h2>
    <p>
      Pages are hosted on Cloudflare. Standard server logs (IP address, user agent, request time)
      are processed by Cloudflare solely to deliver the site and protect against abuse, and are
      not used for profiling.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about this policy? Write to <a href="mailto:hello@tintbrew.com">hello@tintbrew.com</a>.
    </p>
    <p><em>Last updated: September 2026</em></p>
  </section>
</BaseLayout>
