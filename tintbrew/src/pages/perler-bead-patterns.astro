---
import BeadCategoryPage from '../components/BeadCategoryPage.astro';
import { BEAD_HUB_SEO } from '../data/beadSeo';
import { patternsByCategory } from '../lib/beadContent';

const groups = [
  {
    label: 'Animals',
    href: '/perler-bead-animals/',
    blurb: 'Cat, bunny, panda, fox, owl, penguin, dog, bear, frog, chick, dinosaur, unicorn.',
    patterns: patternsByCategory('animals'),
  },
  {
    label: 'Food',
    href: '/perler-bead-food/',
    blurb: 'Cupcake, donut, pizza slice, ice cream cone, strawberry, cookie, watermelon, ice pop, burger, sushi roll.',
    patterns: patternsByCategory('food'),
  },
  {
    label: 'Christmas',
    href: '/christmas-perler-bead-patterns/',
    blurb: 'Tree, snowman, stocking, wreath, gift, gingerbread man, Santa hat, bell, reindeer, hot cocoa.',
    patterns: patternsByCategory('christmas'),
  },
  {
    label: 'Halloween',
    blurb: 'Ghost, jack-o’-lantern, bat, skull, candy corn, spider — spooky-season sized for the same 16×16 board.',
    patterns: patternsByCategory('halloween'),
  },
  {
    label: 'Minis',
    blurb: 'Keychain-size projects under 12×12 beads — the true beginner tier, and the fastest gift in the set.',
    patterns: patternsByCategory('minis'),
  },
];
---

<BeadCategoryPage seo={BEAD_HUB_SEO} groups={groups} />
