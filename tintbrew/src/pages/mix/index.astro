---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolNav from '../../components/ToolNav.astro';
import MixCard from '../../components/MixCard.astro';
import { mixes } from '../../data/mixes';
import { buildMixContent } from '../../lib/mixContent';
import { SITE } from '../../consts';

const title = 'All Color Mixes — What Two Colors Make, With HEX Codes | TintBrew';
const description =
  'Every classic color combination answered with live values: what red and blue, blue and yellow, black and white and 21 more mixes make — HEX codes, ratio tables and a mixer for each.';

const items = mixes.map(buildMixContent);
// popular pairs get their own group at the top, everything else follows
const popular = items.filter((c) => c.def.popular);
const rest = items.filter((c) => !c.def.popular);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Color Mixes', item: `${SITE.url}/mix/` },
  ],
};
---

<BaseLayout title={title} description={description} path="/mix" jsonLd={jsonLd}>
  <section class="hero">
    <h1 data-i18n="mix.hubH">What do two colors make?</h1>
    <p class="lead" data-i18n="mix.hubLead">
      Every mix below opens with the answer already computed — the 50/50 blend, its HEX code, ratio
      tables from 75/25 to 25/75, tints, shades, and a live mixer preloaded with that pair.
    </p>
  </section>

  <ToolNav />

  <div class="mix-directory">
    {popular.length > 0 && <h2 class="mix-group-title" data-i18n="mix.popH">Popular mixes</h2>}
    {popular.map((c) => (
      <MixCard c={c} />
    ))}
    {rest.length > 0 && <h2 class="mix-group-title" data-i18n="mix.everyH">Every mix</h2>}
    {rest.map((c) => (
      <MixCard c={c} />
    ))}
  </div>

  <section class="prose" style="margin-top: var(--sp-8);">
    <h2 data-i18n="mix.hubWhyH">Why mixes differ between screens and paint</h2>
    <p>
      <span data-i18n="mix.hubWhyP1">Screens mix light: combining wavelengths</span><em data-i18n="mix.emAdds">adds</em><span data-i18n="mix.hubWhyP2">brightness, which is why red plus green light makes yellow. Paint mixes pigments: each pigment absorbs light, so combining them</span><em data-i18n="mix.emSubtracts">subtracts</em><span data-i18n="mix.hubWhyP3">brightness — red plus green paint makes brown. Every mix page here shows the perceptual blend and explains what changes between the two worlds.</span>
    </p>
    <p>
      <span data-i18n="mix.hubNeedA">Need a pair that isn't listed? Blend any colors yourself in the</span><a
        href="/color-mixer"
        data-i18n="mix.lMixerTool">color mixer</a><span data-i18n="mix.hubNeedB">, or look up a specific code in the</span><a
        href="/color-converter"
        data-i18n="mix.lConvTool">color converter</a><span data-i18n="mix.hubNeedC">.</span>
    </p>
  </section>
</BaseLayout>

<style>
  .mix-directory {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }

  .mix-group-title {
    grid-column: 1 / -1;
    margin: var(--sp-3) 0 0;
    font-size: 1.15rem;
  }

  .mix-group-title:first-child {
    margin-top: 0;
  }
</style>
