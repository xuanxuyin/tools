---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mixer from '../../components/Mixer.astro';
import MixTable from '../../components/MixTable.astro';
import TintsShades from '../../components/TintsShades.astro';
import RelatedMixes from '../../components/RelatedMixes.astro';
import { buildMixContent } from '../../lib/mixContent';
import { mixes } from '../../data/mixes';
import { ICONS } from '../../lib/icons';
import { SITE } from '../../consts';

export function getStaticPaths() {
  return mixes.map((def) => ({
    params: { slug: `${def.a}-${def.b}` },
    props: { def },
  }));
}

const { def } = Astro.props;
const c = buildMixContent(def);

// i18n argument packs shared by the tagged nodes below. Color ids flow
// through the color.* dictionary at swap time; {result} through MIX_RESULTS.
// The capitalized pack feeds nodes whose SSR text shows "Red" not "red"
// (hero equation, ratio heading, table aria) — fill() preserves the case.
const argsPair = JSON.stringify({ a: c.a.id, b: c.b.id });
const argsPairCap = JSON.stringify({ a: c.a.name, b: c.b.name });
const argsAns = JSON.stringify({
  a: c.a.id,
  b: c.b.id,
  hex: `${c.resultHex} (${c.nearestName})`,
  result: def.resultName,
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Color Mixes', item: `${SITE.url}/mix/` },
      { '@type': 'ListItem', position: 3, name: c.question, item: `${SITE.url}/mix/${c.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: c.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  path={`/mix/${c.slug}`}
  jsonLd={jsonLd}
  ogImage={`/og/mix-${c.slug}.png`}
>
  <section class="hero">
    <h1 data-i18n="mix.h1" data-i18n-args={argsPair}>{c.question[0]!.toUpperCase() + c.question.slice(1)}</h1>
    <p class="lead" data-i18n={`mix.ans${c.variant}`} data-i18n-args={argsAns}>{c.answer}</p>
    <div class="hero-answer" aria-label="The answer at a glance" data-i18n-aria="a11y.answer">
      <span class="hero-swatches" aria-hidden="true">
        <span style={`background:${c.a.hex}`}></span>
        <span class="hero-plus">+</span>
        <span style={`background:${c.b.hex}`}></span>
        <span class="hero-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={ICONS.arrowRight} /></svg>
        </span>
      </span>
      <span class="ha-result" aria-hidden="true">
        <span class="ha-chip" style={`background:${c.resultHex}`}></span>
        <code>{c.resultHex}</code>
      </span>
      <strong
        data-i18n="mix.heroEq"
        data-i18n-args={JSON.stringify({ a: c.a.name, b: c.b.name, result: def.resultName })}
      >{c.a.name} + {c.b.name} = {c.resultName}</strong>
    </div>
  </section>

  <Mixer initialColors={[c.first.hex, c.second.hex]} showModeToggle compact />

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="mix.ratioH" data-i18n-args={argsPairCap}>{c.first.name} to {c.second.name}: every ratio</h2>
    <p data-i18n="mix.ratioP">
      How much of each color you use moves the answer along the blend path. The perceptual midpoint
      is the 50/50 row; the others show what a 3:1 ratio does in either direction.
    </p>
    <MixTable rows={c.ratioRows} a={c.first} b={c.second} />

    <h2 data-i18n="mix.tintH">Lighter and darker versions</h2>
    <p data-i18n="mix.tintP">
      Tint the mix toward white or shade it toward black and you get a small palette that all
      clearly belongs to the same family:
    </p>
    <TintsShades steps={c.tintsShades} />
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="mix.mediumH">Paint vs. screen: why the medium matters</h2>
    {def.additiveNote ? (
      <p data-i18n={`mn.${def.a}-${def.b}`}>{def.additiveNote}</p>
    ) : (
      <p data-i18n="mix.mediumP">{c.faqs[2]!.a}</p>
    )}

    <h2 data-i18n="mix.aboutH">About these two colors</h2>
    <p>
      <strong style="text-transform: capitalize" data-i18n={`color.${c.a.id}`}>{c.a.name}</strong>
      <span class="mono-chip">{c.a.hex}</span><span data-i18n={`cblurb.${c.a.id}`}> — {c.a.blurb}</span>
    </p>
    <p>
      <strong style="text-transform: capitalize" data-i18n={`color.${c.b.id}`}>{c.b.name}</strong>
      <span class="mono-chip">{c.b.hex}</span><span data-i18n={`cblurb.${c.b.id}`}> — {c.b.blurb}</span>
    </p>
    {def.synonymNote && (
      <p data-i18n={`syn.${def.a}-${def.b}`}>{def.synonymNote}</p>
    )}
    <p>
      <span data-i18n="mix.mixerA">Want to blend these with different colors entirely? Open the</span><a
        href="/color-mixer"
        data-i18n="mix.lMixer">full color mixer</a><span data-i18n="mix.mixerB">, or</span><a
        href="/color-converter"
        data-i18n="mix.lConv"
        data-i18n-args={JSON.stringify({ hex: c.resultHex })}>convert {c.resultHex}</a><span data-i18n="mix.period">.</span>
    </p>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="mix.relH">Related mixes</h2>
    <RelatedMixes related={c.related.slice(0, 3)} />
    <p style="margin-top: var(--sp-3);">
      <span data-i18n="mix.seeAllA">See</span><a
        href="/mix"
        data-i18n="mix.lAllMixes">all color mixes</a><span data-i18n="mix.seeAllB"> for the full directory.</span>
    </p>
  </section>

  <section class="prose" style="margin-top: var(--sp-6);">
    <h2 data-i18n="pg.faqTitle">Frequently asked questions</h2>
    <div class="faq">
      {c.faqs.map((f, i) => (
        <details>
          <summary
            data-i18n={i === 0 ? 'mix.fq1' : i === 1 ? 'mix.fq2' : i === 2 ? 'mix.fq3' : i === 4 ? 'mix.fq5' : 'mix.fq4'}
            data-i18n-args={JSON.stringify({ a: c.a.id, b: c.b.id, short: c.shortResult })}
          >{f.q}</summary>
          <p
            data-i18n={i === 0
              ? 'mix.fa1'
              : i === 1
                ? 'mix.fa2'
                : i === 2
                  ? def.additiveNote
                    ? `mn.${def.a}-${def.b}`
                    : 'mix.mediumP'
                  : i === 3
                    ? 'mix.fa4'
                    : i === 4
                      ? 'mix.fa5'
                      : undefined}
            data-i18n-args={i === 0 || i === 4
              ? JSON.stringify({
                  a: c.a.id,
                  b: c.b.id,
                  result: def.resultName,
                  hex0: `${c.resultHex} (${c.nearestName})`,
                  hex75: `${c.ratioRows[0]!.hex} (${c.ratioRows[0]!.name})`,
                  hex25: `${c.ratioRows[2]!.hex} (${c.ratioRows[2]!.name})`,
                })
              : i === 1
                ? JSON.stringify({
                    a: c.a.id,
                    b: c.b.id,
                    hex: `${c.resultHex} (${c.nearestName})`,
                    snippet: c.snippet,
                  })
                : i === 3
                  ? JSON.stringify({
                      short: c.shortResult,
                      tint: c.tintsShades[1]!.hex,
                      shade: c.tintsShades[3]!.hex,
                    })
                  : undefined}
          >{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Answer banner (2026-11-10 template pass): inputs + arrow + the computed
     result as the biggest object in the row — the answer reads in one glance
     before the equation text. */
  .hero-answer {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent) 4%, transparent);
  }

  .hero-swatches {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-swatches > span:not(.hero-plus):not(.hero-arrow) {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    display: inline-block;
  }

  .hero-plus {
    width: auto !important;
    height: auto !important;
    border: 0 !important;
    background: none !important;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .hero-arrow {
    width: auto !important;
    height: auto !important;
    border: 0 !important;
    background: none !important;
    color: var(--accent);
    display: inline-flex;
    margin-left: 0.2rem;
  }

  /* the computed answer — oversized chip so the eye lands here first */
  .ha-result {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ha-chip {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgb(0 0 0 / 0.12);
    box-shadow: var(--shadow-sm);
    display: inline-block;
  }

  .hero-answer code {
    font-family: var(--mono);
    font-size: 1.02rem;
    font-weight: 600;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .mono-chip {
    font-family: var(--mono);
    font-size: 0.85em;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
</style>
