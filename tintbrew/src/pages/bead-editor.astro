---
/**
 * The bead editor — the free-draw counterpart to the photo converter (same
 * page pair as the source site, user call 2026-10-29). Size a board in
 * pegboards, draw with the 291-color Mardiy line, then print or export. The island
 * (scripts/beadEditor.ts) receives converted photos through a sessionStorage
 * handoff and autosaves local work; the SSR shell below carries the full
 * instructions and FAQ either way.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const title = 'Perler Bead Pattern Editor — Design Your Own From Scratch | TintBrew';
const description =
  'Free bead pattern editor: size a pegboard grid, draw with all 291 real Mardiy bead colors, mirror symmetric strokes, simplify shades, then print the chart or download a PNG. Autosaves in your browser.';

const faqs = [
  {
    qKey: 'ed.fq1',
    aKey: 'ed.fa1',
    q: 'What size board should I start with?',
    a: 'One large square pegboard holds 29 × 29 beads, so 29 × 29 is the natural first project — coasters, small sprites, keychains. 58 × 58 spans four boards and fits most character art; 87 × 87 and 116 × 116 are for big wall pieces. You can change the size any time the canvas is empty; once there are beads on it, the size locks so nothing gets cropped.',
  },
  {
    qKey: 'ed.fq2',
    aKey: 'ed.fa2',
    q: 'Can I start from a photo instead of a blank grid?',
    a: 'Yes — run your picture through the photo to bead pattern converter first, then hit Edit in editor under its preview. The whole converted board lands right here, ready to fix bead by bead. Going the other way works too: patterns you draw here print with the same bead list and pegboard seams.',
  },
  {
    qKey: 'ed.fq3',
    aKey: 'ed.fa3',
    q: 'Where does my pattern get saved?',
    a: 'In your browser only. The editor autosaves your board as you draw, so a refresh or an accidental tab close loses nothing — and nothing ever leaves your device. Clearing your browser data clears the draft, so print or download the PNG when a design is done.',
  },
  {
    qKey: 'ed.fq4',
    aKey: 'ed.fa4',
    q: 'How do I print the finished chart?',
    a: 'Hit Print pattern. The printed sheet carries the board at full color with pegboard seams every 29 beads, plus the bead list underneath — each color with its Mardiy code and count — so you can pull beads and place them straight off the paper.',
  },
  {
    qKey: 'ed.fq5',
    aKey: 'ed.fa5',
    q: 'What do the codes next to the colors mean?',
    a: 'Every one of the 291 colors carries a Mardiy catalog code — A1 through ZG8, the number you order beads by. The swatches, the bead list and the printed chart all use the same code, so H7 always means the same black bead everywhere from screen to pegboard.',
  },
  {
    qKey: 'ed.fq6',
    aKey: 'ed.fa6',
    q: 'My pattern has too many similar colors. Can I clean it up?',
    a: 'Hit Simplify colors. It merges the nearest shade pairs into one bead — the lighter shade wins — until the remaining colors are comfortably apart. It is one click and fully undoable, so you can compare the two versions and keep the better one.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'TintBrew Bead Pattern Editor',
    url: `${SITE.url}/bead-editor/`,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Perler Bead Patterns',
        item: `${SITE.url}/perler-bead-patterns/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Bead Pattern Editor',
        item: `${SITE.url}/bead-editor/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} path="/bead-editor" jsonLd={jsonLd}>
  <section class="hero">
    <h1 data-i18n="ed.h1">Design Your Own Perler Bead Patterns</h1>
    <p class="lead" data-i18n="ed.lead">
      A blank pegboard and all 291 real Mardiy bead colors, right in the browser. Size the board, draw
      bead by bead, mirror the halves for symmetric designs, then print the chart or download a
      PNG. Your work autosaves — and patterns from the photo converter land here with one click.
    </p>
  </section>

  <section class="tool-shell" data-bead-editor>
    <div class="ed-top no-print">
      <div class="ed-group">
        <label class="ed-label" for="ed-size" data-i18n="ed.boardSize">Board size</label>
        <select id="ed-size" data-ed-size>
          <option value="29x29" data-i18n="ed.o29">29 × 29 — 1 board</option>
          <option value="58x58" data-i18n="ed.o58">58 × 58 — 4 boards</option>
          <option value="87x58" data-i18n="ed.o8758">87 × 58 — 6 boards</option>
          <option value="58x87" data-i18n="ed.o5887">58 × 87 — 6 boards</option>
          <option value="87x87" data-i18n="ed.o87">87 × 87 — 9 boards</option>
          <option value="116x116" data-i18n="ed.o116">116 × 116 — 16 boards</option>
          <option value="custom" data-i18n="ed.oCustom">Custom…</option>
        </select>
        <span class="ed-custom hidden" data-ed-custom-row>
          <input type="number" inputmode="numeric" min="8" max="160" value="29" aria-label="Board width in beads" data-ed-w />
          <span>×</span>
          <input type="number" inputmode="numeric" min="8" max="160" value="29" aria-label="Board height in beads" data-ed-h />
          <button type="button" class="btn" data-ed-apply data-i18n="ed.apply">Apply</button>
        </span>
        <span class="ed-locked hidden" data-ed-locked role="note" data-i18n="ed.locked">
          Size locks once beads are on the board — Reset clears it.
        </span>
      </div>
      <div class="ed-group ed-zoom">
        <span class="ed-label" data-i18n="ed.zoom">Zoom</span>
        <button type="button" class="btn" data-ed-zoom-out aria-label="Zoom out" data-i18n-aria="ed.zoomOut">−</button>
        <span class="ed-zoom-value" data-ed-zoom-label>100%</span>
        <button type="button" class="btn" data-ed-zoom-in aria-label="Zoom in" data-i18n-aria="ed.zoomIn">+</button>
        <button type="button" class="btn" data-ed-fit data-i18n="ed.fit">Fit</button>
      </div>
    </div>
    <p class="ed-note hidden no-print" data-ed-note></p>

    <div class="ed-body">
      <div class="ed-canvas-col">
        <div class="ed-host" data-ed-canvas-host></div>
      </div>

      <div class="ed-controls no-print">
        <div class="ed-group">
          <span class="ed-label">Tools</span>
          <div class="tool-row" role="group" aria-label="Editor tools">
            <button type="button" class="btn tool-btn active" data-ed-tool="brush" aria-pressed="true" data-i18n="ed.brush">Brush</button>
            <button type="button" class="btn tool-btn" data-ed-tool="eraser" aria-pressed="false" data-i18n="ed.eraser">Eraser</button>
            <button type="button" class="btn tool-btn" data-ed-tool="pick" aria-pressed="false" data-i18n="ed.pick">Pick color</button>
            <button type="button" class="btn tool-btn" data-ed-undo data-i18n="ed.undo">Undo</button>
            <button type="button" class="btn tool-btn" data-ed-mirror aria-pressed="false" title="Every stroke lands on the mirrored cell too" data-i18n-title="ed.mirrorTip" data-i18n="ed.mirror">Mirror</button>
            <button type="button" class="btn tool-btn" data-ed-reset data-i18n="ed.reset">Reset</button>
          </div>
        </div>

        <div class="ed-group">
          <label class="ed-label" for="ed-search"><span data-i18n="ed.colors">Colors</span> <span class="ed-hint" data-i18n="ed.colorsHint">291 beads — search by code or hex</span></label>
          <div class="ed-active-row">
            <span class="ed-active" data-ed-active></span>
            <input type="search" id="ed-search" placeholder="Search colors…" data-i18n-placeholder="ed.searchPh" data-ed-search />
          </div>
          <div class="ed-library" data-ed-library role="group" aria-label="Bead colors"></div>
          <label class="cv-custom ed-custom-color">
            <span data-i18n="ed.customColor">custom color</span>
            <input type="color" value="#000000" data-ed-custom aria-label="Custom color, snapped to the nearest bead" />
            <span class="ed-hint" data-i18n="ed.snapHint">snapped to the nearest bead</span>
          </label>
        </div>

        <div class="ed-group">
          <button type="button" class="btn" data-ed-simplify data-i18n="ed.simplify">Simplify colors</button>
        </div>

        <div class="ed-group ed-actions">
          <button type="button" class="btn act-primary" data-ed-png data-i18n="ed.png">Download PNG</button>
          <button type="button" class="btn" data-ed-print data-i18n="ed.print">Print pattern</button>
        </div>
      </div>
    </div>

    <p class="ed-stats" data-ed-stats aria-live="polite">1 pegboard (1 × 1) · 0 beads · 0 colors</p>

    <div class="ed-listcard">
      <h2 data-i18n="ed.needH">Beads you'll need</h2>
      <ul class="ed-list" data-ed-list>
        <li class="cv-empty" data-i18n="ed.empty">Start drawing to build your project palette.</li>
      </ul>
    </div>
  </section>

  <section class="prose" style="margin-top: var(--sp-8);">
    <h2 data-i18n="pg.howTitle">How it works</h2>
    <ol>
      <li>
        <strong data-i18n="ed.s1H">Size the board.</strong>
        <span data-i18n="ed.s1B"> Pick a pegboard preset — 29 × 29 for a first project,
        bigger grids for full scenes — or enter a custom width and height. Seams in the preview
        mark where each physical pegboard ends.</span>
      </li>
      <li>
        <strong data-i18n="ed.s2H">Draw.</strong>
        <span data-i18n="ed.s2B"> Choose a color and click or drag; Mirror paints both halves at
        once, Pick color lifts a shade straight off the board, and Undo walks back mistakes.
        The bead list and board stats update as you go.</span>
      </li>
      <li>
        <strong data-i18n="ed.s3H">Clean up the palette.</strong>
        <span data-i18n="ed.s3B"> Simplify colors merges the nearest shade pairs
        until the palette is shopping-friendly — one click, one undo if you preferred the
        detailed version.</span>
      </li>
      <li>
        <strong data-i18n="ed.s4H">Print or export.</strong>
        <span data-i18n="ed.s4B"> Print pattern gives you the chart and the bead list on
        paper; Download PNG saves the board as an image for a phone or tablet.</span>
      </li>
    </ol>

    <h2 data-i18n="ed.whatH">What to design</h2>
    <ul>
      <li><strong data-i18n="ed.d1H">Pixels and sprites</strong><span data-i18n="ed.d1B"> — anything born on a grid lands on the pegboard almost 1:1</span></li>
      <li><strong data-i18n="ed.d2H">Letters and numbers</strong><span data-i18n="ed.d2B"> — names, monograms, classroom door signs</span></li>
      <li><strong data-i18n="ed.d3H">Coasters and keychains</strong><span data-i18n="ed.d3B"> — 29 × 29 is exactly one board's worth</span></li>
      <li><strong data-i18n="ed.d4H">Seasonal pieces</strong><span data-i18n="ed.d4B"> — hearts for February, eggs and spring themes, snowflakes in winter</span></li>
      <li><strong data-i18n="ed.d5H">Big wall art</strong><span data-i18n="ed.d5B"> — 87 × 87 and up, drawn one pegboard at a time along the seams</span></li>
    </ul>

    <h2 data-i18n="ed.blankH">Blank grid or photo converter?</h2>
    <p>
      <span data-i18n="ed.blankA">Draw here when the design lives in your head or on paper. Already have an image? The</span>{' '}
      <a href="/photo-to-perler-bead-pattern/" data-i18n="ed.lPhoto">photo to bead pattern converter</a>{' '}
      <span data-i18n="ed.blankB">turns it into a board automatically — then its</span>{' '}
      <em data-i18n="ed.lEditIn">Edit in editor</em>{' '}
      <span data-i18n="ed.blankC">button hands the result to this page for touch-ups. Or skip both and start from a</span>{' '}
      <a href="/perler-bead-patterns/" data-i18n="ed.lReady">ready-made pattern</a>
      <span data-i18n="ed.blankD">, where every board opens recolorable in the 103-color Perler line.</span>
    </p>

    <h2 data-i18n="ed.printH">Printing your bead chart</h2>
    <p data-i18n="ed.printP">
      Hit Print pattern when the board is done. The printed sheet carries the full grid in color
      with pegboard seams every 29 beads, and beneath it the bead list — code and count
      for every color — so placement and shopping both happen off one page.
    </p>

    <h2 data-i18n="pg.faqTitle">Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary data-i18n={f.qKey}>{f.q}</summary>
          <p data-i18n={f.aKey}>{f.a}</p>
        </details>
      ))}
    </div>

    <p class="keep-reading">
      <span data-i18n="ed.keepA">Looking for something to make first? Browse the</span>{' '}
      <a href="/perler-bead-patterns/" data-i18n="pg.keepLink">full perler bead pattern set</a>{' '}
      <span data-i18n="ed.keepB">— 116 free boards at every size, each printable with the same bead list.</span>
    </p>
  </section>
</BaseLayout>

<script>
  import '../scripts/beadEditor';
</script>

<style>
  .tool-shell {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: var(--sp-5);
    background: var(--bg, #fff);
  }
  .ed-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-2);
  }
  .ed-group { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .ed-label {
    font-size: 0.85rem;
    font-weight: 700;
    margin-right: 2px;
  }
  .ed-hint { font-weight: 400; font-size: 0.78rem; color: var(--ink-soft, #666); }
  .ed-top select {
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font: inherit;
    background: var(--bg, #fff);
  }
  .ed-custom input {
    width: 72px;
    padding: 6px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font: inherit;
  }
  .ed-locked {
    font-size: 0.8rem;
    color: #b45309;
  }
  .ed-zoom { margin-left: auto; }
  .ed-zoom-value {
    min-width: 44px;
    text-align: center;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft, #666);
  }
  .ed-note {
    margin: 0 0 var(--sp-2);
    padding: 8px 14px;
    border-radius: 10px;
    background: #fffaf0;
    font-size: 0.85rem;
  }
  .ed-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--sp-4);
    align-items: start;
  }
  @media (max-width: 960px) {
    .ed-body { grid-template-columns: 1fr; }
  }
  .ed-canvas-col { min-width: 0; }
  .ed-host {
    overflow: auto; /* zoomed-in boards scroll inside the card */
    max-height: 72vh;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #f4efe8;
  }
  .ed-controls { display: grid; gap: var(--sp-3); align-content: start; }
  @media (min-width: 961px) {
    .ed-controls { position: sticky; top: 12px; }
  }
  .tool-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .tool-btn.active {
    border-color: var(--accent, #b3552e);
    box-shadow: inset 0 0 0 1px var(--accent, #b3552e);
  }
  .ed-active-row { display: flex; align-items: center; gap: 10px; margin: 6px 0; }
  .ed-active {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.18);
    background: #000;
  }
  .ed-active-row input {
    flex: 1;
    min-width: 0;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font: inherit;
  }
  .ed-custom-color {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--ink-soft, #666);
    margin-top: var(--sp-2);
  }
  .ed-custom-color input {
    width: 34px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: none;
    cursor: pointer;
  }
  .ed-actions .act-primary {
    border-color: var(--accent, #b3552e);
    box-shadow: inset 0 0 0 1px var(--accent, #b3552e);
    font-weight: 600;
  }
  .ed-stats {
    margin: var(--sp-3) 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft, #666);
    font-variant-numeric: tabular-nums;
  }
  .ed-listcard h2 { font-size: 1.15rem; margin-bottom: var(--sp-2); }
  .ed-listcard { margin-top: var(--sp-3); }
  .hidden { display: none !important; }
</style>

<style is:global>
  /* Runtime pieces (the board svg, the library swatches, the list items) are
     created by scripts/beadEditor.ts outside the scoped tree — same globals
     pattern as the pattern pages and the photo converter. */
  .ed-host .ed-board {
    display: block;
    height: auto;
    touch-action: none;
    user-select: none;
    cursor: crosshair;
  }
  .ed-host .pv-cell {
    stroke: rgba(0, 0, 0, 0.08);
    stroke-width: 0.6;
    cursor: crosshair;
  }
  .ed-host .pv-peg {
    fill: #ffffff;
    stroke: rgba(0, 0, 0, 0.1);
    stroke-width: 0.5;
    cursor: crosshair;
  }
  .ed-host .pv-seam {
    stroke: rgba(0, 0, 0, 0.32);
    stroke-width: 0.8;
    pointer-events: none;
  }
  .ed-host .pv-border {
    fill: none;
    stroke: rgba(0, 0, 0, 0.18);
    stroke-width: 1;
    pointer-events: none;
  }
  .ed-library {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    max-height: 260px;
    overflow: auto;
  }
  [data-bead-editor] .cv-swatch {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.18);
    cursor: pointer;
    padding: 0;
  }
  [data-bead-editor] .cv-swatch.active {
    outline: 2px solid var(--accent, #b3552e);
    outline-offset: 1px;
  }
  [data-bead-editor] .cv-empty {
    font-size: 0.85rem;
    color: var(--ink-soft, #666);
    font-style: italic;
  }
  [data-bead-editor] .ed-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  [data-bead-editor] .ed-list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg, #fff);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  [data-bead-editor] .cv-item-swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    flex: none;
  }

  @media print {
    .site-header,
    .site-footer,
    .no-print,
    .ed-top,
    .ed-controls,
    .keep-reading,
    .hero,
    .prose {
      display: none !important;
    }
    .tool-shell { border: none; padding: 0; }
    .ed-host {
      overflow: visible;
      max-height: none;
      border: none;
    }
    .ed-body { display: block; }
    .ed-host .ed-board { width: 100% !important; }
    .ed-stats,
    .ed-listcard li {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
