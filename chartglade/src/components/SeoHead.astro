---
import { SITE, CONTENT_UPDATED } from '../consts';

interface Props {
  /** Full <title> content (page-level caller composes brand suffix) */
  title: string;
  /** Meta description, ≤155 chars */
  description: string;
  /** Canonical path only, e.g. '/place-value-chart' — never a query string */
  path: string;
  /** JSON-LD object(s) to emit in <head> */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** true only for 404 */
  noindex?: boolean;
  /** Site-rooted path of the share image; defaults to the brand OG card */
  ogImage?: string;
}

const { title, description, path, jsonLd, noindex = false, ogImage = '/og-default.png' } = Astro.props;

// trailing slash matches Cloudflare Pages URL normalization (clean URL 308s to slashed)
// strip any trailing slashes first — a page passing path="/foo/" must never mint /foo// (tintbrew 10/04 同款 bug 的防御)
const cleanPath = path.replace(/\/+$/, '');
const canonical = path === '/' ? `${SITE.url}/` : `${SITE.url}${cleanPath}/`;
const ogImageAbs = ogImage ? new URL(ogImage, SITE.url).href : undefined;
const jsonLdItems: Record<string, unknown>[] = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION ?? SITE.gscVerification;
const pinterest = import.meta.env.PUBLIC_PINTEREST_VERIFICATION ?? SITE.pinterestVerification;

// freshness signal (2026-10-04): stamp dateModified on every entity except
// BreadcrumbList, where the property would be meaningless
const datedItems = jsonLdItems.map((item) =>
  item['@type'] === 'BreadcrumbList' ? item : { ...item, dateModified: CONTENT_UPDATED },
);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="max-image-preview:large" />
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImageAbs && <meta property="og:image" content={ogImageAbs} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageAbs && <meta name="twitter:image" content={ogImageAbs} />}

{gsc && <meta name="google-site-verification" content={gsc} />}
{pinterest && <meta name="p:domain_verify" content={pinterest} />}
{datedItems.map((obj) => <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />)}
