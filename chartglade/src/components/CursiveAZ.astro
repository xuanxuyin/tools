---
/**
 * A-to-Z strip shared by the cursive letter pages — the navigation block the
 * letter matrix was missing (2026-10-04 incumbent teardown: letter pages
 * linked to other topics but never to each other; K5's letter pages interlink
 * into a mesh, ours were an orphan-per-letter star around the hub).
 */
import { cursiveLetters } from '../data/cursiveLetters';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<section class="section no-print az-strip" aria-label="Every cursive letter">
  <h2 class="az-title">Every cursive letter, A to Z</h2>
  <nav class="az-links" aria-label="Cursive letter pages">
    {
      cursiveLetters.map((def) => (
        <a
          href={`/cursive/${def.slug}/`}
          aria-current={def.slug === current ? 'page' : undefined}
          class={def.slug === current ? 'az-link is-current' : 'az-link'}
        >
          {def.slug.toUpperCase()}
        </a>
      ))
    }
  </nav>
</section>

<style>
  .az-strip {
    border-top: 1px solid #e3e8ee;
    padding-top: 1.25rem;
  }
  .az-title {
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }
  .az-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .az-link {
    min-width: 2.2rem;
    padding: 0.3rem 0.5rem;
    text-align: center;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    background: #fff;
  }
  .az-link:hover {
    border-color: #2f7d4f;
  }
  .az-link.is-current {
    background: #2f7d4f;
    border-color: #2f7d4f;
    color: #fff;
  }
</style>
