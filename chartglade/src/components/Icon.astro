---
/**
 * Shared inline icons (feather-style 24 grid, stroke 2, round caps/joins).
 * Buttons embed these so every toolbar action reads at a glance; color
 * follows `currentColor` so .btn hover recolors the icon with the label.
 * Keep the set tiny — add a path only when a second page needs it.
 */
const { name, size = 15 } = Astro.props;
const paths: Record<string, string> = {
  print:
    '<path d="M6 9V3h12v6"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="7"></rect>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line>',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
