---
import { SITE } from '../consts';

const nav = [
  { href: '/charts', label: 'Math Charts' },
  { href: '/sight-words', label: 'Sight Words' },
  { href: '/cursive', label: 'Cursive' },
];

const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#2f7d4f"></rect>
        <g fill="#ffffff" opacity="0.92">
          <rect x="14" y="34" width="8" height="16" rx="2"></rect>
          <rect x="28" y="24" width="8" height="26" rx="2"></rect>
          <rect x="42" y="14" width="8" height="36" rx="2"></rect>
        </g>
      </svg>
      <span>ChartGlade</span>
    </a>
    <nav aria-label="Main navigation">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current === normalize(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
