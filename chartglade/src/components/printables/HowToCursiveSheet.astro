---
/**
 * The six-step cursive lesson sheet. Pure SSR — every stroke, family strip,
 * join, word and sentence row renders in HTML so the sheet is complete and
 * printable with JavaScript off (SSR-shell rule). Prints as two letter pages:
 * steps 1-3 (posture, strokes, lowercase families), then steps 4-6 (joins,
 * words, sentences) behind a .sheet-break.
 */
import { HOW_TO_STEPS, type HowToDrill, type StrokeKey } from '../../data/howToCursive';

/** The four stroke shapes, drawn as traceable gray paths (viewBox 0 0 44 44). */
const STROKE_PATHS: Record<StrokeKey, string> = {
  undercurve: 'M3 12 C7 33, 21 40, 34 27',
  overcurve: 'M4 37 C4 10, 36 8, 40 31',
  downcurve: 'M13 5 C14 17, 16 28, 19 41',
  slant: 'M10 5 L28 41',
};

const TRACE_MODELS = 4;
const STROKE_BLANKS = 2;
const JOIN_REPS = 2;
const WORD_TRACE = 2;
const WORD_BLANK = 3;
---

<div class="ht-sheet">
  <p class="sheet-title">How to Write in Cursive — a six-step practice sheet</p>
  <p class="ht-name">Name: ______________________ &nbsp;&nbsp; Date: ____________</p>

  {HOW_TO_STEPS.map((step, i) => (
    <section class:list={['ht-step', { 'sheet-break': i === 3 }]} aria-label={step.title}>
      <h3>{step.title}</h3>
      <ul class="ht-points">
        {step.points.map((p) => <li>{p}</li>)}
      </ul>

      {(step.drills ?? []).map((drill) => {
        const d: HowToDrill = drill;
        return (
          <div class="ht-drill">
            <p class="ht-drill-label">
              {d.label}
              <span class="ht-hint">{d.hint}</span>
            </p>

            {d.kind === 'strokes' && (
              <div class="ht-stroke-strip" aria-hidden="true">
                {[...Array(TRACE_MODELS)].map(() => (
                  <div class="ht-stroke-cell">
                    <svg viewBox="0 0 44 44"><path d={STROKE_PATHS[d.stroke]}></path></svg>
                    <div class="baseline"></div>
                  </div>
                ))}
                {[...Array(STROKE_BLANKS)].map(() => (
                  <div class="ht-stroke-cell">
                    <div class="baseline"></div>
                  </div>
                ))}
              </div>
            )}

            {d.kind === 'letters' && (
              <div class="trace-strip">
                {[...d.letters].map((l) => (
                  <div class="trace-cell">
                    <div class="glyph">{l}</div>
                    <div class="baseline"></div>
                  </div>
                ))}
              </div>
            )}

            {d.kind === 'joins' && (
              <div class="trace-strip">
                {[...Array(JOIN_REPS)].flatMap(() =>
                  d.joins.map((j) => (
                    <div class="trace-cell">
                      <div class="glyph">{j}</div>
                      <div class="baseline"></div>
                    </div>
                  )),
                )}
              </div>
            )}

            {d.kind === 'words' && (
              <div class="ht-words">
                {d.words.map((w) => (
                  <div class="ht-words-row">
                    <span class="ht-words-label">{w}</span>
                    <div class="ht-words-cells">
                      {[...Array(WORD_TRACE)].map(() => (
                        <span class="ht-word-cell">
                          <span class:list={['ht-word-model', { 'ht-word-model-sm': w.length > 4 }]}>{w}</span>
                          <span class="ht-word-baseline"></span>
                        </span>
                      ))}
                      {[...Array(WORD_BLANK)].map(() => (
                        <span class="ht-word-cell">
                          <span class="ht-word-baseline"></span>
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {d.kind === 'sentence' && (
              <div>
                <div class="sent-row trace">
                  <span class="glyph">{d.text}</span>
                </div>
                <div class="sent-row blank" aria-hidden="true"></div>
              </div>
            )}
          </div>
        );
      })}
    </section>
  ))}
</div>
