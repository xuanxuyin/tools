---
import type { LetterSheet } from '../../data/cursiveLetters';
import type { LetterConnections } from '../../data/cursiveConnections';

interface Props {
  sheet: LetterSheet;
  /** Join-teaching data for the connect + words rows (2026-11-12 batch).
   *  Optional so older call sites keep working without it. */
  connections?: LetterConnections;
}

const { sheet, connections } = Astro.props;
---

<div class="letter-sheet">
  <p class="sheet-name">Name: ____________________ &nbsp;&nbsp; Date: ____________</p>

  <div class="big-glyphs" aria-hidden="true">
    <span class="big-cap">{sheet.capital}</span>
    <span class="big-low">{sheet.lower}</span>
  </div>

  <div class="stroke-steps">
    <div>
      <h3>Cursive capital {sheet.capital}</h3>
      <ol>
        {sheet.capitalSteps.map((s) => <li>{s}</li>)}
      </ol>
    </div>
    <div>
      <h3>Lowercase {sheet.lower} in cursive</h3>
      <ol>
        {sheet.lowerSteps.map((s) => <li>{s}</li>)}
      </ol>
    </div>
  </div>

  <p class="pitfall"><strong>Watch for:</strong> {sheet.pitfall}</p>

  <h3 class="trace-heading">Trace and write — {sheet.lower}{sheet.lower}{sheet.lower}{sheet.lower}{sheet.lower}</h3>
  <div class="trace-strip">
    {[...Array(6)].map(() => (
      <div class="trace-cell">
        <div class="glyph">{sheet.lower}</div>
        <div class="midline"></div>
        <div class="baseline"></div>
      </div>
    ))}
  </div>
  <h3 class="trace-heading">Cursive capital {sheet.capital} trace — {sheet.capital}{sheet.capital}{sheet.capital}</h3>
  <div class="trace-strip">
    {[...Array(6)].map(() => (
      <div class="trace-cell">
        <div class="glyph">{sheet.capital}</div>
        <div class="midline"></div>
        <div class="baseline"></div>
      </div>
    ))}
  </div>
  <h3 class="trace-heading">Write on your own</h3>
  <div class="trace-strip">
    {[...Array(6)].map(() => (
      <div class="trace-cell">
        <div class="glyph"></div>
        <div class="midline"></div>
        <div class="baseline"></div>
      </div>
    ))}
  </div>

  {
    connections && (
      <>
        <h3 class="trace-heading">Connect it</h3>
        <div class="trace-strip">
          {connections.drills.map((d) => (
            <div class="trace-cell">
              <div class="glyph glyph-sm">{d}</div>
              <div class="midline"></div>
              <div class="baseline"></div>
            </div>
          ))}
        </div>
        <h3 class="trace-heading">{connections.wordsLabel ?? 'First words'}</h3>
        <div class="words-model">
          {connections.words.map((w) => (
            <span class="word-model">{w}</span>
          ))}
        </div>
      </>
    )
  }
</div>
