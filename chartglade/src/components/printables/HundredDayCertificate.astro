---
/**
 * 100th Day certificate (hundred-day cluster): a landscape "100 Days Smarter"
 * award in the classroom design language the incumbents share (SERP recon
 * 11-16: heyletsmakestuff / kindergartenworks / superstar all use rainbow
 * lettering + star confetti, none use corporate navy/gold seals) — thin dark
 * frame on white, rainbow star confetti around the edges, "100 DAYS" in
 * per-letter rainbow + "SMARTER" spaced black caps, name line, our counted-
 * built-puzzled-read body, rainbow CONGRATULATIONS, Date/Teacher rows.
 * One certificate per landscape letter page; print-color-adjust keeps the
 * rainbow through the print pipeline.
 */
const rainbow = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#3b82f6', '#ec4899'];
const days = '100 DAYS'.split('');
const congrats = 'CONGRATULATIONS'.split('');
// deterministic confetti: [x%, y%, size px, color index] — hand-spread through
// the four margin bands around the frame (the frame's own margin is the stage;
// z-order keeps them above nothing — they live in the white, never on it)
const confetti: [number, number, number, number][] = [
  // top band (~7% of sheet height)
  [7, 1, 18, 0], [15, 2.8, 22, 2], [24, 1.2, 15, 4], [33, 3, 20, 1],
  [42, 1, 17, 5], [51, 2.6, 21, 3], [60, 1.3, 15, 0], [69, 3, 23, 2],
  [78, 1, 18, 4], [87, 2.8, 16, 1], [93, 1.2, 20, 5],
  // bottom band
  [7, 94.6, 17, 3], [16, 94, 21, 1], [26, 95.2, 15, 5], [36, 94.2, 19, 0],
  [46, 95, 22, 2], [56, 94, 16, 4], [66, 94.8, 20, 1], [76, 94, 17, 3],
  [86, 95, 23, 0], [93, 94.2, 15, 2],
  // left band
  [1, 12, 19, 4], [1.8, 30, 15, 0], [0.9, 48, 21, 2], [1.9, 66, 16, 5], [1.1, 84, 18, 1],
  // right band
  [96.9, 14, 16, 1], [97.6, 32, 20, 3], [96.8, 50, 15, 5], [97.5, 68, 22, 0], [97, 86, 17, 2],
];
---
<div class="cert-sheet">
  {
    confetti.map(([x, y, s, c], i) => (
      <svg
        class="cert-confetti"
        style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;color:${rainbow[c]}`}
        viewBox="0 0 100 100"
        aria-hidden="true"
      >
        <path d="M50 5 L61 38 L95 38 L67 58 L77 92 L50 71 L23 92 L33 58 L5 38 L39 38 Z" />
      </svg>
    ))
  }

  <div class="cert-border">
    <p class="cert-kicker">Certificate of Achievement</p>

    <p class="cert-days" aria-label="100 days">
      {days.map((ch, i) =>
        ch === ' ' ? (
          <span class="cert-space" />
        ) : (
          <span style={`color:${rainbow[i % rainbow.length]}`}>{ch}</span>
        ),
      )}
    </p>
    <p class="cert-smarter">
      <svg class="cert-spark" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 5 L61 38 L95 38 L67 58 L77 92 L50 71 L23 92 L33 58 L5 38 L39 38 Z" /></svg>
      SMARTER
      <svg class="cert-spark" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 5 L61 38 L95 38 L67 58 L77 92 L50 71 L23 92 L33 58 L5 38 L39 38 Z" /></svg>
    </p>

    <div class="cert-row cert-row-name">
      <span class="cert-row-label">This certifies that</span>
      <span class="cert-name-line" aria-hidden="true"></span>
    </div>

    <p class="cert-body">
      has counted, built, puzzled and read their way to the
      <strong>100th day of school</strong>.
    </p>

    <p class="cert-congrats" aria-label="Congratulations">
      {congrats.map((ch, i) => (
        <span style={`color:${rainbow[i % rainbow.length]}`}>{ch}</span>
      ))}
    </p>

    <div class="cert-signatures">
      <span class="cert-sig">Date<span class="cert-sig-line" aria-hidden="true"></span></span>
      <span class="cert-sig">Teacher<span class="cert-sig-line" aria-hidden="true"></span></span>
    </div>
  </div>
</div>

<style>
  .cert-sheet {
    position: relative;
    /* the confetti stage: padding (not child margins — those collapse through
       and would let the frame swallow the star bands) */
    padding: 0.44in 0.4in 0.4in;
    text-align: center;
    background: #fff;
  }
  .cert-confetti {
    position: absolute;
    transform: rotate(0deg);
  }
  .cert-confetti path {
    fill: currentColor;
  }
  .cert-confetti:nth-child(odd) {
    transform: rotate(18deg);
  }
  .cert-border {
    position: relative;
    z-index: 1;
    border: 3.5px solid #1c1c1c;
    border-radius: 4px;
    padding: 0.9rem 1.6rem 0.8rem;
    min-height: 4.9in;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #fff;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .cert-kicker {
    font-size: 0.95rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #1c1c1c;
    margin: 0 0 0.45rem;
  }
  .cert-days {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: 0.02em;
    margin: 0;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .cert-days span {
    display: inline-block;
  }
  .cert-space {
    width: 0.35em;
  }
  .cert-smarter {
    font-size: 1.28rem;
    font-weight: 700;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    color: #1c1c1c;
    margin: 0.1rem 0 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }
  .cert-spark {
    width: 0.24in;
    height: 0.24in;
    color: #eab308;
    flex: none;
  }
  .cert-spark path {
    fill: currentColor;
  }
  .cert-row-name {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 0.5rem;
    max-width: 6.6in;
    width: 100%;
    margin: 0 auto 0.3rem;
    text-align: left;
  }
  .cert-row-label {
    font-size: 1.02rem;
    white-space: nowrap;
    padding-bottom: 0.08rem;
  }
  .cert-name-line {
    border-bottom: 3px solid #1c1c1c;
    height: 1.35rem;
    display: block;
  }
  .cert-body {
    font-size: 1.02rem;
    max-width: 6.4in;
    margin: 0 0 0.45rem;
  }
  .cert-congrats {
    font-size: 1.55rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    margin: 0 0 0.65rem;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .cert-congrats span {
    display: inline-block;
  }
  .cert-signatures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.2rem;
    max-width: 6.6in;
    width: 100%;
    margin: 0 auto;
    text-align: left;
  }
  .cert-sig {
    font-size: 0.95rem;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: 0.45rem;
  }
  .cert-sig-line {
    border-bottom: 2.5px solid #1c1c1c;
    height: 1.1rem;
    display: block;
  }
</style>
