---
import { fractionDenominators } from '../../lib/mathCharts';

interface Props {
  /** largest denominator row (strip starts at 1 whole) */
  max?: number;
  title?: string;
}

const { max = 12, title } = Astro.props;
const dens = fractionDenominators(max);

// Spoken forms for screen readers — no "one-5ths" coinages (audit 2026-10-29)
const ORDINALS: Record<number, string> = {
  2: 'halves', 3: 'thirds', 4: 'fourths', 5: 'fifths', 6: 'sixths',
  7: 'sevenths', 8: 'eighths', 9: 'ninths', 10: 'tenths', 11: 'elevenths', 12: 'twelfths',
};
---

{title && <p class="sheet-title">{title}</p>}
<div class="fraction-rows">
  <div class="fraction-row">
    <span class="frac-label">1</span>
    <div class="fraction-bar" role="img" aria-label="One whole bar">
      <span class="filled"></span>
    </div>
  </div>
  {dens.map((d) => (
    <div class="fraction-row">
      <span class="frac-label">1/{d}</span>
      <div
        class="fraction-bar"
        role="img"
        aria-label={`One whole bar divided into ${d} equal parts, showing ${d} ${ORDINALS[d] ?? `${d}ths`}`}
      >
        {Array.from({ length: d }, () => <span></span>)}
      </div>
    </div>
  ))}
</div>
