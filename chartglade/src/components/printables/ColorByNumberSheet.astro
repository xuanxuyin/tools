---
/**
 * Color-by-number worksheet sheet, rendered through lib/paintArt.ts (the
 * tintbrew-style data-matrix -> SVG pipeline, user call 2026-10-29). Each
 * edition prints: header, color legend, the worksheet SVG (white rounded
 * cells, facts only — no color leaks the answer), and a name/date line.
 * The finished-picture reference renders right under the legend but is
 * no-print: on screen it shows what the math reveals; on paper the student
 * still has to earn it.
 */
import { PUMPKIN_ADDITION, GHOST_MULTIPLICATION, type PaintArt } from '../../data/halloween';
import { buildFactGrid, worksheetSvg, referenceSvg } from '../../lib/paintArt';

export interface EditionSpec {
  title: string;
  audience: string;
  art: PaintArt;
  mode: 'add' | 'mul';
  factLabel: string;
}

interface Props {
  /** Seasonal overrides; defaults keep the Halloween page's exact output. */
  editions?: EditionSpec[];
}

const HALLOWEEN_EDITIONS: EditionSpec[] = [
  {
    title: 'Jack-o’-lantern — Color by Addition',
    audience: 'Grades 1–2 · add, then match the sum to a color',
    art: PUMPKIN_ADDITION,
    mode: 'add',
    factLabel: 'sum',
  },
  {
    title: 'Friendly Ghost — Color by Multiplication',
    audience: 'Grades 3–4 · multiply, then match the product to a color',
    art: GHOST_MULTIPLICATION,
    mode: 'mul',
    factLabel: 'product',
  },
];

const { editions = HALLOWEEN_EDITIONS } = Astro.props;

const sheets = editions.map((spec) => {
  const { art, mode } = spec;
  const used = new Set(art.cells.flat().filter((k) => k !== 0));
  const keys = Object.keys(art.legend)
    .map(Number)
    .filter((k) => used.has(k))
    .sort((a, b) => a - b);
  const factGrid = buildFactGrid(art, mode);
  const op = mode === 'mul' ? '×' : '+';
  return {
    ...spec,
    keys,
    op,
    worksheet: worksheetSvg(art, factGrid, op),
    reference: referenceSvg(art),
  };
});
---

<div class="cbn-sheets">
  {sheets.map(({ title, audience, art, keys, factLabel, op, worksheet, reference }, i) => (
    <section class:list={['cbn-sheet', { 'sheet-break': i > 0 }]} aria-label={title}>
      <header class="cbn-head">
        <h2>{title}</h2>
        <p>{audience}</p>
      </header>
      <div class="cbn-legend">
        {keys.map((key) => (
          <span class="cbn-key">
            <span class="cbn-swatch" style={`background:${art.palette[key]}`}></span>
            {factLabel} <strong>{key}</strong> = {art.legend[key]}
          </span>
        ))}
      </div>
      <figure class="cbn-ref no-print">
        <figcaption>Finished picture — solve the {factLabel}s to reveal it</figcaption>
        <div class="cbn-ref-art" set:html={reference} />
      </figure>
      <div class="cbn-board" set:html={worksheet} />
      <p class="cbn-name">Name: ______________________ &nbsp;&nbsp; Date: ____________</p>
    </section>
  ))}
</div>

<style is:global>
  /* is:global on purpose: a scoped block would inject data-astro-cid attrs
     into the legend markup and break the dist guards' regexes, and the
     set:html SVGs sit outside the scoped cascade anyway. Only the wrappers
     are styled here — the SVGs carry their own presentation attributes. */
  .cbn-board {
    max-width: 640px;
    margin: 0 auto;
  }
  .cbn-ref {
    margin: 0 auto 10px;
    max-width: 320px;
  }
  .cbn-ref figcaption {
    font-size: 0.8rem;
    font-style: italic;
    color: #667;
    text-align: center;
    margin-bottom: 4px;
  }
  @media print {
    .cbn-ref { display: none; } /* belt and braces under the global .no-print */
  }
</style>
