---
interface Props {
  title?: string;
}

const { title } = Astro.props;

// Key words use each letter's most common sound: short vowels (apple, egg,
// igloo, octopus, umbrella), no blends — and x anchors on its end-of-word /ks/.
const LETTERS = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];
const WORDS = [
  'apple', 'ball', 'cat', 'dog', 'elephant', 'fish', 'goat', 'hat', 'igloo',
  'jet', 'kite', 'lion', 'moon', 'nest', 'octopus', 'pig', 'quilt', 'rain',
  'sun', 'tree', 'umbrella', 'van', 'wagon', 'fox', 'yak', 'zebra',
];
---

{title && <p class="sheet-title">{title}</p>}
<div class="letter-grid">
  {LETTERS.map((c, i) => (
    <div class="letter-cell plain">
      <div class="glyph"><span class="cap">{c}</span><span class="low">{c.toLowerCase()}</span></div>
      <div class="word">{WORDS[i]}</div>
    </div>
  ))}
</div>
