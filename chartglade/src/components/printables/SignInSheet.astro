---
/**
 * One component for every sign-in sheet flavor (V1.8): fill-in header
 * fields (teacher / date / room), then a blank row-per-visitor table with
 * cells tall enough for adult handwriting. Layout config and copy live in
 * data/signInSheets.ts; this file only renders.
 */
interface Props {
  title: string;
  metaFields: string[];
  columns: string[];
  rows: number;
  dense?: boolean;
  /**
   * Dotted-model starter sentence (Thanksgiving worksheet): rendered between
   * the header fields and the table — a gray hand-font model plus one blank
   * copy line. Sign-in sheets pass nothing and see no change.
   */
  starter?: string;
}

const { title, metaFields, columns, rows, dense = false, starter } = Astro.props;
---

<p class="sheet-title">{title}</p>
<div class="signin-meta">
  {metaFields.map((f) => (
    <span class="signin-meta-field">{f}<span class="write-line" aria-hidden="true"></span></span>
  ))}
</div>
{starter && (
  <div class="signin-starter">
    <span class="signin-starter-label">Trace your starter, then write your own below</span>
    <p class="signin-starter-model">{starter}</p>
    <p class="signin-starter-copy" aria-hidden="true"></p>
  </div>
)}
<table class:list={['chart-table', 'signin', { dense }]}>
  <thead>
    <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
  </thead>
  <tbody>
    {Array.from({ length: rows }).map(() => (
      <tr>{columns.map(() => <td class="fill-in"></td>)}</tr>
    ))}
  </tbody>
</table>
