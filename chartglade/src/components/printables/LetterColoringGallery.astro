---
import { letterDrawings } from '../../lib/drawings';
import type { ArtEl, ColoringDrawing } from '../../lib/drawings';
import type { ColoringLetterSheet } from '../../data/coloringLetters';

interface Props {
  sheet: ColoringLetterSheet;
}

const { sheet } = Astro.props;
const drawings = letterDrawings(sheet);

/**
 * Object art is either a vendored OpenMoji outline (img) or a hand-drawn
 * SVG fallback; composed here as HTML strings (Astro frontmatter can't
 * return JSX).
 */
const artHtml = (el: ArtEl, cls: string): string =>
  el.kind === 'img'
    ? `<img class="${cls}" src="${el.src}" alt="${el.alt}" loading="lazy" width="72" height="72" />`
    : `<span class="lc-draw ${cls}">${el.svg}</span>`;

const artBodyHtml = (d: ColoringDrawing): string => {
  switch (d.layout) {
    case 'object':
      return artHtml(d.els[0], 'lc-main');
    case 'combo':
      return `<span class="lc-bubble" aria-hidden="true">${d.letter}</span>${artHtml(d.els[0], 'lc-side')}`;
    case 'ring':
      return (
        `<span class="lc-bubble lc-ring-letter" aria-hidden="true">${d.letter}</span>` +
        d.els.map((el, i) => artHtml(el, `lc-mini lc-m${i + 1}`)).join('')
      );
    case 'poster':
      return `<span class="lc-poster">${d.svg ?? ''}</span>`;
  }
};
---

<div class="lc-gallery">
  <h3 class="lc-gallery-heading">
    Six things to color for letter {sheet.capital} — color the picture, then color the big letter.
  </h3>
  <div class="lc-cards">
    {drawings.map((d) => (
      <figure class="lc-card">
        <div class:list={['lc-art', `lc-${d.layout}`]} set:html={artBodyHtml(d)} />
        <figcaption class="lc-caption">{d.caption}</figcaption>
      </figure>
    ))}
  </div>
  <p class="lc-gallery-footer">
    Print one page or the whole set — the pictures print on this page, the letter practice sheet prints on the next.
  </p>
</div>

<style>
  .lc-gallery {
    padding: 0.2rem 0.3rem;
    font-family: var(--font-sans);
  }
  .lc-gallery-heading {
    margin: 0 0 0.4rem;
    font-size: 13pt;
    font-weight: 700;
    color: var(--green-deep);
    text-align: center;
  }
  .lc-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }
  .lc-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    align-items: center;
  }
  .lc-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1.5pt solid var(--green);
    border-radius: 8px;
    overflow: hidden;
    background: var(--green-tint);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lc-art :global(img) {
    height: auto;
  }
  .lc-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .lc-art :global(.lc-draw) {
    display: block;
  }
  /* object card: the picture, big */
  .lc-art :global(.lc-main) {
    width: 74%;
  }
  /* combo card: bubble letter beside its picture */
  .lc-combo {
    gap: 6%;
    padding: 4%;
  }
  .lc-art :global(.lc-side) {
    width: 52%;
  }
  .lc-bubble {
    font-family: 'Arial Black', Arial, sans-serif;
    font-weight: 900;
    font-size: 3.4rem;
    line-height: 1;
    color: #fff;
    -webkit-text-stroke: 2.2pt #1c1c1c;
  }
  /* ring card: big letter centered, three small pictures around it */
  .lc-ring-letter {
    font-size: 3.2rem;
  }
  .lc-art :global(.lc-mini) {
    position: absolute;
    width: 30%;
  }
  .lc-art :global(.lc-m1) { top: 3%; left: 4%; }
  .lc-art :global(.lc-m2) { top: 3%; right: 4%; }
  .lc-art :global(.lc-m3) { bottom: 3%; left: 35%; }
  .lc-caption {
    font-size: 8.5pt;
    line-height: 1.3;
    text-align: center;
    color: var(--ink-soft);
    margin: 0;
    /* two-line box so every gallery page renders the same total height
       (the sheetImage width/height fields declare one fixed size) */
    min-height: 2.6em;
  }
  .lc-gallery-footer {
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 9pt;
    color: var(--ink-soft);
  }
  @media (max-width: 560px) {
    .lc-bubble { font-size: 1.7rem; }
    .lc-ring-letter { font-size: 1.5rem; }
  }
  @media print {
    .lc-cards { gap: 0.3rem; }
    .lc-art { border-color: #999; border-width: 1pt; background: #fff; }
    .lc-gallery-heading { color: #1c1c1c; }
    .lc-caption, .lc-gallery-footer { color: #555; }
  }
</style>
