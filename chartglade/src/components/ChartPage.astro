---
/**
 * The one template every printable page renders through (tintbrew's
 * ScenarioPage equivalent). Data lives in src/data/*.ts; the printable itself
 * arrives as the default slot from the thin page wrapper.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { SITE } from '../consts';
import type { PageDef } from '../data/pageTypes';

interface Props {
  def: PageDef;
}

const { def } = Astro.props;
const pagePath = def.path ?? `/${def.slug}`;

const HUBS: Record<PageDef['hub'], { href: string; label: string }> = {
  charts: { href: '/charts/', label: 'Math Charts' },
  'sight-words': { href: '/sight-words/', label: 'Sight Words' },
  cursive: { href: '/cursive/', label: 'Cursive & Handwriting' },
  'graph-paper': { href: '/graph-paper/', label: 'Graph Paper' },
  halloween: { href: '/halloween/', label: 'Halloween' },
  thanksgiving: { href: '/thanksgiving-printables/', label: 'Thanksgiving' },
  christmas: { href: '/christmas-printables/', label: 'Christmas' },
  'sign-in-sheets': { href: '/sign-in-sheets/', label: 'Sign-In Sheets' },
  cootie: { href: '/cootie-catcher/', label: 'Cootie Catchers' },
  coloring: { href: '/coloring/', label: 'Coloring Pages' },
};
const hub = HUBS[def.hub];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: hub.label, item: `${SITE.url}${hub.href}` },
      { '@type': 'ListItem', position: 3, name: def.h1, item: `${SITE.url}${pagePath}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: def.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

if (def.interactive) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: def.h1,
    url: `${SITE.url}${pagePath}/`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  });
}

if (def.howTo) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: def.howTo.name,
    step: def.howTo.steps.map((s) => ({
      '@type': 'HowToStep',
      name: s.name,
      text: s.text,
    })),
  });
}
---

<BaseLayout title={def.metaTitle} description={def.metaDescription} path={pagePath} jsonLd={jsonLd} ogImage={def.sheetImage?.src}>
  <nav class="breadcrumb no-print" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <a href={hub.href}>{hub.label}</a> <span aria-hidden="true">›</span>
    <span aria-current="page">{def.h1}</span>
  </nav>

  <section class="hero">
    <h1>{def.h1}</h1>
    <p class="lead">{def.lead}</p>
    <button type="button" class="btn btn-primary" data-print>
      <Icon name="print" />
      Print this chart
    </button>
  </section>

  <section class="printable-wrap" data-fact-scope>
    <div class="printable-toolbar">
      <span class="print-note">{def.printNote}</span>
      <button type="button" class="btn btn-primary" data-print><Icon name="print" />Print</button>
      {def.sheetImage && (
        <a class="btn btn-amber" href={def.sheetImage.src} download><Icon name="download" />Download PNG</a>
      )}
    </div>
    <div class:list={['printable', { landscape: def.landscape }]}>
      <slot />
    </div>
  </section>

  {def.sheetImage && (
    <details class="sheet-preview no-print">
      <summary>
        <Icon name="download" size={14} />
        PNG version — the exact file Download PNG saves
      </summary>
      <figure>
        <img
          src={def.sheetImage.src}
          alt={def.sheetImage.alt}
          width={def.sheetImage.width}
          height={def.sheetImage.height}
          loading="lazy"
        />
        {def.sheetImage.caption && <figcaption>{def.sheetImage.caption}</figcaption>}
      </figure>
    </details>
  )}

  <section class="prose">
    <h2>{def.introHeading}</h2>
    {def.intro.map((p) => <p>{p}</p>)}
  </section>

  {def.extraSection && (
    <section class="prose">
      <h2>{def.extraSection.heading}</h2>
      {def.extraSection.paras.map((p) => <p>{p}</p>)}
    </section>
  )}

  <section class="section tips">
    <h2>Teaching tips</h2>
    <div class="tip-grid">
      {def.tips.map((t) => (
        <div class="tip">
          <h3>{t.title}</h3>
          <p>{t.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section faq">
    <h2>Frequently asked questions</h2>
    {def.faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <slot name="after" />
  <section class="section related no-print">
    <h2>Related printables</h2>
    <ul class="related-list">
      {def.related.map((r) => (
        <li><a href={r.href}>{r.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
