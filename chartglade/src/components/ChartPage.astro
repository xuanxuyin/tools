---
/**
 * The one template every printable page renders through (tintbrew's
 * ScenarioPage equivalent). Data lives in src/data/*.ts; the printable itself
 * arrives as the default slot from the thin page wrapper.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import type { PageDef } from '../data/pageTypes';

interface Props {
  def: PageDef;
}

const { def } = Astro.props;

const HUBS: Record<PageDef['hub'], { href: string; label: string }> = {
  charts: { href: '/charts/', label: 'Math Charts' },
  'sight-words': { href: '/sight-words/', label: 'Sight Words' },
  cursive: { href: '/cursive/', label: 'Cursive' },
};
const hub = HUBS[def.hub];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: hub.label, item: `${SITE.url}${hub.href}` },
      { '@type': 'ListItem', position: 3, name: def.h1, item: `${SITE.url}/${def.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: def.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

if (def.interactive) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: def.h1,
    url: `${SITE.url}/${def.slug}/`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  });
}
---

<BaseLayout title={def.metaTitle} description={def.metaDescription} path={`/${def.slug}`} jsonLd={jsonLd}>
  <nav class="breadcrumb no-print" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <a href={hub.href}>{hub.label}</a> <span aria-hidden="true">›</span>
    <span aria-current="page">{def.h1}</span>
  </nav>

  <section class="hero">
    <h1>{def.h1}</h1>
    <p class="lead">{def.lead}</p>
    <button type="button" class="btn btn-primary" data-print>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9V3h12v6"></path>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
        <rect x="6" y="14" width="12" height="7"></rect>
      </svg>
      Print this chart
    </button>
  </section>

  <section class="printable-wrap" data-fact-scope>
    <div class="printable-toolbar">
      <span class="print-note">{def.printNote}</span>
      <button type="button" class="btn" data-print>Print</button>
    </div>
    <div class:list={['printable', { landscape: def.landscape }]}>
      <slot />
    </div>
  </section>

  <section class="prose">
    <h2>{def.introHeading}</h2>
    {def.intro.map((p) => <p>{p}</p>)}
  </section>

  <section class="section tips">
    <h2>Teaching tips</h2>
    <div class="tip-grid">
      {def.tips.map((t) => (
        <div class="tip">
          <h3>{t.title}</h3>
          <p>{t.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section faq">
    <h2>Frequently asked questions</h2>
    {def.faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="section related no-print">
    <h2>Related printables</h2>
    <ul class="related-list">
      {def.related.map((r) => (
        <li><a href={r.href}>{r.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
