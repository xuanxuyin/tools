---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const hubs = [
  {
    href: '/charts/',
    title: 'Math Charts',
    body: 'Place value, multiplication, fractions, hundred chart, number lines, addition — every K-8 wall and desk chart, printable on letter paper.',
    img: '/images/hundred-chart-printable.png',
    imgAlt: 'A printable hundred chart with numbers 1 to 100 in a ten-by-ten grid.',
    chip: '10+ charts',
  },
  {
    href: '/sight-words/',
    title: 'Sight Words',
    body: 'All 220 Dolch words by grade, preschool through third, as printable word cards with teaching notes for each level.',
    img: '/images/kindergarten-sight-words-printable.png',
    imgAlt: 'A printable kindergarten sight word list with 52 Dolch words in a grid.',
    chip: '220 Dolch words',
  },
  {
    href: '/cursive/',
    title: 'Cursive',
    body: 'The full cursive alphabet chart with a tracing strip, and how the letters are actually taught — stroke families, not A-to-Z.',
    img: '/images/cursive-alphabet-chart-printable.png',
    imgAlt: 'A printable cursive alphabet chart showing all 26 letters with a tracing strip.',
    chip: '26 letter pages',
  },
  {
    href: '/coloring/',
    title: 'Coloring Pages',
    body: 'Letter coloring pages for every letter A-Z — six pictures to color plus a bubble-letter practice sheet with a trace row and a draw-your-own box.',
    img: '/images/letter-b-coloring-page.png',
    imgAlt: 'A printable letter B coloring page with six pictures to color, including a ball, bear and boat.',
    chip: 'A through Z',
  },
];

const popular = [
  { href: '/place-value-chart/', label: 'Place value chart' },
  { href: '/multiplication-chart/', label: 'Multiplication chart 1-12' },
  { href: '/kindergarten-sight-words/', label: 'Kindergarten sight words' },
  { href: '/cursive-alphabet/', label: 'Cursive alphabet' },
  { href: '/alphabet-chart/', label: 'Alphabet chart' },
  { href: '/hundred-chart/', label: 'Hundred chart' },
  { href: '/fraction-chart/', label: 'Fraction chart' },
  { href: '/number-line-printable/', label: 'Number line 0-20' },
];

// Pages that make other worksheets — the interactive layer, surfaced on the
// homepage as of the 2026-11-12 engagement batch (they used to be reachable
// only through their topic hubs or the footer).
const generators = [
  { href: '/name-tracing/', label: 'Name tracing generator', body: 'Type any name — trace rows, hollow letters, a wipe-away strip. Print-ready, any name up to 12 letters.' },
  { href: '/graph-paper/', label: 'Graph paper maker', body: 'Square, dot and isometric grids in 7 sizes — pick the style and color, print true-size on letter paper.' },
  { href: '/multiplication-chart/', label: 'Mad minute & math quiz', body: 'Generate timed drill sheets with answer keys in any operation, or run the 10-topic quiz that saves progress on this device.' },
];

// Whole families that live only in the footer — one row so a first-time
// visitor can see the full shelf without scrolling the footer.
const library = [
  { href: '/times-table/', label: 'Times tables 1-12 — one printable page each' },
  { href: '/sign-in-sheets/', label: 'Sign-in sheets for every classroom event' },
  { href: '/cootie-catcher/', label: 'Cootie catchers & fortune tellers' },
  { href: '/teaching-calendar/', label: 'The teaching year at a glance' },
  { href: '/states-that-require-cursive/', label: 'State cursive requirements, all 50 states' },
  { href: '/halloween/', label: 'Halloween printables' },
  { href: '/thanksgiving-printables/', label: 'Thanksgiving printables' },
];

// Seasonal slot — swap this block per season (current: winter holidays; next: 100th Day, late Jan).
const seasonal = {
  heading: 'Christmas printables for December',
  body: 'Word searches, color-by-number math facts, a letter-to-Santa writing page, and a foldable Christmas cootie catcher — print-and-go, free, no sign-up.',
  links: [
    { href: '/christmas-stocking-coloring-page/', label: 'Christmas stocking coloring pages' },
    { href: '/christmas-word-search/', label: 'Christmas word search (2 levels)' },
    { href: '/christmas-color-by-number/', label: 'Color by number math facts' },
    { href: '/letter-to-santa/', label: 'Letter to Santa writing paper' },
    { href: '/christmas-cootie-catcher/', label: 'Christmas cootie catcher' },
  ],
  hub: { href: '/christmas-printables/', label: 'See all Christmas printables' },
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: `${SITE.url}/`,
  },
];
---

<BaseLayout
  title="Free Printable Math, Sight Words, Cursive & Coloring Pages | ChartGlade"
  description="Free printable charts for teachers and parents: place value, multiplication, fractions, sight words by grade, the cursive alphabet, and letter coloring pages. No sign-up — print and go."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <h1>Free printable charts for teaching</h1>
    <p class="lead">
      ChartGlade is a small library of classroom charts that print straight from your browser onto letter paper:
      math references for K-8, the complete Dolch sight word lists, and the cursive alphabet. No accounts, no
      paywalls — hit print and hang it up, or grab the PNG.
    </p>
    <a class="btn btn-primary" href="/charts/">Browse the charts</a>
  </section>

  <section class="section">
    <div class="card-grid">
      {hubs.map((h) => (
        <a class="card hub-card" href={h.href}>
          <span class="hub-thumb">
            <img src={h.img} alt={h.imgAlt} width="400" height="300" loading="eager" />
          </span>
          <span class="hub-chip">{h.chip}</span>
          <h2>{h.title}</h2>
          <p>{h.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section seasonal-band">
    <div class="seasonal-split">
      <div>
        <h2>{seasonal.heading}</h2>
        <p class="lead">{seasonal.body}</p>
        <ul class="related-list">
          {seasonal.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
        <p class="related-list">
          <a href={seasonal.hub.href}>{seasonal.hub.label}</a>
        </p>
      </div>
      <a class="seasonal-thumb" href="/christmas-stocking-coloring-page/">
        <img
          src="/images/christmas-stocking-coloring-page.png"
          alt="A printable Christmas stocking coloring page with a large stocking and two small patchwork stockings."
          width="400"
          height="504"
          loading="lazy"
        />
      </a>
    </div>
  </section>

  <section class="section">
    <h2>Most printed</h2>
    <ul class="related-list">
      {popular.map((p) => (
        <li><a href={p.href}>{p.label}</a></li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>Pages that make worksheets for you</h2>
    <ul class="related-list">
      {generators.map((g) => (
        <li><a href={g.href}>{g.label}</a> — {g.body}</li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2>The whole library</h2>
    <ul class="related-list">
      {library.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </section>

  <section class="prose section">
    <h2>Why another printables site?</h2>
    <p>
      Most printable charts online come wrapped in sign-up walls, watermarks, or PDF downloads that print at the
      wrong size. These pages are the chart: the sheet you see is the sheet that prints, on one letter page,
      black lines on white, with a print button that strips everything else off the page.
    </p>
    <p>
      Every chart ships with the teaching notes that make it work — the order facts are memorized in, the routine
      that turns a hundred chart into a year of warm-ups, why fraction strips beat circles. A chart without a
      routine is decoration; the notes are half the product.
    </p>
    <p>
      Start with <a href="/charts/">the math charts</a>, run the <a href="/name-tracing/">name tracing
      generator</a>, or work through <a href="/cursive/">the cursive alphabet, letter by letter</a> — every page
      prints the same way, and nothing needs an account.
    </p>
  </section>
</BaseLayout>
