---
import ChartPage from '../components/ChartPage.astro';
import PlaceValueChart from '../components/printables/PlaceValueChart.astro';
import { placeValuePages } from '../data/placeValue';

const def = placeValuePages.find((p) => p.slug === 'place-value-chart')!;
---

<ChartPage def={def}>
  <PlaceValueChart whole={7} example="4302175" title="Place Value Chart — 4,302,175" interactive />
</ChartPage>
