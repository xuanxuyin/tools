---
import ChartPage from '../components/ChartPage.astro';
import GraphPaperSheet from '../components/printables/GraphPaperSheet.astro';
import { graphPaperPages } from '../data/graphPaper';

const def = graphPaperPages.find((p) => p.slug === '5mm-graph-paper')!;
---

<ChartPage def={def}>
  <GraphPaperSheet def={def} />
</ChartPage>
