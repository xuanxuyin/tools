---
/**
 * Graph paper hub — cards for every grid size plus the customizer island.
 * The customizer is the "graph paper generator / maker" play (710/mo
 * combined, judged 2026-09-06): interactive tool-type intent that AI answers
 * cannot replace. SSR renders a complete default sheet (1/4" blue) so the
 * page prints correctly with JavaScript off.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { graphPaperPages } from '../../data/graphPaper';
import { GRAPH_PAPER_VARIANTS, GRID_COLORS, renderGraphSvg } from '../../lib/graphPaper';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Graph Paper', item: `${SITE.url}/graph-paper/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Graph Paper Maker',
    url: `${SITE.url}/graph-paper/`,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const defaultSvg = renderGraphSvg('quarter-inch', 'blue');
---

<BaseLayout
  title="Graph Paper — Every Size, Free Printable + Custom Maker | ChartGlade"
  description="Free printable graph paper in every size — 1/4 inch, half inch, 1 cm, 5mm, dot grid and isometric — plus a custom maker that prints your grid at true size. No download, no sign-up."
  path="/graph-paper"
  jsonLd={jsonLd}
>
  <nav class="breadcrumb no-print" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <span aria-current="page">Graph Paper</span>
  </nav>

  <section class="hero">
    <h1>Graph Paper</h1>
    <p class="lead">
      Every grid a classroom needs, drawn at true physical size and printed straight from the
      browser — no PDF download, no sign-up. Pick a size below, or use the maker to choose your
      own grid style and color.
    </p>
  </section>

  <section class="section">
    <div class="card-grid">
      {graphPaperPages.map((p) => (
        <a class="card" href={`/${p.slug}/`}>
          <h2>{p.h1}</h2>
          <p>{GRAPH_PAPER_VARIANTS[p.variant].blurb}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="printable-wrap" id="maker">
    <div class="printable-toolbar">
      <span class="print-note">Custom sheet prints on one letter page at true size — pick grid, spacing and color.</span>
      <button type="button" class="btn" data-print>Print</button>
    </div>
    <div class="printable">
      <div class="gp-controls no-print">
        <label>
          Grid
          <select id="gp-style">
            <option value="squares" selected>Squares</option>
            <option value="dots">Dots</option>
            <option value="iso">Isometric</option>
          </select>
        </label>
        <label>
          Spacing
          <select id="gp-size">
            <option value="quarter-inch" selected>1/4 inch</option>
            <option value="half-inch">1/2 inch</option>
            <option value="one-cm">1 cm</option>
            <option value="five-mm">5 mm</option>
          </select>
        </label>
        <label>
          Color
          <select id="gp-color">
            {Object.entries(GRID_COLORS).map(([id, c]) => (
              <option value={id} selected={id === 'blue'}>{c.label}</option>
            ))}
          </select>
        </label>
      </div>
      <div id="gp-preview" set:html={defaultSvg} />
    </div>
  </section>

  <section class="prose section">
    <h2>Which grid size do you need?</h2>
    <p>
      For math homework and coordinate planes, the standard is 1/4 inch graph paper — four
      squares per inch with a darker line every inch, the grid textbooks assume. Kindergarten
      through third grade runs better on half-inch paper, where one square holds a block letter
      or a colored box without fine-motor strain. Metric work splits two ways: 1 cm paper for
      measurement and science units (it matches the unit cubes), 5mm paper for labs and anything
      dense.
    </p>
    <p>
      Two specialist grids round out the set. Dot grid paper keeps the alignment of a grid
      without the cage — sketching, coordinate mystery pictures, structured notes. Isometric
      paper carries three line families at exact 60° so cubes and 3D structures draw themselves
      along the printed lines. All six print on plain letter paper at 100% scale; the maker
      above lets you re-style any of them and print immediately.
    </p>
  </section>
</BaseLayout>

<script>
  import { renderGraphSvg, type GraphPaperVariantId } from '../../lib/graphPaper';

  const style = document.getElementById('gp-style') as HTMLSelectElement;
  const size = document.getElementById('gp-size') as HTMLSelectElement;
  const color = document.getElementById('gp-color') as HTMLSelectElement;
  const preview = document.getElementById('gp-preview') as HTMLElement;

  function variantFor(): GraphPaperVariantId {
    if (style.value === 'dots') return 'dots';
    if (style.value === 'iso') return 'iso';
    return size.value as GraphPaperVariantId;
  }

  function update(): void {
    size.disabled = style.value !== 'squares';
    preview.innerHTML = renderGraphSvg(variantFor(), color.value);
  }

  [style, size, color].forEach((el) => el.addEventListener('change', update));
</script>
