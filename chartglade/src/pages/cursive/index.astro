---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { cursivePages } from '../../data/cursive';
import { cursiveLetters } from '../../data/cursiveLetters';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Cursive', item: `${SITE.url}/cursive/` },
    ],
  },
];
---

<BaseLayout
  title="Cursive (Free Printable Alphabet Chart) | ChartGlade"
  description="Free printable cursive resources: the full cursive alphabet chart with a tracing strip, plus how cursive is taught — stroke families, slant, and today's state requirements."
  path="/cursive"
  jsonLd={jsonLd}
>
  <nav class="breadcrumb no-print" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <span aria-current="page">Cursive</span>
  </nav>

  <section class="hero">
    <h1>Cursive</h1>
    <p class="lead">
      Cursive is having a second act: a wave of state legislation has put it back on the report card, and parents
      are the ones fielding the homework. ChartGlade's cursive section keeps it simple — one clean chart, one
      tracing strip, and the teaching notes that make practice actually work.
    </p>
  </section>

  <section class="section">
    <div class="card-grid">
      {cursivePages.map((p) => (
        <a class="card" href={`/${p.slug}/`}>
          <h2>{p.h1}</h2>
          <p>Uppercase and lowercase A-Z in one continuous script, with a light-gray tracing strip and the stroke families letters are taught in.</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Every letter, its own page</h2>
    <p>
      One page per letter — capital and lowercase stroke by stroke, the #1 mistake to watch for, and a
      trace-and-write practice sheet that prints on one letter page:
    </p>
    <div class="letter-grid letter-grid-plain">
      {cursiveLetters.map((l) => (
        <a class="letter-link" href={`/cursive/${l.slug}/`}>
          <span class="letter-link-glyph">{l.sheet.capital}{l.sheet.lower}</span>
          <span class="letter-link-name">Cursive {l.sheet.capital}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="prose section">
    <h2>What you need to know before printing</h2>
    <p>
      Third grade is the most common year for formal cursive instruction, after print handwriting is secure.
      Lowercase comes before capitals, and letters are taught in stroke families — the curve letters (c, a, d, g,
      q), the straight lines (i, t, u, w), the loops (l, h, b, k, f), the hills (n, m, v, x, y, z) — because one
      learned motion carries five letters.
    </p>
    <p>
      Schools teach different styles (Zaner-Bloser and D'Nealian are the two common American ones). The chart here
      is a clean, continuous script in the general tradition; if your school specifies a style, match it for
      homework and use this chart for practice.
    </p>
  </section>
</BaseLayout>
