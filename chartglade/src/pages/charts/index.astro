---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { placeValuePages } from '../../data/placeValue';
import { multiplicationPages } from '../../data/multiplication';
import { loosePages } from '../../data/loose';

const charts = [...placeValuePages, ...multiplicationPages, ...loosePages];

const blurbs: Record<string, string> = {
  'place-value-chart': 'Ones to millions with the comma periods marked — click any digit to see what it is worth.',
  'decimal-place-value-chart': 'Hundred thousands down to thousandths, decimal point anchored, money examples included.',
  'place-value-anchor-chart': 'The classroom-wall version: place names, periods, and one worked example with value callouts.',
  'place-value-chart-printable': 'A filled reference plus a blank write-in chart — prints as two clean letter pages.',
  'multiplication-chart': 'The classic 1-12 grid with the perfect-square diagonal shaded and click-to-check facts.',
  'multiplication-chart-blank': 'The same 1-12 grid with the products removed — retrieval practice and self-grading quizzes.',
  'multiplication-chart-1-15': 'The extended grid with the 13s-15s columns real problems actually use. Prints landscape.',
  'multiplication-chart-1-20': 'All 400 facts on one landscape page — the middle-school reference chart.',
  'fraction-chart': 'Same-length fraction strips from one whole to twelfths; equivalences line up by themselves.',
  'hundred-chart': 'The 1-100 grid that runs K-2: skip-count coloring, ten-more boxes, missing-number puzzles.',
  'number-line-printable': 'A big 0-20 line for the hop method, one per landscape page.',
  'addition-chart': 'Every fact from 0+0 to 12+12 with the doubles diagonal marked.',
  'alphabet-chart': 'A-Z letter pairs with short-vowel-safe key words, built for the three-beat phonics chant.',
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Math Charts', item: `${SITE.url}/charts/` },
    ],
  },
];
---

<BaseLayout
  title="Math Charts (Free Printables for K-8) | ChartGlade"
  description="Every free printable math chart on ChartGlade: place value, multiplication, fractions, hundred chart, number lines and more — no sign-up, print and go."
  path="/charts"
  jsonLd={jsonLd}
>
  <nav class="breadcrumb no-print" aria-label="Breadcrumb">
    <a href="/">Home</a> <span aria-hidden="true">›</span>
    <span aria-current="page">Math Charts</span>
  </nav>

  <section class="hero">
    <h1>Math Charts</h1>
    <p class="lead">
      Every chart prints on plain letter paper from your browser — no download, no sign-up, no watermark worth
      mentioning. Click a chart to print it or read how teachers actually use it.
    </p>
  </section>

  <section class="section">
    <div class="card-grid">
      {charts.map((p) => (
        <a class="card" href={`/${p.slug}/`}>
          <h2>{p.h1}</h2>
          <p>{blurbs[p.slug]}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="prose section">
    <h2>How the charts are organized</h2>
    <p>
      Place value charts come first because everything else in elementary math stands on them: reading big numbers,
      regrouping, decimals. The multiplication charts cover the fact fluency years (grade 3 through 5), from the
      standard 1-12 grid to the 1-20 reference for middle school. The rest — fractions, hundred chart, number line,
      addition, alphabet — are the single-sheet workhorses that each own one job.
    </p>
    <p>
      Every page pairs the printable itself with notes on how the chart is actually used in classrooms, because a
      chart without a routine is decoration. Print what you need; the notes are free too.
    </p>
  </section>
</BaseLayout>
