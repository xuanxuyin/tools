---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { dailyDraw } from '../../lib/engine';
import { renderReading } from '../../lib/reading';

// SSR 渲染构建日的签；访客当天日期不同则客户端重算（静态托管会冻结构建日期）。
// 上线版走日期化 URL（/daily-fortune/2026-11-07/），见 PLAYBOOK。
const today = new Date().toISOString().slice(0, 10);
const { sign, digits } = dailyDraw(today);
const pretty = new Date(today + 'T12:00:00').toLocaleDateString('zh-CN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang="zh"
  title={`今日运势 — ${pretty} | Fortune Willow（内部审阅版）`}
  description="每天零点抽取的今日签：一篇签文，附感情、财运、事业判词与三个幸运数字。同一天，同一支签；零点一过，另结新缘。"
>
  <section class="tool-shell card">
    <div class="tool-stage">
      <div class="kicker">一日一签 · 零点换新</div>
      <h1>今日运势</h1>
      <p class="date-line" data-date-title>{pretty}</p>
      <p class="tool-sub">
        一日一签，零点抽取，当天来访的人共承同一支——庙里「当日签」的老规矩。
        明日再来，另结新缘。
      </p>
    </div>
    <div class="tool-outcome" data-outcome data-build-day={today} set:html={renderReading(sign, digits, { lang: 'zh', luckyLabel: '今日幸运数字', note: '这是今天的签——零点换新。若正中你心，不妨截图留存。' })}></div>
  </section>

  <section class="section">
    <div class="kicker">归档</div>
    <h2>往日的签</h2>
    <div class="scene-list">
      {Array.from({ length: 7 }, (_, i) => {
        const d = new Date();
        d.setDate(d.getDate() - (i + 1));
        return d.toLocaleDateString('en-CA');
      }).map((date) => (
        <a class="scene" href={`/zh/daily-fortune/${date}/`}>
          <span class="glyph"><img src="/img/icons/sun.png" width="24" height="24" alt="" /></span>
          <p><b>{date}</b><br /><span class="muted">那一天的签</span></p>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="kicker">这个仪式</div>
    <h2>为什么一天只给一支？</h2>
    <p>
      无限重抽，是把问事做成老虎机的路数。今日运势反其道而行：一天只予一支，
      且是今日众人共有的这一支。晨起读它，揣着那三个数字，
      任它随你一天起落变换意思——签无喜怒，随境而显，好签本该这样用。
    </p>
    <div class="steps">
      <div class="step"><div class="n">早晨</div><p>在一天开始抢着说话之前读它。</p></div>
      <div class="step"><div class="n">中午</div><p>回头看一眼——早八点要紧的那句，到下午两点往往换成了另一句。</p></div>
      <div class="step"><div class="n">零点</div><p>换新签。一整天都应验的那句，多半不是签灵，是你心定。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">常见问题</div>
    <h2>今日运势 FAQ</h2>
    <Faq items={[
      { q: '全天都是同一支签？', a: '是——日期就是种子，同一天，所有访客同一支签。每晚零点换新，日日如是。无需账号，也不挂任何追踪。' },
      { q: '能看昨天的签吗？', a: '今日页永远显示「今天」。日期归档页已经在了——从首页签文卡点进去，或直接输网址，过去的每一支签都能再看、再分享。' },
      { q: '今日签怎么选出来的？', a: '日期过一个确定性种子——没有人工挑选、没有偏心、也不记得最近出过哪些签。任何人、同一天、同一个签库，算出的都是同一支。' },
      { q: '幸运数字怎么用？', a: '随你开心——买彩票、抽奖、「三扇门选哪扇」。这三个数字属于今天：零点和签一起换新。' },
      { q: '为什么是感情、财运、事业？', a: '因为问事的头三名就是它们。感情、财运、事业，今日签各写一读，外加一步具体的行动——哪一读合你今天，就取哪一读。' },
    ]} />
  </section>
</Base>

<script>
  // 访客当天日期与构建日不同时，客户端重渲染。
  import { dailyDraw } from '../../lib/engine';
  import { renderReading } from '../../lib/reading';

  const el = document.querySelector<HTMLElement>('[data-outcome]');
  const titleEl = document.querySelector<HTMLElement>('[data-date-title]');
  const today = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD
  const buildDay = el?.dataset.buildDay ?? today;
  if (el && today !== buildDay) {
    const { sign, digits } = dailyDraw(today);
    el.innerHTML = renderReading(sign, digits, {
      lang: 'zh',
      luckyLabel: '今日幸运数字',
      note: '这是今天的签——零点换新。若正中你心，不妨截图留存。',
    });
    if (titleEl) {
      titleEl.textContent = new Date(today + 'T12:00:00').toLocaleDateString('zh-CN', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }
  }
</script>
