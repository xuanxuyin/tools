---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
---
<Base
  lang="zh"
  title="签语饼 — 在线掰一支 | Fortune Willow（内部审阅版）"
  description="掰开一支签语饼：一句签语，三个幸运数字——数字亦是钥匙，可在数字神谕解锁一整篇签文。一饼一机缘。"
>
  <section class="tool-shell card">
    <div class="tool-stage">
      <h1>签语饼</h1>
      <p class="tool-sub">
        掰开一支：签语自现于前，三个幸运数字随于后——数字亦是钥匙，
        带去数字神谕，可解锁一整篇完整签文。
      </p>
      <div class="stage-visual">
        <div class="cookie" data-cookie>
          <div class="fortune-slip" data-slip></div>
          <div class="chalf l"></div>
          <div class="chalf r"></div>
        </div>
      </div>
      <button class="btn" data-crack>掰开它</button>
      <p class="hint">签语 + 3 个幸运数字 · 数字即完整签文之门</p>
    </div>
    <div data-ration-slot></div>
    <div class="tool-outcome" data-outcome></div>
  </section>

  <section class="section">
    <div class="kicker">怎么玩</div>
    <h2>掰开 · 会意 · 随数而行</h2>
    <div class="steps">
      <div class="step"><div class="n">1 · 掰</div><p>轻轻一掰，签语自现——一句值得揣在心上、过完今天的话。</p></div>
      <div class="step"><div class="n">2 · 收好数字</div><p>三个幸运数字随签语一同现前——0 到 9 之间，与真饼无异。</p></div>
      <div class="step"><div class="n">3 · 看深一层</div><p>三个数字亦是一把钥匙：带去数字神谕，自会选出一整篇签文——吉语、典故、判词、下一步。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">何时掰饼</div>
    <h2>十秒，也是一场小仪式</h2>
    <div class="scene-list">
      <div class="scene"><span class="glyph"><img src="/img/icons/fortune_cookie.png" width="24" height="24" alt="" /></span><p><b>午休。</b>签语饼的本分场景。九十秒的机缘，零 MSG。</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/calendar.png" width="24" height="24" alt="" /></span><p><b>周一早上。</b>收件箱开口之前先掰一支——比「急：回复：回复：」更配当今天的第一句话。</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/game_die.png" width="24" height="24" alt="" /></span><p><b>数字型人格。</b>彩票号码、抽奖券、「三条路走哪条」——数字随你花。</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/busts_in_silhouette.png" width="24" height="24" alt="" /></span><p><b>饭桌仪式。</b>一人一支，出声念出来。给签语排座次，乐趣占一半。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">常见问题</div>
    <h2>签语饼 FAQ</h2>
    <Faq items={[
      { q: '签语是随机的吗？', a: '抽取是随机的，写作不是。每一句都是本站手写——没有那种从外卖盒里刮来的一千条循环段子。' },
      { q: '幸运数字有什么用？', a: '随你用——或者把它们当钥匙：同样三个数字放到数字神谕里，选出的正是这支签语从头到尾指向的那篇完整签文。' },
      { q: '能掰不止一支吗？', a: '一天一缘，全站道具共用；功德每小时聚一点，捐 8 点入箱即续一缘。老规矩：一天之中，第一支最灵。' },
      { q: '「看全文」链接是做什么的？', a: '一句话只是引子。你的数字对应着一篇完整签文——感情、财运、事业，各有一读。饼是门，神谕是门后的房间。' },
      { q: '每支签都带幸运数字？', a: '是——三个数字，每支都有，完全对标经典外卖格式。要不然人对彩票的想象力从哪来？' },
    ]} />
  </section>
</Base>

<script>
  import { cookieFortune, liveRand } from '../../lib/engine';
  import { trackDraw } from '../../lib/track';
  import { gateDraw } from '../../lib/rationUi';

  const cookie = document.querySelector<HTMLElement>('[data-cookie]');
  const slip = document.querySelector<HTMLElement>('[data-slip]');
  const btn = document.querySelector<HTMLButtonElement>('[data-crack]');
  const outcome = document.querySelector<HTMLElement>('[data-outcome]');

  const crack = () => {
    if (!cookie || !outcome || !slip) return;
    if (!gateDraw(crack)) return; // ration: one free draw a day — merit buys more
    if (btn) btn.disabled = true;
    cookie.classList.remove('open');
    outcome.innerHTML = '';
    window.setTimeout(() => {
      const { sign, digits } = cookieFortune(liveRand());
      trackDraw('fortune-cookie', sign.id);
      cookie.classList.add('open');
      slip.textContent = sign.titleZh;
      const d = digits.join('');
      outcome.innerHTML = `
        <article class="reading card">
          <div class="reading-head"><span class="chip blessing">签语</span></div>
          <div class="reading-title">${sign.titleZh}</div>
          <div class="lucky-row"><span class="lbl">幸运数字</span>
            ${digits.map((n) => `<span class="pill">${n}</span>`).join('')}
          </div>
          <p class="again-line">数字即钥匙——带着它们去数字神谕，
            <a href="/zh/number-oracle/?d=${d}">看这篇完整签文 →</a>
          </p>
        </article>`;
      outcome.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (btn) btn.disabled = false;
    }, 350);
  };

  btn?.addEventListener('click', crack);
  cookie?.addEventListener('click', crack);
</script>
