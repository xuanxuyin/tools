---
import { iconSvg } from '../../../lib/icons';
import Base from '../../../layouts/Base.astro';
import { SIGNS } from '../../../data/signs';
import { renderReading } from '../../../lib/reading';
import { digitsForSign } from '../../../lib/engine';

export function getStaticPaths() {
  return SIGNS.map((sign) => ({ params: { slug: sign.slug }, props: { sign } }));
}
const { sign } = Astro.props;
const digits = digitsForSign(sign.id);
const prev = SIGNS[sign.id === 1 ? SIGNS.length - 1 : sign.id - 2];
const next = SIGNS[sign.id % SIGNS.length];
const desc = `${sign.nameZh}——第 ${sign.id} 签：${sign.titleZh}`.slice(0, 158);
---
<Base lang="zh" title={`${sign.nameZh}（第 ${sign.id} 签）签文详解 | Fortune Willow（内部审阅版）`} description={desc}>
  <section class="tool-shell card">
    <div class="tool-stage">
      <div class="kicker">百签签库 · 第 {String(sign.id).padStart(2, '0')} 签</div>
      <h1>{sign.nameZh}</h1>
      <p class="date-line">{sign.titleZh}</p>
    </div>
    <div class="sign-lock" data-sign-lock={sign.id}>
      <div class="tool-outcome" set:html={renderReading(sign, undefined, { lang: 'zh' })}></div>
      <div class="lock-panel">
        <span class="lock-ic" aria-hidden="true"><img src="/img/icons/locked.png" width="28" height="28" alt="" /></span>
        <p class="lock-title">此签与你缘份未到，先蒙着</p>
        <p class="lock-sub">
          签库靠机缘攒：凡落到你手里的签——任何工具抽到的——都在此全文打开。
          第 {sign.id} 签，与你还没结缘。
        </p>
        <a class="btn" href="/zh/fortune-stick/">去抽签</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">与此签结缘</div>
    <h2>去数字神谕掷出这组数字</h2>
    <p>前两位数字引出此签；三个数字合起来，便是你此问的幸运数字。</p>
    <p style="margin-top:0.9rem">
      <a class="btn" href={`/zh/number-oracle/?d=${digits.join('')}`}>{digits.join(' ')}——去问事</a>
    </p>
  </section>

  <section class="section">
    <div class="scene-list">
      <a class="scene" href={`/zh/signs/${prev.slug}/`}>
        <span class="glyph"><Fragment set:html={iconSvg('arrowLeft', 20)} /></span>
        <p><b>{prev.nameZh}</b><br /><span class="muted">第 {String(prev.id).padStart(2, '0')} 签</span></p>
      </a>
      <a class="scene" href="/zh/signs/">
        <span class="glyph"><img src="/img/icons/scroll.png" width="24" height="24" alt="" /></span>
        <p><b>返回签库</b><br /><span class="muted">一百支签全列</span></p>
      </a>
      <a class="scene" href={`/zh/signs/${next.slug}/`}>
        <span class="glyph"><Fragment set:html={iconSvg('arrowRight', 20)} /></span>
        <p><b>{next.nameZh}</b><br /><span class="muted">第 {String(next.id).padStart(2, '0')} 签</span></p>
      </a>
    </div>
  </section>
  <script>
    import { applyGating } from '../../../lib/unlock';
    applyGating();
  </script>
</Base>
