---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import Jar3d from '../components/Jar3d.astro';
import { dailyDraw } from '../lib/engine';
import { SIGN_VERSES } from '../data/signVerses';

const today = new Date().toISOString().slice(0, 10);
const { sign, digits } = dailyDraw(today);
const verse = SIGN_VERSES[sign.id]?.en ?? [];
const GRADE_LABEL: Record<typeof sign.grade, string> = {
  blessing: 'Blessing',
  nudge: 'Nudge',
  'gentle-warning': 'Gentle Warning',
};
---
<Base
  title="Fortune Willow — Ask Anything, Get a Real Answer"
  description="Fortune sticks, a number oracle, magic 8-ball, coin flips and more — every tool answers your question and tells you what to do next. Hand-written fortunes, free, no sign-up."
>
  <!-- hero:左文案右签筒(👤 11/10 参考 1.jpg 主页效果图布局) -->
  <section class="hero">
    <div class="hero-copy">
      <div class="kicker">Ask. Shake. Get a real answer.</div>
      <h1>Shake the jar.<br />Get an answer worth reading.</h1>
      <p class="hero-sub">
        Fortune sticks with hand-written readings for love, money, and work.
      </p>
      <div class="hero-cta">
        <a class="btn" href="/fortune-stick/">Draw your fortune →</a>
        <a class="hero-alt" href="/daily-fortune/">or read today’s shared fortune</a>
      </div>
    </div>
    <div class="hero-stage">
      <Jar3d uid="hero" class="hero-jar" />
    </div>
  </section>

  <!-- features:四栏细线分隔(参考稿中部) -->
  <section class="features" aria-label="What makes a Fortune Willow draw different">
    <div class="feature">
      <img class="fico" src="/img/jar-icon.png" width="30" height="30" alt="" />
      <b>A real shake</b>
      <span>The jar tilts, the sticks rattle, one rises. No instant-reveal button.</span>
    </div>
    <div class="feature">
      <img class="fico" src="/img/icons/scroll.png" width="30" height="30" alt="" />
      <b>A verse on every stick</b>
      <span>Each draw carries its four-line poem — a keepsake, not a one-liner.</span>
    </div>
    <div class="feature">
      <img class="fico" src="/img/icons/crystal_ball.png" width="30" height="30" alt="" />
      <b>Plain-language readings</b>
      <span>Love, money and career in sentences you can actually use before dinner.</span>
    </div>
    <div class="feature">
      <img class="fico" src="/img/icons/calendar.png" width="30" height="30" alt="" />
      <b>Come back tomorrow</b>
      <span>A fresh shared fortune every morning, and every draw unlocks more of the library.</span>
    </div>
  </section>

  <!-- draw duo:左仪式卡 + 右今日签文卡(参考稿下部两栏) -->
  <section class="draw-duo">
    <div class="card draw-left">
      <p class="draw-q">Hold the question in mind.<br />Then shake — once, properly.</p>
      <Jar3d uid="draw" class="draw-jar" />
      <a class="shake-ring" href="/fortune-stick/">SHAKE</a>
      <p class="hint">One deliberate draw beats ten quick clicks.</p>
    </div>
    <div class="card draw-right">
      <span class="grade-pill">{GRADE_LABEL[sign.grade]}</span>
      <div class="verse-hero">
        {verse.map((line) => <p>{line}</p>)}
      </div>
      <div class="verse-attr">— Fortune No. {String(sign.id).padStart(2, '0')} · {sign.name}</div>
      <hr class="hairline" />
      <div class="verse-mean">
        <b>What it means today</b>
        <p>{sign.overall}</p>
      </div>
      <a class="verse-link" href="/daily-fortune/">Read today’s full fortune →</a>
    </div>
  </section>

  <!-- merit box:每日一次免费抽取 + 功德经济(👤 2026-11-11) -->
  <section class="section merit-band" id="merit-box">
    <div class="kicker">The merit box</div>
    <h2>One draw a day. Merit gets you more.</h2>
    <p style="max-width:640px;margin:0 auto">
      Every tool in the family shares one free draw a day — it keeps each reading deliberate.
      Merit builds on its own — a point an hour, up to 24. Drop 8 in the box and bank a draw
      for whichever tool you want next.
    </p>
    <div class="merit-scene" data-merit-root></div>
  </section>

  <section class="section">
    <div class="kicker">The whole family</div>
    <h2>Pick a tool, ask your question.</h2>
    <div class="grid-tools">
      <ToolCard href="/fortune-stick/" icon="jar" name="Fortune Stick" desc="Shake the jar, draw one hand-written fortune with love, money, and career readings." />
      <ToolCard href="/number-oracle/" icon="input_numbers" name="Number Oracle" desc="Roll three digits 0–9 — they pick your fortune and become your lucky numbers." />
      <ToolCard href="/magic-8-ball/" icon="pool_8_ball" name="Magic 8-Ball" desc="The classic answers — each with an honest read on what to do about it." />
      <ToolCard href="/yes-no/" icon="check_mark_button" name="Yes or No" desc="A clean 50/50 plus the why and the next step. No hedging, no ‘maybe’." />
      <ToolCard href="/coin-flip/" icon="coin" name="Coin Flip" desc="Heads is yes, tails is no. The oldest tiebreaker in history, zero pocket change." />
      <ToolCard href="/fortune-cookie/" icon="fortune_cookie" name="Fortune Cookie" desc="Crack one open: your message plus three lucky numbers that unlock a full reading." />
      <ToolCard href="/horoscope/" icon="crystal_ball" name="Horoscope" desc="Today's shared fortune read through your zodiac sign — same draw, your sign's take on it." />
      <ToolCard href="/signs/" icon="scroll" name="The 100 Fortunes" desc="All 100 hand-written fortunes on the record — every sign's name, story, and readings." />
    </div>
  </section>

  <section class="section">
    <div class="kicker">Why it works</div>
    <h2>Randomness is a tool — the reading is the service</h2>
    <p>
      A coin flip ends an argument; it does not tell you what to do Monday. Every tool here pairs an
      honest random draw with a layer of real writing: a reason, a story, a verdict for love or money
      or work, and a single step you can actually take tonight.
    </p>
    <div class="steps">
      <div class="step"><div class="n">Hand-written library</div><p>Our fortunes are written and edited in-house — every sign has a headline, a story, three life-area readings, and one action. No recycled one-liners.</p></div>
      <div class="step"><div class="n">Three grades, no doom</div><p>Blessings, nudges, and gentle warnings. A hard truth, yes — we do not write fortunes designed to ruin your week.</p></div>
      <div class="step"><div class="n">Private by design</div><p>Everything runs in your browser. The question you type never leaves your device, because there is nowhere for it to go.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">Questions</div>
    <h2>FAQ</h2>
    <Faq items={[
      { q: 'Is this free?', a: 'Yes — no account, no card. Each day brings one free draw shared across every tool; collect merit (a point an hour, up to 24) and donate 8 to the merit box whenever you want another. The site runs on your attention, not your email address.' },
      { q: 'Which tool should I use?', a: 'Got a decision right now? Yes/No or the coin. A bigger question about work, love or money? The Fortune Stick. Feel like letting numbers choose? The Number Oracle. Just want a ten-second ritual? The cookie.' },
      { q: 'Are these fortunes serious?', a: 'The randomness is real and so is the writing — but Fortune Willow is for entertainment and reflection, not medical, legal, or financial advice. For decisions about health, safety, or other people’s rights, talk to a professional, not an 8-ball.' },
      { q: 'Where do the fortunes come from?', a: 'They are original adaptations of the fortune-stick tradition — numbered sticks with a poem, a story, and guidance — rewritten for the decisions you actually face: job offers, group chats, savings goals, second dates.' },
      { q: 'Can I get the same fortune twice?', a: 'Yes — the draws are fair and independent, so repeats happen exactly as often as probability says. If the same fortune keeps finding you, that is between you and the universe.' },
    ]} />
  </section>

  <!-- 水墨山影收尾(参考稿页尾带) -->
  <div class="mountains" aria-hidden="true">
    <svg viewBox="0 0 1200 150" preserveAspectRatio="none">
      <path d="M0 150 L0 92 Q140 34 300 76 T580 60 T860 86 T1100 54 L1200 78 L1200 150 Z" fill="#3d3628" opacity="0.055" />
      <path d="M0 150 L0 118 Q180 72 380 106 T720 94 T1020 116 L1200 100 L1200 150 Z" fill="#3d3628" opacity="0.09" />
    </svg>
  </div>
</Base>

<script>
  import { mountMeritBox } from '../lib/rationUi';
  const root = document.querySelector<HTMLElement>('[data-merit-root]');
  if (root) mountMeritBox(root);
</script>
