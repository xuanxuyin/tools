---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import JarSvg from '../components/JarSvg.astro';
import { dailyDraw } from '../lib/engine';
import { SIGN_VERSES } from '../data/signVerses';

const today = new Date().toISOString().slice(0, 10);
const { sign, digits } = dailyDraw(today);
const verse = SIGN_VERSES[sign.id]?.en ?? [];
const GRADE_LABEL: Record<typeof sign.grade, string> = {
  blessing: 'Blessing',
  nudge: 'Nudge',
  'gentle-warning': 'Gentle Warning',
};
---
<Base
  title="LuckyShake — Ask Anything, Get a Real Answer"
  description="Fortune sticks, a number oracle, magic 8-ball, coin flips and more — every tool answers your question and tells you what to do next. Hand-written fortunes, free, no sign-up."
>
  <!-- hero:左文案右签筒(👤 11/10 参考 1.jpg 主页效果图布局) -->
  <section class="hero">
    <div class="hero-copy">
      <div class="kicker">Ask. Shake. Get a real answer.</div>
      <h1>Shake the jar.<br />Get an answer worth reading.</h1>
      <p class="hero-sub">
        Fortune sticks with hand-written readings for love, money and work — an old ritual pointed
        at modern decisions.
      </p>
      <p class="hero-meta"><b>100</b> hand-written fortunes · Free · No sign-up</p>
      <div class="hero-cta">
        <a class="btn" href="/fortune-stick/">Draw your fortune →</a>
        <a class="hero-alt" href="/daily-fortune/">or read today’s shared fortune</a>
      </div>
    </div>
    <div class="hero-stage">
      <JarSvg uid="hero" class="hero-jar" />
      <div class="hero-vert">Ask · Shake · Read</div>
    </div>
  </section>

  <!-- features:四栏细线分隔(参考稿中部) -->
  <section class="features" aria-label="What makes a LuckyShake draw different">
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M10 4v7M18 4v7" />
        <rect x="6" y="11" width="16" height="13" rx="3" />
        <path d="M10 16.5h8" opacity=".5" />
      </svg>
      <b>A real shake</b>
      <span>The jar tilts, the sticks rattle, one rises. No instant-reveal button.</span>
    </div>
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M9 4h10M9 9h10M9 14h6M9 19h8" />
      </svg>
      <b>A verse on every stick</b>
      <span>Each draw carries its four-line poem — the artifact, not a one-liner.</span>
    </div>
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 7c-2-1.7-4.8-2.2-8-2.2v16.4c3.2 0 6 .5 8 2.2 2-1.7 4.8-2.2 8-2.2V4.8c-3.2 0-6 .5-8 2.2v16.2" />
      </svg>
      <b>Plain-language readings</b>
      <span>Love, money and career in sentences you can actually use before dinner.</span>
    </div>
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="6" width="20" height="17" rx="3" />
        <path d="M4 11.5h20M9.5 3v5M18.5 3v5" />
        <path d="M10 18l3 3 5.5-5.5" />
      </svg>
      <b>Come back daily</b>
      <span>A fresh shared fortune every day, and your draws unlock the full library.</span>
    </div>
  </section>

  <!-- draw duo:左仪式卡 + 右今日签文卡(参考稿下部两栏) -->
  <section class="draw-duo">
    <div class="card draw-left">
      <p class="draw-q">Hold the question in mind.<br />Then shake — once, properly.</p>
      <JarSvg uid="draw" class="draw-jar" />
      <a class="shake-ring" href="/fortune-stick/">SHAKE</a>
      <p class="hint">One deliberate draw beats ten quick clicks.</p>
    </div>
    <div class="card draw-right">
      <span class="grade-pill">{GRADE_LABEL[sign.grade]}</span>
      <div class="verse-hero">
        {verse.map((line) => <p>{line}</p>)}
      </div>
      <div class="verse-attr">— Fortune No. {String(sign.id).padStart(2, '0')} · {sign.name}</div>
      <hr class="hairline" />
      <div class="verse-mean">
        <b>What it means today</b>
        <p>{sign.overall}</p>
      </div>
      <a class="verse-link" href="/daily-fortune/">Read today’s full fortune →</a>
    </div>
  </section>

  <section class="section">
    <div class="kicker">The whole family</div>
    <div class="grid-tools">
      <ToolCard href="/fortune-stick/" glyph="🥢" name="Fortune Stick" desc="Shake the jar, draw one hand-written fortune with love, money and career readings." />
      <ToolCard href="/number-oracle/" glyph="🔢" name="Number Oracle" desc="Roll three digits 0–9 — they pick your fortune and become your lucky numbers." />
      <ToolCard href="/magic-8-ball/" glyph="🎱" name="Magic 8-Ball" desc="The classic answers — each with the honest read on what to do about it." />
      <ToolCard href="/yes-no/" glyph="✅" name="Yes or No" desc="A clean 50/50 plus the why and the next step. No hedging, no 'maybe'." />
      <ToolCard href="/coin-flip/" glyph="🪙" name="Coin Flip" desc="Heads is yes, tails is no. The oldest tiebreaker in history, zero pocket change." />
      <ToolCard href="/fortune-cookie/" glyph="🥠" name="Fortune Cookie" desc="Crack one open: your message plus three lucky numbers that unlock a full reading." />
      <ToolCard href="/horoscope/" glyph="♈" name="Horoscope" desc="Today's shared fortune read through your zodiac sign — same draw, your sign's take on it." />
      <ToolCard href="/signs/" glyph="📜" name="The 100 Fortunes" desc="The whole hand-written library on the record: every sign's name, story, and readings." />
    </div>
  </section>

  <section class="section">
    <div class="kicker">Why it works</div>
    <h2>Randomness is a tool — the reading is the service</h2>
    <p>
      A coin flip ends an argument; it does not tell you what to do Monday. Every tool here pairs an
      honest random draw with a layer of real writing: a reason, a story, a verdict for love or money
      or work, and a single step you can actually take before dinner.
    </p>
    <div class="steps">
      <div class="step"><div class="n">Hand-written library</div><p>Our fortunes are written and edited in-house — every sign has a headline, a story, three life-area readings and one action. No recycled one-liner dumps.</p></div>
      <div class="step"><div class="n">Three grades, no doom</div><p>Blessings, nudges, and gentle warnings. A hard truth, yes — we do not write fortunes designed to ruin your week.</p></div>
      <div class="step"><div class="n">Private by design</div><p>Everything runs in your browser. The question you type never leaves your device, because there is nowhere for it to go.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">Questions</div>
    <h2>FAQ</h2>
    <Faq items={[
      { q: 'Is this free?', a: 'Completely — every tool, unlimited use, no account. The site is supported by keeping your attention, not your email address.' },
      { q: 'Which tool should I use?', a: 'Got a decision right now? Yes/No or the coin. A bigger question about work, love or money? The Fortune Stick. Feel like letting numbers choose? The Number Oracle. Just want a ten-second ritual? The cookie.' },
      { q: 'Are these fortunes serious?', a: 'The randomness is real and so is the writing — but LuckyShake is for entertainment and reflection, not medical, legal, or financial advice. For decisions about health, safety, or other people’s rights, talk to a professional, not an 8-ball.' },
      { q: 'Where do the fortunes come from?', a: 'They are original adaptations of the fortune-stick tradition — numbered sticks with a poem, a story, and guidance — rewritten for modern American decisions: job offers, group chats, savings goals, second dates.' },
      { q: 'Can I get the same fortune twice?', a: 'Yes — the draws are fair and independent, so repeats happen exactly as often as probability says. If the same fortune keeps finding you, that is between you and the universe.' },
    ]} />
  </section>

  <!-- 水墨山影收尾(参考稿页尾带) -->
  <div class="mountains" aria-hidden="true">
    <svg viewBox="0 0 1200 150" preserveAspectRatio="none">
      <path d="M0 150 L0 92 Q140 34 300 76 T580 60 T860 86 T1100 54 L1200 78 L1200 150 Z" fill="#3d3628" opacity="0.055" />
      <path d="M0 150 L0 118 Q180 72 380 106 T720 94 T1020 116 L1200 100 L1200 150 Z" fill="#3d3628" opacity="0.09" />
    </svg>
  </div>
</Base>
