---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { SIGNS } from '../data/signs';

// FAQ 数据抽成常量:页面渲染与 FAQPage 结构化数据共用一份
const faqItems = [
  { q: 'Are the fortunes random?', a: 'Yes — the stick you draw is a fair random pick from our library. What is not random is the writing: every fortune is hand-written and edited in-house, with readings tuned to love, money, and career situations.' },
  { q: 'Why do I pick a topic after drawing?', a: 'That is how the ritual works: hold the question privately while the jar shakes, then say what it was about — that is what the fortune answers. Your words route the reading to love, money, or career; anything else gets the fortune’s overall reading. One question, one answer: shake again to ask something else.' },
  { q: 'Where do these fortunes come from?', a: 'They are original adaptations of kau cim, the temple tradition of numbered fortune sticks: each stick carries a poem, a story, and guidance. We rewrote the tradition for modern life — no riddles about harvests, just clear guidance with the story kept in. The unrewritten temple texts (the Guanyin hundred, in Chinese) have their own page here too.' },
  { q: 'Can I ask about another person?', a: 'You can, but the strongest questions are about your own next move. "Should I text them back?" beats "does he miss me?" — one gives you an action, the other just gives you a mood.' },
  { q: 'What are the three grades?', a: 'Every stick is graded as a Blessing (green light energy), a Nudge (steady, practical guidance), or a Gentle Warning (slow down and protect what matters). We do not write doom-and-gloom fortunes — a hard truth, yes; despair, never.' },
  { q: 'Does the same stick always mean the same thing?', a: 'The words are fixed; the reading is yours. Sign 01 on a Tuesday about a job and the same sign on a Friday about a relationship will land differently — that gap is where your own judgment lives, and it is the most reliable oracle in this whole site.' },
];

// 结构化数据:工具本体(免费 WebApplication)+ FAQ 块 —— 11/16 SEO 批
// (工具意图词前置,FAQ schema 照 [slug].astro 的内联 ld+json 形态)
const toolLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Chinese Fortune Sticks Online',
  alternateName: 'Fortune Stick — Kau Cim',
  url: new URL('/fortune-stick/', Astro.site).href,
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Draw a Chinese fortune stick online, free: shake the jar and draw one of 100 hand-written kau cim fortunes, with readings for love, money, and career.',
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Base
  title="Chinese Fortune Sticks Online — Draw a Kau Cim Stick Free | Fortune Willow"
  description="Draw a Chinese fortune stick online, free: shake the jar, draw one of 100 hand-written kau cim fortunes — readings for love, money, and career, plus lucky numbers."
>
  <script type="application/ld+json" set:html={JSON.stringify(toolLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="tool-shell card">
    <div class="tool-stage">
      <div class="kicker">Kau cim · 摇签</div>
      <h1>Draw a Chinese Fortune Stick</h1>
      <p class="tool-sub">
        Let the jar do the picking. Hold your question in mind — no typing yet.
        Shake the jar: the stick that leaps out already carries the answer. When it lands, tell the
        jar what you asked about.
      </p>
      <!-- 👤 11/17 "把上香做到 3D 场景里去"：DOM 香炉组件整体下线，上香
           仪式搬进法堂场景——青铜香炉立在供案上，状态条（领香/点香/敬香）
           叠在场景左下角；敬香瞬间镜头推近供桌看香点燃。data-cup 守卫随
           hero 走，页脚本用 incense.ts 原语直接驱动状态 -->
      <div class="hall-hero" data-cup>
        <div class="hall-cup" data-hall-cup></div>
        <div class="incense-strip">
          <span class="incense-strip-hint" data-incense-hint></span>
          <button class="btn small" data-incense-btn type="button"></button>
        </div>
        <div class="hall-cta">
          <button class="btn" data-shake>Draw a stick</button>
          <p class="hint">A hundred sticks in the jar · one draw a day</p>
        </div>
      </div>
    </div>
    <div data-ration-slot></div>
    <div class="tool-outcome" data-outcome></div>
  </section>

  <section class="section">
    <div class="kicker">How it works</div>
    <h2>Three steps, one answer</h2>
    <div class="steps">
      <div class="step"><div class="n">1 · Hold it in mind</div><p>Think of one real question — a decision you are actually sitting on — and keep it to yourself for now. "Should I take the job?" works better than "what is life?"</p></div>
      <div class="step"><div class="n">2 · Shake</div><p>The jar rattles hard and one stick tumbles out, landing on the ground — number and name showing. The jar never knew your question — that is the point. It breaks the loop of going in circles.</p></div>
      <div class="step"><div class="n">3 · Name it</div><p>Now say what you asked about: love, money, career — or your own words. The stick answers the question you actually asked, plus one concrete step to take.</p></div>
    </div>
  </section>

  <section class="section moments-night">
    <div class="kicker">When people draw</div>
    <h2>The moments a stick helps most</h2>
    <div class="scene-list">
      <div class="scene"><span class="glyph"><img src="/img/icons/briefcase.png" width="24" height="24" alt="" /></span><p><b>Offer on the table.</b> Take it, push back, or walk? A fortune will not decide for you — but it will show you which part you already decided.</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/mobile_phone.png" width="24" height="24" alt="" /></span><p><b>The text you keep rewriting.</b> Send it or let it go? Draw a stick, then notice whether you are hoping for a blessing or permission to let go.</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/money_with_wings.png" width="24" height="24" alt="" /></span><p><b>Big purchase circling your brain.</b> The money verdict gives you a lens that is not "how bad do I want it."</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/compass.png" width="24" height="24" alt="" /></span><p><b>A quiet crossroads.</b> No crisis, just two decent paths. Random input is honest exactly where your own analysis is tired.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">The tradition</div>
    <h2>An old jar, a new deck</h2>
    <div class="tradition">
      <p>
        This jar is our take on <b>kau cim</b> — the bamboo-stick oracle you will find in Chinese
        temples anywhere in the world, and one of the quiet fixtures of Chinese fortune telling. A
        tall cylinder holds a hundred numbered sticks. You hold one question, shake until a stick
        leaps out on its own, and read the verse that matches its number. That is the whole
        machine: no fee, no appointment — just a jar and a question, the same way it has run for
        centuries.
      </p>
      <p>
        We kept the machine and rewrote every word. The form is unchanged — a hundred sticks, one
        question, the jar decides — but each verse here is written in-house in plain English, for
        decisions you actually face this week: the offer, the lease, the text you keep rewriting.
        Temple verses lean on classical poems and dynasty-old stories; ours keep the story and
        drop the riddles.
      </p>
      <p>
        Want the temple texts themselves? The traditional set most temples carry — the Guanyin
        hundred, with two editions of every poem, classical verdicts, and the old stories — lives
        on our site too, in Chinese: <a href="/guanyin-lingqian/">browse the full Guanyin
        oracle</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="kicker">Questions</div>
    <h2>Fortune Stick FAQ</h2>
    <Faq items={faqItems} />
  </section>
</Base>

<style>
  /* 11/16 M2 二轮"场景太小/不像寺庙"：抽签区整块 = 全宽法堂 hero。
     相机在 hall3d 内部（院中望门终局 + 摇签推近供桌特写） */
  .hall-hero {
    position: relative;
    height: clamp(380px, 50vw, 540px);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 2px 0 24px;
    background: var(--bg-deep);
  }
  .hall-cup { position: absolute; inset: 0; cursor: pointer; }
  .hall-cta {
    position: absolute;
    left: 0; right: 0; bottom: 18px;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    z-index: 5;
  }
  .hall-cta .hint {
    color: rgba(255, 253, 248, 0.8);
    text-shadow: 0 1px 6px rgba(36, 31, 61, 0.6);
    margin: 0;
  }
  /* 上香状态条（👤 11/17 上香进 3D 场景）：叠在场景左下角的小仪轨面板，
     按钮状态由页脚本按 incense.ts 状态机驱动（领香→点香→敬香→燃尽） */
  .incense-strip {
    position: absolute;
    left: 16px;
    bottom: 18px;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    max-width: 250px;
  }
  .incense-strip-hint {
    color: rgba(255, 253, 248, 0.88);
    font-size: 12px;
    line-height: 1.5;
    text-shadow: 0 1px 6px rgba(36, 31, 61, 0.65);
  }
  /* 无按钮的状态（燃烧中/已燃尽）也要一眼可见：提示语升级成描边徽章，
     否则用户以为上香流程没了（👤 11/17 真实踩坑） */
  .incense-strip.has-no-action .incense-strip-hint {
    border: 1px solid rgba(255, 253, 248, 0.3);
    border-radius: 10px;
    padding: 7px 12px;
    background: rgba(36, 31, 61, 0.38);
  }
  .incense-strip .btn { font-size: 0.85rem; padding: 9px 16px; }

  /* 11/16 design 批:传统段从裸文本升为庙墙黄面板(--temple,功德箱同源底色),
     给页中段一个对比面;文字色保持纸面体系(ink-soft 对 temple 实测 5.5:1 过 4.5) */
  .tradition {
    max-width: 720px;
    background: var(--temple);
    border: 1px solid color-mix(in srgb, var(--gold), transparent 55%);
    border-radius: var(--radius);
    padding: 20px 24px 0;
  }
  .tradition p { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.75; margin: 0 0 14px; }
  .tradition b { color: var(--ink); }
  .tradition a { font-weight: 600; }

  /* 11/16 design 批二:"moments" 段升为夜庙面板(--bg-deep,today-strip 同源语言)——
     页中段的视觉锚点;金 kicker + 象牙标题,场景卡改半透明夜砖,
     象牙字对深底实测 ~9.4:1。彩色 Fluent 图标在深底上反而更跳 */
  .moments-night {
    background: var(--bg-deep);
    border-radius: var(--radius);
    padding: 30px 28px 24px;
    box-shadow: var(--shadow);
  }
  .moments-night .kicker { color: var(--gold); }
  .moments-night h2 { color: #f3eede; margin-bottom: 0.3rem; }
  .moments-night .scene {
    background: rgba(255, 253, 248, 0.07);
    border-color: rgba(255, 253, 248, 0.16);
  }
  .moments-night .scene b { color: #fff; }
  .moments-night .scene p { color: #cbc4da; }
</style>

<script>
  import { drawSign, liveRand } from '../lib/engine';
  import { trackDraw } from '../lib/track';
  import { gateDraw } from '../lib/rationUi';
  import { drawnBanner, renderFocusedReading } from '../lib/reading';
  import { wireShareButtons } from '../lib/shareCard';
  import { focusPanelHTML, wireFocusPanel } from '../lib/focusFlow';
  import { focusForQuestion } from '../lib/classify';
  // 上香进 3D 场景（👤 11/17）：状态机原语直接进页脚本，场景香炉吃其输出
  import {
    loadIncense,
    saveIncense,
    claimIncense,
    lightStick,
    offerStick,
    burnRatio,
    INCENSE_PER_DAY,
  } from '../lib/incense';
  import { todayLocal } from '../lib/ration';
  import type { Hall3D } from '../lib/hall3d';
  import type { Jar3D } from '../lib/jar3d';

  const cup = document.querySelector<HTMLElement>('[data-cup]');
  const btn = document.querySelector<HTMLButtonElement>('[data-shake]');
  const outcome = document.querySelector<HTMLElement>('[data-outcome]');
  // 11/16 M2: the draw hero is now the hall scene (wide temple shot) — its
  // jar rig feeds the SAME draw flow; WebGL-less falls back to standalone jar
  let hall: Hall3D | null = null;
  let jar: Jar3D | null = null;
  const hallHost = document.querySelector<HTMLElement>('[data-hall-cup]');
  if (hallHost) {
    const { createHall } = await import('../lib/hall3d');
    hall = createHall(hallHost, {
      quick: true,
      // 英文页挂英文匾（中文场景默认「柳寺 / 有求必应」）
      plaques: { gate: 'WILLOW TEMPLE', hall: 'ANSWERS WITHIN' },
    });
    if (hall) {
      jar = hall.jar;
      hallHost.addEventListener('click', () => hall?.skipToAltar());
    } else {
      const { createJar3D } = await import('../lib/jar3d');
      jar = createJar3D(hallHost);
    }
  }
  wireShareButtons(); // 揭示 banner 里的 [data-share-card](分享带日期签卡)

  // ---- 上香进 3D 场景（👤 11/17 "把上香做到场景里去"）：左下状态条驱动
  //      incense.ts 状态机，场景青铜香炉（hall.setIncense）吃燃耗输出；
  //      点香/敬香瞬间推近供桌，看三支香立进炉灰冒青烟 ----
  const stripHint = document.querySelector<HTMLElement>('[data-incense-hint]');
  const stripBtn = document.querySelector<HTMLButtonElement>('[data-incense-btn]');
  const strip = document.querySelector<HTMLElement>('.incense-strip');
  const INCENSE_HINT = {
    claimHint: 'Light three sticks of incense before you ask.',
    claim: 'Claim incense',
    lightHint: 'Three sticks claimed — light them.',
    light: 'Light the sticks',
    offerHint: 'Now offer them into the censer.',
    offer: 'Offer into the censer',
    burningHint: 'Incense burning — hold your question and draw.',
    nudgeHint: 'Almost ash — draw your stick now.',
    doneHint: 'Burned to ash — fresh incense tomorrow.',
  } as const;
  let incenseAction: (() => void) | null = null;
  const renderIncense = (): void => {
    const now = new Date();
    const raw = loadIncense(now);
    const claimed = raw.day === todayLocal(now) && raw.sticks.length > 0;
    const burning = claimed ? raw.sticks.filter((s) => s.phase === 'burning') : [];
    const remaining = claimed ? raw.sticks.filter((s) => s.phase !== 'burning') : [];
    const ratios = burning.map((s) => burnRatio(s, now));
    hall?.setIncense(ratios);
    incenseAction = null;
    strip?.classList.toggle('has-no-action', false);
    if (!stripHint || !stripBtn) return;
    if (!claimed) {
      stripHint.textContent = INCENSE_HINT.claimHint;
      stripBtn.textContent = INCENSE_HINT.claim;
      incenseAction = () => {
        saveIncense(claimIncense(new Date()));
      };
    } else if (remaining.length > 0) {
      const anyLit = remaining.some((s) => s.phase === 'lit');
      stripHint.textContent = anyLit ? INCENSE_HINT.offerHint : INCENSE_HINT.lightHint;
      stripBtn.textContent = anyLit ? INCENSE_HINT.offer : INCENSE_HINT.light;
      incenseAction = () => {
        let st = loadIncense(new Date());
        st.sticks.forEach((s, i) => {
          if (s.phase === 'raw') st = lightStick(st, i, new Date());
          else if (s.phase === 'lit') st = offerStick(st, i, new Date()).state;
        });
        saveIncense(st);
        hall?.focusAltar(); // 敬香瞬间推近供桌，看香立进炉灰冒青烟
        window.setTimeout(() => hall?.unfocusAltar(), 4500);
      };
    } else {
      const allBurned = burning.length === INCENSE_PER_DAY && ratios.every((r) => r >= 1);
      const nearly = burning.length > 0 && !allBurned && ratios.some((r) => r >= 0.85);
      stripHint.textContent = allBurned
        ? INCENSE_HINT.doneHint
        : nearly
          ? INCENSE_HINT.nudgeHint
          : INCENSE_HINT.burningHint;
      stripBtn.style.display = 'none';
      strip?.classList.add('has-no-action'); // 无按钮态：提示升级成徽章，别让用户以为流程没了
    }
    if (incenseAction) stripBtn.style.display = '';
  };
  if (stripBtn) {
    stripBtn.addEventListener('click', () => incenseAction?.());
  }
  renderIncense();
  const incenseTick = setInterval(renderIncense, 5000);
  window.addEventListener('pagehide', () => clearInterval(incenseTick), { once: true });

  if (cup && btn && outcome) {
    // 👤 11/12 无抽签机会:按钮保持原样可点(不变暗)——点击弹功德面板换机会
    const shake = () => {
      if (!gateDraw(shake)) return; // ration: one free draw a day — merit buys more
      btn.disabled = true;
      outcome.innerHTML = '';
      hall?.focusAltar(); // 镜头先推近供桌，签动画在特写里才可读
      jar?.reset();
      jar?.startShake();
      // stage 1 (900ms): the jar settles — one random stick springs up
      // carrying its number; the sign's number + name land with the animation
      window.setTimeout(() => {
        const sign = drawSign(liveRand());
        jar?.popStick(`No. ${String(sign.id).padStart(2, '0')}`, sign.name);
        outcome.innerHTML = drawnBanner(sign);
        trackDraw('fortune-stick', sign.id);
        // stage 2 (950ms): the stick stands tall — now the visitor names
        // the ONE thing they asked about; the sign answers that
        window.setTimeout(() => {
          outcome.insertAdjacentHTML('beforeend', focusPanelHTML());
          wireFocusPanel(outcome, (focus, own) => {
            const answer = outcome.querySelector<HTMLElement>('[data-answer]');
            if (!answer) return;
            // a custom question routes to its nearest lens (love/career/money)
            const lens = focus === 'own' ? focusForQuestion(own) : focus;
            answer.innerHTML = renderFocusedReading(sign, lens, undefined, {
              echo: own,
              note: 'The jar does not take it personally — shake again whenever you are ready.',
            });
            answer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
          outcome.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          btn.disabled = false;
          // 结果读完滑回院中望门（用户盯着解签面板时镜头已悄然归位）
          window.setTimeout(() => hall?.unfocusAltar(), 4200);
        }, 950);
      }, 900);
    };
    btn.addEventListener('click', shake);
  }
</script>
