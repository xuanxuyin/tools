---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Jar3d from '../components/Jar3d.astro';
import { SIGNS } from '../data/signs';
---
<Base
  title="Fortune Stick — Chinese Fortune Sticks (Kau Cim) | Fortune Willow"
  description="Draw a Chinese fortune stick, kau cim style: shake the jar, draw one of 100 hand-written fortunes — readings for love, money, and career, plus lucky numbers."
>
  <section class="tool-shell card">
    <div class="tool-stage">
      <h1>Fortune Stick</h1>
      <p class="tool-sub">
        Let the jar do the picking. Hold your question in mind — no typing yet.
        Shake the jar: the stick that leaps out already carries the answer. When it lands, tell the
        jar what you asked about.
      </p>
      <div class="ritual-row">
        <!-- left column: the incense ritual (claim, light, offer) before the shake -->
        <div class="ritual-incense" data-incense-root></div>
        <!-- right column: the draw itself (moved right) -->
        <div class="ritual-draw">
          <div class="ritual-head">The draw</div>
          <div class="stage-visual">
            <div class="cup-wrap" data-cup>
              <!-- 3D jar (three.js), shared with the homepage (Jar3d.astro):
                   sits still until shaken — the jar rattles at an angle and one
                   stick tumbles out, landing on the ground with its number tag
                   up. The placeholder is the SVG jar (same art): instant paint,
                   and the no-WebGL fallback -->
              <Jar3d uid="fs-en" />
            </div>
          </div>
          <button class="btn" data-shake>Draw a stick</button>
          <p class="hint">A hundred sticks in the jar · one draw a day</p>
        </div>
      </div>
    </div>
    <div data-ration-slot></div>
    <div class="tool-outcome" data-outcome></div>
  </section>

  <section class="section">
    <div class="kicker">How it works</div>
    <h2>Three steps, one answer</h2>
    <div class="steps">
      <div class="step"><div class="n">1 · Hold it in mind</div><p>Think of one real question — a decision you are actually sitting on — and keep it to yourself for now. "Should I take the job?" works better than "what is life?"</p></div>
      <div class="step"><div class="n">2 · Shake</div><p>The jar rattles hard and one stick tumbles out, landing on the ground — number and name showing. The jar never knew your question — that is the point. It breaks the loop of going in circles.</p></div>
      <div class="step"><div class="n">3 · Name it</div><p>Now say what you asked about: love, money, career — or your own words. The stick answers the question you actually asked, plus one concrete step to take.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">When people draw</div>
    <h2>The moments a stick helps most</h2>
    <div class="scene-list">
      <div class="scene"><span class="glyph"><img src="/img/icons/briefcase.png" width="24" height="24" alt="" /></span><p><b>Offer on the table.</b> Take it, push back, or walk? A fortune will not decide for you — but it will show you which part you already decided.</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/mobile_phone.png" width="24" height="24" alt="" /></span><p><b>The text you keep rewriting.</b> Send it or let it go? Draw a stick, then notice whether you are hoping for a blessing or permission to let go.</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/money_with_wings.png" width="24" height="24" alt="" /></span><p><b>Big purchase circling your brain.</b> The money verdict gives you a lens that is not "how bad do I want it."</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/compass.png" width="24" height="24" alt="" /></span><p><b>A quiet crossroads.</b> No crisis, just two decent paths. Random input is honest exactly where your own analysis is tired.</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">The tradition</div>
    <h2>An old jar, a new deck</h2>
    <div class="tradition">
      <p>
        This jar is our take on <b>kau cim</b> — the bamboo-stick oracle you will find in Chinese
        temples anywhere in the world, and one of the quiet fixtures of Chinese fortune telling. A
        tall cylinder holds a hundred numbered sticks. You hold one question, shake until a stick
        leaps out on its own, and read the verse that matches its number. That is the whole
        machine: no fee, no appointment — just a jar and a question, the same way it has run for
        centuries.
      </p>
      <p>
        We kept the machine and rewrote every word. The form is unchanged — a hundred sticks, one
        question, the jar decides — but each verse here is written in-house in plain English, for
        decisions you actually face this week: the offer, the lease, the text you keep rewriting.
        Temple verses lean on classical poems and dynasty-old stories; ours keep the story and
        drop the riddles.
      </p>
      <p>
        Want the temple texts themselves? The traditional set most temples carry — the Guanyin
        hundred, with two editions of every poem, classical verdicts, and the old stories — lives
        on our site too, in Chinese: <a href="/guanyin-lingqian/">browse the full Guanyin
        oracle</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="kicker">Questions</div>
    <h2>Fortune Stick FAQ</h2>
    <Faq items={[
      { q: 'Are the fortunes random?', a: 'Yes — the stick you draw is a fair random pick from our library. What is not random is the writing: every fortune is hand-written and edited in-house, with readings tuned to love, money, and career situations.' },
      { q: 'Why do I pick a topic after drawing?', a: 'That is how the ritual works: hold the question privately while the jar shakes, then say what it was about — that is what the fortune answers. Your words route the reading to love, money, or career; anything else gets the fortune’s overall reading. One question, one answer: shake again to ask something else.' },
      { q: 'Where do these fortunes come from?', a: 'They are original adaptations of kau cim, the temple tradition of numbered fortune sticks: each stick carries a poem, a story, and guidance. We rewrote the tradition for modern life — no riddles about harvests, just clear guidance with the story kept in. The unrewritten temple texts (the Guanyin hundred, in Chinese) have their own page here too.' },
      { q: 'Can I ask about another person?', a: 'You can, but the strongest questions are about your own next move. "Should I text them back?" beats "does he miss me?" — one gives you an action, the other just gives you a mood.' },
      { q: 'What are the three grades?', a: 'Every stick is graded as a Blessing (green light energy), a Nudge (steady, practical guidance), or a Gentle Warning (slow down and protect what matters). We do not write doom-and-gloom fortunes — a hard truth, yes; despair, never.' },
      { q: 'Does the same stick always mean the same thing?', a: 'The words are fixed; the reading is yours. Sign 01 on a Tuesday about a job and the same sign on a Friday about a relationship will land differently — that gap is where your own judgment lives, and it is the most reliable oracle in this whole site.' },
    ]} />
  </section>
</Base>

<style>
  .tradition { max-width: 720px; }
  .tradition p { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.75; margin: 0 0 10px; }
  .tradition a { font-weight: 600; }
</style>

<script>
  import { drawSign, liveRand } from '../lib/engine';
  import { trackDraw } from '../lib/track';
  import { gateDraw } from '../lib/rationUi';
  import { drawnBanner, renderFocusedReading } from '../lib/reading';
  import { wireShareButtons } from '../lib/shareCard';
  import { focusPanelHTML, wireFocusPanel } from '../lib/focusFlow';
  import { focusForQuestion } from '../lib/classify';
  import { bootJar } from '../lib/jarBoot';
  import type { Jar3D } from '../lib/jar3d';

  const cup = document.querySelector<HTMLElement>('[data-cup]');
  const btn = document.querySelector<HTMLButtonElement>('[data-shake]');
  const outcome = document.querySelector<HTMLElement>('[data-outcome]');
  const jarHost = document.querySelector<HTMLElement>('[data-jar3d]');
  // the incense widget loads lazily — never blocks the draw
  const incenseRoot = document.querySelector<HTMLElement>('[data-incense-root]');
  if (incenseRoot) {
    const { mountIncense } = await import('../lib/incenseUi');
    mountIncense(incenseRoot);
  }
  // the 3D jar loads lazily — three.js never blocks the page; bootJar is
  // the shared boot (same promise as the component sweep) and fades the
  // SVG placeholder out only after the canvas has painted
  let jar: Jar3D | null = null;
  if (jarHost) void bootJar(jarHost).then((made) => { jar = made; });
  wireShareButtons(); // 揭示 banner 里的 [data-share-card](分享带日期签卡)
  if (cup && btn && outcome) {
    // 👤 11/12 无抽签机会:按钮保持原样可点(不变暗)——点击弹功德面板换机会
    const shake = () => {
      if (!gateDraw(shake)) return; // ration: one free draw a day — merit buys more
      btn.disabled = true;
      outcome.innerHTML = '';
      jar?.reset();
      jar?.startShake();
      // stage 1 (900ms): the jar settles — one random stick springs up
      // carrying its number; the sign's number + name land with the animation
      window.setTimeout(() => {
        const sign = drawSign(liveRand());
        jar?.popStick(`No. ${String(sign.id).padStart(2, '0')}`, sign.name);
        outcome.innerHTML = drawnBanner(sign);
        trackDraw('fortune-stick', sign.id);
        // stage 2 (950ms): the stick stands tall — now the visitor names
        // the ONE thing they asked about; the sign answers that
        window.setTimeout(() => {
          outcome.insertAdjacentHTML('beforeend', focusPanelHTML());
          wireFocusPanel(outcome, (focus, own) => {
            const answer = outcome.querySelector<HTMLElement>('[data-answer]');
            if (!answer) return;
            // a custom question routes to its nearest lens (love/career/money)
            const lens = focus === 'own' ? focusForQuestion(own) : focus;
            answer.innerHTML = renderFocusedReading(sign, lens, undefined, {
              echo: own,
              note: 'The jar does not take it personally — shake again whenever you are ready.',
            });
            answer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
          outcome.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          btn.disabled = false;
        }, 950);
      }, 900);
    };
    btn.addEventListener('click', shake);
  }
</script>
