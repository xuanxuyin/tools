---
import { iconSvg } from '../../lib/icons';
import Base from '../../layouts/Base.astro';
import { dailyDraw } from '../../lib/engine';
import { renderReading } from '../../lib/reading';

// Dated archive of the shared daily fortune. The epoch is the first build day;
// every build regenerates epoch..today, so the archive only ever grows
// (PLAYBOOK: dated URLs are the ticket tarot.com already holds, not a bonus).
// NOTE: getStaticPaths is hoisted by Astro — keep literals inline, no consts.
export function getStaticPaths() {
  const days: string[] = [];
  // 11-06: the list page links build-day minus 7 days; epoch must sit at or
  // before that window's floor or the oldest two archive links 404.
  const start = new Date('2026-11-06' + 'T00:00:00Z').getTime();
  const end = Date.now();
  for (let t = start; t <= end; t += 86400000) {
    days.push(new Date(t).toISOString().slice(0, 10));
  }
  if (days.length === 0) days.push(new Date().toISOString().slice(0, 10));
  return days.map((date) => ({ params: { date }, props: { date, days } }));
}
const { date, days } = Astro.props;
const { sign, digits } = dailyDraw(date);
const pretty = new Date(date + 'T12:00:00').toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const i = days.indexOf(date);
const prev = i > 0 ? days[i - 1] : null;
const next = i < days.length - 1 ? days[i + 1] : null;
---
<Base
  title={`Daily Fortune — ${pretty} | Fortune Willow`}
  description={`The shared daily fortune for ${pretty}: one hand-written reading with love, money, and career guidance plus three lucky numbers. Same fortune everyone got that day, on the record.`}
>
  <section class="tool-shell card">
    <div class="tool-stage">
      <div class="kicker">One per day · from the archive</div>
      <h1>Daily Fortune</h1>
      <p class="date-line">{pretty}</p>
      <p class="tool-sub">
        The fortune everyone got on this date — drawn at midnight, on the record for good.
      </p>
    </div>
    <div class="tool-outcome" set:html={renderReading(sign, digits, { luckyLabel: 'That day’s lucky numbers' })}></div>
  </section>

  <section class="section">
    <div class="scene-list">
      {prev && (
        <a class="scene" href={`/daily-fortune/${prev}/`}>
          <span class="glyph"><Fragment set:html={iconSvg('arrowLeft', 20)} /></span>
          <p><b>Previous day</b><br /><span class="muted">{prev}</span></p>
        </a>
      )}
      <a class="scene" href="/daily-fortune/">
        <span class="glyph"><img src="/img/icons/sun.png" width="24" height="24" alt="" /></span>
        <p><b>Today’s fortune</b><br /><span class="muted">fresh at midnight</span></p>
      </a>
      {next && (
        <a class="scene" href={`/daily-fortune/${next}/`}>
          <span class="glyph"><Fragment set:html={iconSvg('arrowRight', 20)} /></span>
          <p><b>Next day</b><br /><span class="muted">{next}</span></p>
        </a>
      )}
    </div>
  </section>
</Base>
