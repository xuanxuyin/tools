---
import Base from '../layouts/Base.astro';
---
<Base
  title="Your Readings — Optional Account | Fortune Willow"
  description="Every tool on Fortune Willow works without an account. Sign in with Google only if you want your reading history to follow you across devices — we store your draws, nothing else."
>
  <section class="section">
    <div class="kicker">Optional account</div>
    <h1>Your readings</h1>
    <p class="tool-sub" style="margin:0 auto 1.4rem">
      Every tool stays free and works without an account. Signing in does exactly one thing:
      it syncs your reading history across devices. We store your draws — no profile, no
      questions, nothing else.
    </p>
    <div class="card" style="padding:1.4rem" id="account-root" data-account-root>
      <p class="muted">Loading…</p>
    </div>
  </section>
</Base>

<script>
  import { SIGNS } from '../data/signs';
  import { trackDraw } from '../lib/track';

  const root = document.querySelector<HTMLElement>('[data-account-root]');
  const TOOL_LABEL: Record<string, string> = {
    'fortune-stick': 'Fortune Stick',
    'number-oracle': 'Number Oracle',
    'fortune-cookie': 'Fortune Cookie',
  };

  function signedOut() {
    if (!root) return;
    root.innerHTML = `
      <p>You’re not signed in. The tools don’t care — sign in only if you want your history synced.</p>
      <p style="margin-top:1rem"><a class="btn" href="/api/auth/google">Sign in with Google</a></p>
      <p class="hint" style="margin-top:1rem">We receive your Google name, email, and profile picture to create the account — and store your draws. Nothing else is collected.</p>
    `;
  }

  function signedIn(user: { name: string | null; email: string | null }, history: { tool: string; sign_id: number; created_at: string }[]) {
    if (!root) return;
    const rows = history.length
      ? `<div class="scene-list" style="margin-top:1rem">${history
          .map((h) => {
            const sign = SIGNS.find((s) => s.id === h.sign_id);
            const when = new Date(h.created_at + 'Z').toLocaleString();
            return `<a class="scene" href="/signs/${sign?.slug ?? ''}/">
              <span class="glyph">№${String(h.sign_id).padStart(2, '0')}</span>
              <p><b>${sign?.name ?? 'Fortune No. ' + h.sign_id}</b><br />
              <span class="muted">${TOOL_LABEL[h.tool] ?? h.tool} · ${when}</span></p>
            </a>`;
          })
          .join('')}</div>`
      : '<p class="muted" style="margin-top:1rem">No readings yet — draw your first fortune and it lands here.</p>';
    root.innerHTML = `
      <p>Signed in as <b>${user.name ?? user.email ?? 'you'}</b> ${user.email && user.name ? `<span class="muted">(${user.email})</span>` : ''}</p>
      ${rows}
      <p style="margin-top:1.2rem"><a class="btn" href="/api/auth/logout">Sign out</a></p>
    `;
  }

  async function load() {
    if (!root) return;
    try {
      const r = await fetch('/api/me');
      if (r.status === 401) return signedOut();
      if (!r.ok) throw new Error(String(r.status));
      const data = (await r.json()) as {
        user: { name: string | null; email: string | null };
        history: { tool: string; sign_id: number; created_at: string }[];
      };
      signedIn(data.user, data.history);
    } catch {
      root.innerHTML =
        '<p class="muted">History sync ships with the live site — this preview runs without the account layer.</p>';
    }
  }

  void load();
  void trackDraw; // (kept for future account-page draws; tree-shaken otherwise)
</script>
