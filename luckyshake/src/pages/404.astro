---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found | Fortune Willow"
  description="That page isn't in the jar. Shake for a fortune instead."
  noindex
>
  <main class="wrap">
    <section class="card notfound">
      <p class="kicker">404 · nothing drawn</p>
      <h1>That page isn't in the jar.</h1>
      <p class="lead">
        The link went looking for a fortune and came back empty-handed. Happens. The jar,
        at least, never misses — shake it and take a stick.
      </p>
      <div class="nf-cta">
        <a class="btn" href="/fortune-stick/">Shake the jar</a>
        <a class="nf-alt" href="/">All the tools</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .notfound {
    max-width: 560px;
    margin: 9vh auto 0;
    text-align: center;
    padding: 40px 30px;
  }
  .notfound h1 {
    font-size: 1.7rem;
    font-weight: 700;
    margin: 10px 0 12px;
  }
  .notfound .lead {
    color: var(--ink-soft);
    margin: 0 auto 22px;
    max-width: 40ch;
  }
  .nf-cta {
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  .nf-alt {
    color: var(--ink-soft);
    font-weight: 600;
  }
</style>
