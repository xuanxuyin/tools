---
import Base from '../../../layouts/Base.astro';
import { dailyDraw } from '../../../lib/engine';
import { renderReading } from '../../../lib/reading';
import { ZODIAC } from '../../../data/zodiac';
import ZodiacMark from '../../../components/ZodiacMark.astro';

// 与 /zh/daily-fortune/ 同一支签，按本星座的读法呈现。
export function getStaticPaths() {
  return ZODIAC.map((z) => ({ params: { zodiac: z.slug }, props: { z } }));
}
const { z } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const { sign, digits } = dailyDraw(today);
const pretty = new Date(today + 'T12:00:00').toLocaleDateString('zh-CN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang="zh"
  title={`${z.nameZh}今日运势（${z.datesZh}）— 今天的签 | LuckyShake（内部审阅版）`}
  description={`${z.nameZh}的今日签：${z.introZh.slice(0, 60)}…完整签文附感情、财运、事业判词与幸运数字。`}
>
  <section class="tool-shell card">
    <div class="tool-stage">
      <div class="kicker"><ZodiacMark slug={z.slug} name={z.nameZh} size={20} /> {z.nameZh} · {z.datesZh}</div>
      <h1>{z.nameZh} · 今日运势</h1>
      <p class="date-line" data-date-title>{pretty}</p>
      <p class="tool-sub">{z.introZh}</p>
    </div>
    <div class="tool-outcome" data-outcome data-build-day={today} set:html={renderReading(sign, digits, { lang: 'zh', luckyLabel: '今日幸运数字', note: '今天所有人同一支签——这一页是你的星座读法。' })}></div>
  </section>

  <section class="section">
    <div class="scene-list">
      {ZODIAC.filter((o) => o.slug !== z.slug).slice(0, 4).map((o) => (
        <a class="scene" href={`/zh/horoscope/${o.slug}/`}>
          <span class="glyph"><ZodiacMark slug={o.slug} name={o.nameZh} /></span>
          <p><b>{o.nameZh}</b><br /><span class="muted">{o.datesZh}</span></p>
        </a>
      ))}
      <a class="scene" href="/zh/horoscope/">
        <span class="glyph">☰</span>
        <p><b>全部星座</b><br /><span class="muted">换一个看</span></p>
      </a>
    </div>
  </section>
</Base>

<script>
  // 访客当天日期与构建日不同时，客户端重渲染。
  import { dailyDraw } from '../../../lib/engine';
  import { renderReading } from '../../../lib/reading';

  const el = document.querySelector<HTMLElement>('[data-outcome]');
  const titleEl = document.querySelector<HTMLElement>('[data-date-title]');
  const today = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD
  const buildDay = el?.dataset.buildDay ?? today;
  if (el && today !== buildDay) {
    const { sign, digits } = dailyDraw(today);
    el.innerHTML = renderReading(sign, digits, {
      lang: 'zh',
      luckyLabel: '今日幸运数字',
      note: '今天所有人同一支签——这一页是你的星座读法。',
    });
    if (titleEl) {
      titleEl.textContent = new Date(today + 'T12:00:00').toLocaleDateString('zh-CN', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    }
  }
</script>
