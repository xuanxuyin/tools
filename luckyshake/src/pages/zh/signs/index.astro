---
import Base from '../../../layouts/Base.astro';
import { SIGNS } from '../../../data/signs';
---
<Base
  lang="zh"
  title="百签签库 — 每一支手写签全文 | LuckyShake（内部审阅版）"
  description="LuckyShake 全部一百支手写签：每支签的签名、典故与感情、财运、事业三路判词。抽到过的签，全文在此打开。"
>
  <section class="section">
    <div class="kicker">签库</div>
    <h1>一百支签</h1>
    <p class="tool-sub" style="margin:0 auto 1.4rem">
      签筒里的每一支，全在此列——但签库是攒出来的，不是翻出来的。落在你手里的签（任何工具抽到的）
      在这里全文打开；其余的先蒙着，等机缘把它们递到你手上。常来常抽，看着自己的架子慢慢摆满。
    </p>
    <div class="scene-list">
      {SIGNS.map((s) => (
        <a class="scene" href={`/zh/signs/${s.slug}/`} data-sign-card={s.id}>
          <span class="glyph">第{String(s.id).padStart(2, '0')}</span>
          <p>
            <b>{s.nameZh}</b><br />
            <span class="muted">{s.titleZh}</span>
          </p>
          <span class="lock-flag" aria-hidden="true">🔒</span>
        </a>
      ))}
    </div>
  </section>
  <script>
    import { applyGating } from '../../../lib/unlock';
    applyGating();
  </script>
</Base>
