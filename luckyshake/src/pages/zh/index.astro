---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ToolCard from '../../components/ToolCard.astro';
import Jar3d from '../../components/Jar3d.astro';
import { dailyDraw } from '../../lib/engine';
import { SIGN_VERSES } from '../../data/signVerses';

const today = new Date().toISOString().slice(0, 10);
const { sign, digits } = dailyDraw(today);
const verse = SIGN_VERSES[sign.id]?.zh ?? [];
const GRADE_LABEL: Record<typeof sign.grade, string> = {
  blessing: '吉签',
  nudge: '提点',
  'gentle-warning': '温和提醒',
};
---
<Base
  lang="zh"
  title="Fortune Willow — 问一件事，摇一支签（内部审阅版）"
  description="抽签、数字神谕、魔力8号球、抛硬币、签语饼——每个工具都回答你的问题，还告诉你下一步怎么做。一百支签，一签三读。"
>
  <!-- hero:左文案右签筒(与 EN 主页同版式,👤 11/10) -->
  <section class="hero">
    <div class="hero-copy">
      <div class="kicker">诚心一问 · 摇筒见签</div>
      <h1>摇一摇签筒<br />让答案自己现前</h1>
      <p class="hero-sub">
        一百支签，支支有签诗——感情、财运、事业，一签三读。
      </p>
      <div class="hero-cta">
        <a class="btn" href="/zh/fortune-stick/">抽一支签 →</a>
        <a class="hero-alt" href="/zh/daily-fortune/">或看今日共享签文</a>
      </div>
    </div>
    <div class="hero-stage">
      <Jar3d uid="hero-zh" class="hero-jar" />
      <div class="hero-vert">问 · 摇 · 读</div>
    </div>
  </section>

  <!-- features:四栏细线分隔 -->
  <section class="features" aria-label="这里的抽取有什么不同">
    <div class="feature">
      <img class="fico" src="/img/jar-icon.png" width="30" height="30" alt="" />
      <b>摇筒抽签</b>
      <span>签筒会倾、签会哗啦作响、一支自己立起来。没有「立即揭晓」按钮。</span>
    </div>
    <div class="feature">
      <img class="fico" src="/img/icons/scroll.png" width="30" height="30" alt="" />
      <b>一首签诗</b>
      <span>每支签都带着四句签诗——签这个物件本身，不是一句话。</span>
    </div>
    <div class="feature">
      <img class="fico" src="/img/icons/crystal_ball.png" width="30" height="30" alt="" />
      <b>一签三读</b>
      <span>感情、财运、事业，句句落在当下——晚饭前就用得上。</span>
    </div>
    <div class="feature">
      <img class="fico" src="/img/icons/calendar.png" width="30" height="30" alt="" />
      <b>日日新机缘</b>
      <span>每天一支新签文，日日是好日；抽过的签解锁整座签库。</span>
    </div>
  </section>

  <!-- draw duo:左仪式卡 + 右今日签文卡 -->
  <section class="draw-duo">
    <div class="card draw-left">
      <p class="draw-q">心里存着所问之事。<br />再摇——一念诚，一签应。</p>
      <Jar3d uid="draw-zh" class="draw-jar" />
      <a class="shake-ring" href="/zh/fortune-stick/">抽签</a>
      <p class="hint">诚则灵：认真摇一次，胜过乱点十下。</p>
    </div>
    <div class="card draw-right" data-today-card data-build-day={today}>
      <span class="grade-pill" data-today-grade>{GRADE_LABEL[sign.grade]}</span>
      <div class="verse-hero" data-today-verse>
        {verse.map((line) => <p>{line}</p>)}
      </div>
      <div class="verse-attr" data-today-attr>—— 第 {String(sign.id).padStart(2, '0')} 签 · {sign.nameZh}</div>
      <hr class="hairline" />
      <div class="verse-mean">
        <b>今日所指</b>
        <p data-today-overall>{sign.overallZh}</p>
      </div>
      <a class="verse-link" href="/zh/daily-fortune/">看今日完整签文 →</a>
    </div>
  </section>

  <!-- 功德箱:每日一次免费抽取 + 功德经济(👤 2026-11-11) -->
  <section class="section merit-band" id="merit-box">
    <div class="kicker">功德箱</div>
    <h2>一日一缘，功德可续</h2>
    <p style="max-width:640px;margin:0 auto">
      机缘一日一缘，六道具共之——问得诚，签才应。欲再问，聚功德：每小时一点，捐 8 点入箱，即续一缘。
    </p>
    <div class="merit-scene" data-merit-root></div>
  </section>

  <section class="section">
    <div class="kicker">完整道具家族</div>
    <h2>挑一个道具，把问题问出来</h2>
    <div class="grid-tools">
      <ToolCard href="/zh/fortune-stick/" icon="jar" name="抽签" desc="摇签筒抽一签——感情、财运、事业，一签三读。" go="去用 →" />
      <ToolCard href="/zh/number-oracle/" icon="input_numbers" name="数字神谕" desc="掷出 0–9 三个数字——数字定签，同时成为你的幸运数字。" go="去用 →" />
      <ToolCard href="/zh/magic-8-ball/" icon="pool_8_ball" name="魔力8号球" desc="经典答案——每个都附一句实话：这答案该怎么用。" go="去用 →" />
      <ToolCard href="/zh/yes-no/" icon="check_mark_button" name="是与非" desc="干净的五五开，附理由和下一步。不含糊，不搞「再想想」。" go="去用 →" />
      <ToolCard href="/zh/coin-flip/" icon="coin" name="抛硬币" desc="正面为是，反面为否。史上最古老的裁决器，现在不用掏口袋。" go="去用 →" />
      <ToolCard href="/zh/fortune-cookie/" icon="fortune_cookie" name="签语饼" desc="掰开一支：一句签语 + 三个幸运数字，数字还能解锁完整签文。" go="去用 →" />
      <ToolCard href="/zh/horoscope/" icon="crystal_ball" name="星座今日签" desc="今天的签，用你的星座来读——同一支签，你的星座读法。" go="去用 →" />
      <ToolCard href="/zh/signs/" icon="scroll" name="百签签库" desc="一百支签全部在列：签名、典故与判词。" go="去用 →" />
    </div>
  </section>

  <section class="section">
    <div class="kicker">为什么这样做</div>
    <h2>随机是天成，签文有来处</h2>
    <p>
      抛一次硬币能终结一场争论，但它不会告诉你周一该干什么。这里的每个工具都把「诚实的随机」
      和「有来处的文字」配成一对：一个理由、一个典故、针对感情/财运/事业的一句判词，
      和一件晚饭前就能动手做的具体小事。
    </p>
    <div class="steps">
      <div class="step"><div class="n">百签文库</div><p>每支签都有吉语、典故、判词和一个行动——承老签之制，为今日之事重裁。没有回收来的段子堆。</p></div>
      <div class="step"><div class="n">三档分级，不造口业</div><p>吉签、提点、温和提醒。扎心的真话可以有，绝人希望的口业，一句不造。</p></div>
      <div class="step"><div class="n">万事不出你的浏览器</div><p>一切都在本地跑。你输入的问题不会离开你的设备——因为它根本没有地方可去。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">常见问题</div>
    <h2>FAQ</h2>
    <Faq items={[
      { q: '免费吗？', a: '免费——无需账号。一天一缘，全站道具共用；功德每小时聚一点（上限 24），捐 8 点入箱即续一缘。本站靠你的注意力活着，不靠你的邮箱。' },
      { q: '我该用哪个工具？', a: '手头要拍板的小事？用「是与非」或抛硬币。工作/感情/钱上的大问题？用抽签。想让数字替你选？用数字神谕。只想来个十秒的仪式？掰支签语饼。' },
      { q: '签文可以当生活参考吗？', a: '可以参考——随机是真的，写作也是真的。但 Fortune Willow 只用于娱乐和自我梳理，不是医疗、法律或财务建议；涉及健康、安全和他人的事，请找专业人士，别问 8 号球。' },
      { q: '签文是哪来的？', a: '改编自抽签这个老传统——编号的签，配一首签诗、一个典故、一段指引——改写成今天真会遇到的那些事：offer、群聊、存钱目标、第二次约会。' },
      { q: '会抽到重复的签吗？', a: '会——抽取是公平且独立的，重复的概率该多少就多少。但如果同一支签一再现前，那多半不是概率：是它在等你把那句话读懂。' },
    ]} />
  </section>

  <!-- 水墨山影收尾 -->
  <div class="mountains" aria-hidden="true">
    <svg viewBox="0 0 1200 150" preserveAspectRatio="none">
      <path d="M0 150 L0 92 Q140 34 300 76 T580 60 T860 86 T1100 54 L1200 78 L1200 150 Z" fill="#3d3628" opacity="0.055" />
      <path d="M0 150 L0 118 Q180 72 380 106 T720 94 T1020 116 L1200 100 L1200 150 Z" fill="#3d3628" opacity="0.09" />
    </svg>
  </div>
</Base>

<script>
  // 访客日期晚于构建日时，客户端重算今日签，保证右卡「今日」不失真。
  import { dailyDraw } from '../../lib/engine';
  import { SIGN_VERSES } from '../../data/signVerses';

  const GRADE_LABEL: Record<string, string> = {
    blessing: '吉签',
    nudge: '提点',
    'gentle-warning': '温和提醒',
  };
  const card = document.querySelector<HTMLElement>('[data-today-card]');
  const today = new Date().toLocaleDateString('en-CA');
  const buildDay = card?.dataset.buildDay ?? today;
  if (card && today !== buildDay) {
    const { sign } = dailyDraw(today);
    const grade = card.querySelector<HTMLElement>('[data-today-grade]');
    const verseEl = card.querySelector<HTMLElement>('[data-today-verse]');
    const attr = card.querySelector<HTMLElement>('[data-today-attr]');
    const overall = card.querySelector<HTMLElement>('[data-today-overall]');
    if (grade) grade.textContent = GRADE_LABEL[sign.grade] ?? '';
    if (verseEl) {
      const lines = SIGN_VERSES[sign.id]?.zh ?? [];
      verseEl.innerHTML = lines.map((l) => `<p>${l}</p>`).join('');
    }
    if (attr) attr.textContent = `—— 第 ${String(sign.id).padStart(2, '0')} 签 · ${sign.nameZh}`;
    if (overall) overall.textContent = sign.overallZh;
  }

  // 功德箱组件
  const { mountMeritBox } = await import('../../lib/rationUi');
  const meritRoot = document.querySelector<HTMLElement>('[data-merit-root]');
  if (meritRoot) mountMeritBox(meritRoot);
</script>
