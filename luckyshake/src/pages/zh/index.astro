---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ToolCard from '../../components/ToolCard.astro';
import JarSvg from '../../components/JarSvg.astro';
import { dailyDraw } from '../../lib/engine';
import { SIGN_VERSES } from '../../data/signVerses';

const today = new Date().toISOString().slice(0, 10);
const { sign, digits } = dailyDraw(today);
const verse = SIGN_VERSES[sign.id]?.zh ?? [];
const GRADE_LABEL: Record<typeof sign.grade, string> = {
  blessing: '吉签',
  nudge: '提点',
  'gentle-warning': '温和提醒',
};
---
<Base
  lang="zh"
  title="LuckyShake — 问一件事，摇一支签（内部审阅版）"
  description="抽签、数字神谕、魔力8号球、抛硬币、签语饼——每个工具都回答你的问题，还告诉你下一步怎么做。全部签文手写，免费，无需注册。"
>
  <!-- hero:左文案右签筒(与 EN 主页同版式,👤 11/10) -->
  <section class="hero">
    <div class="hero-copy">
      <div class="kicker">问 · 摇 · 得到真答案</div>
      <h1>摇一摇签筒。<br />得到值得细读的答案。</h1>
      <p class="hero-sub">
        手写签文库，配感情、财运、事业三路解读——一个老仪式，对准现代人的决定。
      </p>
      <p class="hero-meta"><b>100</b> 支手写签 · 免费 · 无需注册</p>
      <div class="hero-cta">
        <a class="btn" href="/zh/fortune-stick/">抽一支签 →</a>
        <a class="hero-alt" href="/zh/daily-fortune/">或看今日共享签文</a>
      </div>
    </div>
    <div class="hero-stage">
      <JarSvg uid="hero-zh" class="hero-jar" />
      <div class="hero-vert">问 · 摇 · 读</div>
    </div>
  </section>

  <!-- features:四栏细线分隔 -->
  <section class="features" aria-label="这里的抽取有什么不同">
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M10 4v7M18 4v7" />
        <rect x="6" y="11" width="16" height="13" rx="3" />
        <path d="M10 16.5h8" opacity=".5" />
      </svg>
      <b>真实的摇签</b>
      <span>签筒会倾、签会哗啦作响、一支自己立起来。没有「立即揭晓」按钮。</span>
    </div>
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M9 4h10M9 9h10M9 14h6M9 19h8" />
      </svg>
      <b>每签一首签诗</b>
      <span>每支签都带着四句签诗——签这个物件本身，不是一句话。</span>
    </div>
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 7c-2-1.7-4.8-2.2-8-2.2v16.4c3.2 0 6 .5 8 2.2 2-1.7 4.8-2.2 8-2.2V4.8c-3.2 0-6 .5-8 2.2v16.2" />
      </svg>
      <b>大白话解读</b>
      <span>感情、财运、事业的判词，都是晚饭前用得上的句子。</span>
    </div>
    <div class="feature">
      <svg class="fico" width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="6" width="20" height="17" rx="3" />
        <path d="M4 11.5h20M9.5 3v5M18.5 3v5" />
        <path d="M10 18l3 3 5.5-5.5" />
      </svg>
      <b>天天回来看</b>
      <span>每天都有新的共享签文，抽过的签会解锁整个签库。</span>
    </div>
  </section>

  <!-- draw duo:左仪式卡 + 右今日签文卡 -->
  <section class="draw-duo">
    <div class="card draw-left">
      <p class="draw-q">心里想着要问的事。<br />然后摇——认认真真摇一次。</p>
      <JarSvg uid="draw-zh" class="draw-jar" />
      <a class="shake-ring" href="/zh/fortune-stick/">摇签</a>
      <p class="hint">认真摇一次，胜过乱点十下。</p>
    </div>
    <div class="card draw-right" data-today-card data-build-day={today}>
      <span class="grade-pill" data-today-grade>{GRADE_LABEL[sign.grade]}</span>
      <div class="verse-hero" data-today-verse>
        {verse.map((line) => <p>{line}</p>)}
      </div>
      <div class="verse-attr" data-today-attr>—— 第 {String(sign.id).padStart(2, '0')} 签 · {sign.nameZh}</div>
      <hr class="hairline" />
      <div class="verse-mean">
        <b>今日所指</b>
        <p data-today-overall>{sign.overallZh}</p>
      </div>
      <a class="verse-link" href="/zh/daily-fortune/">看今日完整签文 →</a>
    </div>
  </section>

  <section class="section">
    <div class="kicker">完整道具家族</div>
    <div class="grid-tools">
      <ToolCard href="/zh/fortune-stick/" glyph="🥢" name="抽签" desc="摇签筒抽一支手写签，附感情、财运、事业三路解读。" go="去用 →" />
      <ToolCard href="/zh/number-oracle/" glyph="🔢" name="数字神谕" desc="掷出 0–9 三个数字——数字定签，同时成为你的幸运数字。" go="去用 →" />
      <ToolCard href="/zh/magic-8-ball/" glyph="🎱" name="魔力8号球" desc="经典答案——每个都附一句实话：这答案该怎么用。" go="去用 →" />
      <ToolCard href="/zh/yes-no/" glyph="✅" name="是与非" desc="干净的五五开，附理由和下一步。不含糊，不搞「再想想」。" go="去用 →" />
      <ToolCard href="/zh/coin-flip/" glyph="🪙" name="抛硬币" desc="正面为是，反面为否。史上最古老的裁决器，现在不用掏口袋。" go="去用 →" />
      <ToolCard href="/zh/fortune-cookie/" glyph="🥠" name="签语饼" desc="掰开一支：一句签语 + 三个幸运数字，数字还能解锁完整签文。" go="去用 →" />
      <ToolCard href="/zh/horoscope/" glyph="♈" name="星座今日签" desc="今天的签，用你的星座来读——同一支签，你的星座读法。" go="去用 →" />
      <ToolCard href="/zh/signs/" glyph="📜" name="百签签库" desc="整个手写签库全部在列：每支签的名字、典故与三路判词。" go="去用 →" />
    </div>
  </section>

  <section class="section">
    <div class="kicker">为什么这样做</div>
    <h2>随机是工具，解读才是服务</h2>
    <p>
      抛一次硬币能终结一场争论，但它不会告诉你周一该干什么。这里的每个工具都把「诚实的随机」
      和「一层真写作」配成一对：一个理由、一个典故、针对感情/财运/事业的一句判词，
      和一件晚饭前就能动手做的具体小事。
    </p>
    <div class="steps">
      <div class="step"><div class="n">手写签文库</div><p>每支签都有吉语、典故、三路判词和一个行动——本站自己写、自己编。没有回收来的段子堆。</p></div>
      <div class="step"><div class="n">三档分级，不写凶签</div><p>吉签、提点、温和提醒。扎心的话可以有，让人绝望的话一条不写。</p></div>
      <div class="step"><div class="n">隐私默认</div><p>一切都在你浏览器里跑。你输入的问题不会离开你的设备——因为它根本没有地方可去。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">常见问题</div>
    <h2>FAQ</h2>
    <Faq items={[
      { q: '免费吗？', a: '完全免费——所有工具、无限次、无需账号。本站靠留住你的注意力活着，不靠你的邮箱。' },
      { q: '我该用哪个工具？', a: '手头要拍板的小事？用「是与非」或抛硬币。工作/感情/钱上的大问题？用抽签。想让数字替你选？用数字神谕。只想来个十秒的仪式？掰支签语饼。' },
      { q: '这些签文是认真的吗？', a: '随机是真的，写作也是真的——但 LuckyShake 只用于娱乐和自我梳理，不是医疗、法律或财务建议。涉及健康、安全和他人的事，请找专业人士，别问 8 号球。' },
      { q: '签文是哪来的？', a: '改编自抽签这个老传统——编号的签，配一首签诗、一个典故、一段指引——重写成贴合现代美国生活的版本：offer、群聊、存钱目标、第二次约会。' },
      { q: '会抽到重复的签吗？', a: '会——抽取是公平且独立的，重复的概率该多少就多少。如果同一支签老是找上你，那就是你和你命运之间的事了。' },
    ]} />
  </section>

  <!-- 水墨山影收尾 -->
  <div class="mountains" aria-hidden="true">
    <svg viewBox="0 0 1200 150" preserveAspectRatio="none">
      <path d="M0 150 L0 92 Q140 34 300 76 T580 60 T860 86 T1100 54 L1200 78 L1200 150 Z" fill="#3d3628" opacity="0.055" />
      <path d="M0 150 L0 118 Q180 72 380 106 T720 94 T1020 116 L1200 100 L1200 150 Z" fill="#3d3628" opacity="0.09" />
    </svg>
  </div>
</Base>

<script>
  // 访客日期晚于构建日时，客户端重算今日签，保证右卡「今日」不失真。
  import { dailyDraw } from '../../lib/engine';
  import { SIGN_VERSES } from '../../data/signVerses';

  const GRADE_LABEL: Record<string, string> = {
    blessing: '吉签',
    nudge: '提点',
    'gentle-warning': '温和提醒',
  };
  const card = document.querySelector<HTMLElement>('[data-today-card]');
  const today = new Date().toLocaleDateString('en-CA');
  const buildDay = card?.dataset.buildDay ?? today;
  if (card && today !== buildDay) {
    const { sign } = dailyDraw(today);
    const grade = card.querySelector<HTMLElement>('[data-today-grade]');
    const verseEl = card.querySelector<HTMLElement>('[data-today-verse]');
    const attr = card.querySelector<HTMLElement>('[data-today-attr]');
    const overall = card.querySelector<HTMLElement>('[data-today-overall]');
    if (grade) grade.textContent = GRADE_LABEL[sign.grade] ?? '';
    if (verseEl) {
      const lines = SIGN_VERSES[sign.id]?.zh ?? [];
      verseEl.innerHTML = lines.map((l) => `<p>${l}</p>`).join('');
    }
    if (attr) attr.textContent = `—— 第 ${String(sign.id).padStart(2, '0')} 签 · ${sign.nameZh}`;
    if (overall) overall.textContent = sign.overallZh;
  }
</script>
