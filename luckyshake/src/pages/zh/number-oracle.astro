---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
---
<Base
  lang="zh"
  title="数字神谕 — 默念一问，掷数成签 | Fortune Willow（内部审阅版）"
  description="默念所问，掷出 0–9 三个随机数字——数定签现，签应所问。三个数字既是一支签，也是你的幸运数字。"
>
  <section class="tool-shell card">
    <div class="tool-stage">
      <h1>数字神谕</h1>
      <p class="tool-sub">
        把问题存于心中，掷出 0–9 三个数字——数落，签现。三数既替你择定一支签，
        也是你此问的幸运数字。数落定后，再言所问何事。
      </p>
      <div class="stage-visual">
        <div class="slots">
          <div class="slot" data-slot="0">–</div>
          <div class="slot" data-slot="1">–</div>
          <div class="slot" data-slot="2">–</div>
        </div>
      </div>
      <button class="btn" data-roll>掷出我的数字</button>
    </div>
    <div data-ration-slot></div>
    <div class="tool-outcome" data-outcome></div>
  </section>

  <section class="section">
    <div class="kicker">掷数三步</div>
    <h2>三数落定，一签现前</h2>
    <div class="steps">
      <div class="step"><div class="n">1 · 存问</div><p>数字滚动时，心中只存一问。问要落到行动处：走还是留，发还是删，现在还是再等等。</p></div>
      <div class="step"><div class="n">2 · 掷数</div><p>每一格落定一个 0–9 的数。前两位替你择签；三数齐落，便是你此问的幸运数字。</p></div>
      <div class="step"><div class="n">3 · 点题</div><p>数落签现，签号签名一同亮出。此刻再言所问：感情、财运、事业——或自己写一句。签只应你真正所问的那一面，再赠一件可行的下一步。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">何时掷数</div>
    <h2>最宜掷数的时刻</h2>
    <div class="scene-list">
      <div class="scene"><span class="glyph"><img src="/img/icons/red_heart.png" width="24" height="24" alt="" /></span><p><b>感情：</b>「这段感情，还值不值得再认真谈一次？」——感情判词早已候在那里。</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/money_bag.png" width="24" height="24" alt="" /></span><p><b>财运：</b>「现在买，还是接着存？」——付款之前，且听财运判词怎么说。</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/briefcase.png" width="24" height="24" alt="" /></span><p><b>事业：</b>「新岗位，我该不该举手？」——事业判词给你一个周一就能用的框架。</p></div>
      <div class="scene"><span class="glyph"><img src="/img/icons/input_numbers.png" width="24" height="24" alt="" /></span><p><b>幸运数字：</b>为这一周掷一把——有人携三数过一周、买一注、破一个僵局，或者决定「三家里吃哪家」。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="kicker">常见问题</div>
    <h2>数字神谕 FAQ</h2>
    <Faq items={[
      { q: '数字是真随机吗？', a: '是——三数各自独立、公平掷出，全程在你浏览器里完成。没有服务器、没有定数，也不记得你上次掷过什么。' },
      { q: '三个数字怎么变成一支签？', a: '前两位数字为你定签，三个数字同时是你的幸运数字。' },
      { q: '同一个问题能掷两次吗？', a: '能，但神谕无记性——重掷是全新一抽，不是第二意见。若你一直掷到满意为止，不妨停下来观照一下：答案早已在你心里。' },
      { q: '掷完数字才选题，有什么讲究？', a: '这个仪式是故意倒着走的：数在滚时，问题只存于心——签不应未问之问。待三数落定，再言所问，签便只答那一面。自己写的问题会自动对准最相近的一面：问感情看感情判词，问钱看财运判词，问工作看事业判词，都不沾边的才给整体签文。一事一签：答完即锁定——想问别的，再掷一次。' },
      { q: '这背后是什么传统？', a: '数字问事，是问卜最古老的门之一：存一问，让机缘给出一个小小的征象，再以一部签书解它。我们建在同一条骨架上——诚实的随机，手写的解读。' },
      { q: '为什么只有 0 到 9？', a: '一位数里 0 到 9 最顺手——随手一掷就是三个。而它们能落成的每一种组合，都通向一支认真写满的手写签，而不是一段通用套话。' },
    ]} />
  </section>
</Base>

<script>
  import { rollDigits, signForDigits, liveRand } from '../../lib/engine';
  import { trackDraw } from '../../lib/track';
  import { gateDraw } from '../../lib/rationUi';
  import { drawnBanner, renderFocusedReading } from '../../lib/reading';
  import { focusPanelHTML, wireFocusPanel } from '../../lib/focusFlow';
  import { focusForQuestion } from '../../lib/classify';

  const slots = Array.from(document.querySelectorAll<HTMLElement>('[data-slot]'));
  const btn = document.querySelector<HTMLButtonElement>('[data-roll]');
  const outcome = document.querySelector<HTMLElement>('[data-outcome]');

  // 数字落定 → 签号和签名先亮出来，此时用户才点明问的是哪一件事——
  // 感情 / 财运 / 事业 / 自己写一句
  const reveal = (digits: [number, number, number], fromCookie = false) => {
    if (!btn || !outcome) return;
    const sign = signForDigits(digits);
    trackDraw('number-oracle', sign.id);
    outcome.innerHTML =
      `<p class="center muted" style="margin-bottom:14px">${fromCookie ? '签语饼给你的这三个数字，选中了' : '你的三个数字选中了'} <b>${sign.nameZh}</b></p>` +
      drawnBanner(sign, 'zh') +
      focusPanelHTML('zh');
    wireFocusPanel(outcome, (focus, own) => {
      const answer = outcome.querySelector<HTMLElement>('[data-answer]');
      if (!answer) return;
      // 自提问题路由到最相近的一面（感情/事业/财运）
      const lens = focus === 'own' ? focusForQuestion(own) : focus;
      answer.innerHTML = renderFocusedReading(sign, lens, digits, {
        lang: 'zh',
        echo: own,
        note: '这三个数字是你的了——有人携它过一周，有人拿它定一注、破一个僵局。',
      });
      answer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    outcome.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    btn.disabled = false;
  };

  const roll = () => {
    if (!btn || !outcome) return;
    if (!gateDraw(roll)) return; // ration: manual rolls draw from the daily ration (the ?d= cookie handoff stays free)
    btn.disabled = true;
    outcome.innerHTML = '';
    const digits = rollDigits(liveRand());
    slots.forEach((slot) => slot.classList.add('rolling'));
    const spin = window.setInterval(() => {
      slots.forEach((slot) => (slot.textContent = String(Math.floor(Math.random() * 10))));
    }, 70);
    window.setTimeout(() => {
      window.clearInterval(spin);
      slots.forEach((slot, i) => {
        slot.textContent = String(digits[i]);
        slot.classList.remove('rolling');
      });
      reveal(digits);
    }, 1400);
  };

  btn?.addEventListener('click', roll);

  // 深链：/zh/number-oracle/?d=472 —— 自动解析指定数字（签语饼的交接）
  const params = new URLSearchParams(window.location.search);
  const d = params.get('d');
  if (d && /^\d{3}$/.test(d) && btn && outcome) {
    const dd: [number, number, number] = [Number(d[0]), Number(d[1]), Number(d[2])];
    btn.disabled = true;
    slots.forEach((slot, i) => (slot.textContent = String(dd[i])));
    reveal(dd, true);
  }
</script>
