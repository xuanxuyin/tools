---
import Base from '../../layouts/Base.astro';
import { ZODIAC } from '../../data/zodiac';
import ZodiacMark from '../../components/ZodiacMark.astro';
---
<Base
  title="Daily Fortune Horoscope — Today's Fortune for Every Zodiac Sign | Fortune Willow"
  description="One hand-written daily horoscope, shared by everyone and read through your sign's temperament. Pick your zodiac sign for today's fortune, lucky numbers, and one small step."
>
  <section class="section">
    <div class="kicker">Today’s horoscope, by sign</div>
    <h1>Today’s fortune, read through your sign</h1>
    <p class="tool-sub" style="margin:0 auto 1.4rem">
      Everyone who visits today gets the same fortune — but an Aries and a Capricorn will run with
      it in completely different directions. Pick your sign for the full reading and how it actually lands on you.
    </p>
    <div class="scene-list">
      {ZODIAC.map((z) => (
        <a class="scene" href={`/horoscope/${z.slug}/`}>
          <span class="glyph"><ZodiacMark slug={z.slug} name={z.name} /></span>
          <p>
            <b>{z.name}</b><br />
            <span class="muted">{z.dates}</span>
          </p>
        </a>
      ))}
    </div>
  </section>
</Base>
