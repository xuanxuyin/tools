---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { SIGNS } from '../data/signs';

// 2026-11-17 词战役批（63K fortune cookie 主词加厚）：语料样本按语气分布手选
// （luck/career/love/money/humor/patience/warmth/caution），slug 锚定不随牌序漂移，
// 每条内链 /signs/{slug}/ 给 100 单签页喂链接权重。
const sampleSlugs = [
  'unplanned-door',
  'master-carpenter',
  'the-morning-ritual',
  'the-honest-merchant',
  'quiet-joy-guarded',
  'the-invited-hall',
  'the-third-visit',
  'the-returned-favor',
  'the-playful-seal',
];
const samples = sampleSlugs
  .map((slug) => SIGNS.find((s) => s.slug === slug))
  .filter((s): s is (typeof SIGNS)[number] => Boolean(s));

// FAQ 数据抽成常量：页面渲染与 FAQPage 结构化数据共用一份（fortune-stick 同款）
const faqItems = [
  { q: 'Are the fortunes random?', a: 'The pick is random; the writing is not. Every line is hand-written for this site — none of those thousand recycled one-liners scraped off takeout boxes.' },
  { q: 'What do the lucky numbers do?', a: 'They are yours to use however you like — or treat them as a key: the same three digits at our Number Oracle pull up the full fortune reading your cookie was pointing at all along.' },
  { q: 'Can I crack more than one?', a: 'One a day, like every tool here — the free draw is shared across the site. Merit dropped in the box can buy you a second crack. Tradition, for what it’s worth, agrees with the ration: the first fortune of the day is the one that counts.' },
  { q: 'Why is there a "learn more" link with my cookie?', a: 'Because a one-liner is an appetizer. Your numbers map to a complete fortune with love, money, and career readings — the cookie is the doorway, the oracle is the room.' },
  { q: 'Do you write lucky numbers on every fortune?', a: 'Yes — three digits, every cookie, matching the classic takeout format. Where else would lottery optimism come from?' },
  { q: 'Is this a fortune cookie generator?', a: 'That is the honest job description. Click, and the cookie splits: a message plus three lucky numbers, same format as the takeout classic — except this jar holds 100 original fortunes instead of the usual recycled one-liners.' },
  { q: 'What are fortune cookie messages usually about?', a: 'The classics skew practical: patience, money habits, the people around you, and a nudge to act this week. Ours keep that tradition — every fortune is one or two sentences you can actually use, with a complete reading behind it if the numbers point there.' },
  { q: 'Where do fortune cookies come from?', a: 'The oldest ancestor is a Kyoto rice cracker with a paper slip folded inside. The modern version took shape in California bakeries — Los Angeles and San Francisco both claim the original, and the paperwork dispute is genuinely unresolved.' },
  { q: 'Do fortune cookies come true?', a: 'Some do, some don’t — same as advice from a sharp friend. The useful move is treating a fortune as a question worth a second look, not a prophecy with a deadline. Tradition, for what it’s worth, gives the first cookie of the day the edge.' },
];

const toolLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Fortune Cookie',
  applicationCategory: 'EntertainmentApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Crack a virtual fortune cookie online, free: a one-line message plus three lucky numbers, drawn from a jar of 100 original fortunes — with a full reading behind every number.',
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Base
  title="Fortune Cookie — Crack One Open Online | Fortune Willow"
  description="Crack a virtual fortune cookie online: your message plus three lucky numbers, and the numbers unlock a full fortune reading. 100 original fortunes in the jar — free, no sign-up."
>
  <script type="application/ld+json" set:html={JSON.stringify(toolLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <section class="tool-shell card">
    <div class="tool-stage">
      <div class="kicker">A message · three lucky digits</div>
      <h1>Fortune Cookie</h1>
      <p class="tool-sub">
        Crack one open: your message slides out with three lucky numbers — and those numbers are a
        key to a full fortune reading at the Number Oracle.
      </p>
      <div class="stage-visual">
        <div class="cookie" data-cookie>
          <div class="fortune-slip" data-slip></div>
