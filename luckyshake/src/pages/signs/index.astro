---
import Base from '../../layouts/Base.astro';
import { SIGNS } from '../../data/signs';
---
<Base
  title="The 100 Fortunes — Every Hand-Written Fortune in the Library | LuckyShake"
  description="The full library of LuckyShake's 100 hand-written fortunes — every sign with its name, story, and readings for love, money, and career. Signs open in full as you draw them."
>
  <section class="section">
    <div class="kicker">The library</div>
    <h1>The 100 fortunes</h1>
    <p class="tool-sub" style="margin:0 auto 1.4rem">
      Every fortune in the jar, on the record — and earned, not browsed. Each sign that has
      landed in your hands (any tool, any day) opens here in full; the rest wait veiled until
      chance hands them over. Draw, come back, and watch your shelf fill in.
    </p>
    <div class="scene-list">
      {SIGNS.map((s) => (
        <a class="scene" href={`/signs/${s.slug}/`} data-sign-card={s.id}>
          <span class="glyph">№{String(s.id).padStart(2, '0')}</span>
          <p>
            <b>{s.name}</b><br />
            <span class="muted">{s.title}</span>
          </p>
          <span class="lock-flag" aria-hidden="true">🔒</span>
        </a>
      ))}
    </div>
  </section>
  <script>
    import { applyGating } from '../../lib/unlock';
    applyGating();
  </script>
</Base>
