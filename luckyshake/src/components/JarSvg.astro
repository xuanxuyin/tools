---
/**
 * 竹签筒(👤 11/10:主页签筒/签直接搬参考稿 D:\new\build\build 的手绘 SVG,
 * 不再用红漆筒照片)。参考稿 JS buildSticks() 按固定公式生成 9 支竹签
 * (rot=(i-4)*3.4°, x=117+(i-4)*8.4, h=66+(i*11)%26, 红头),此处为纯静态
 * 站点,公式结果直接算死烘焙进标记。uid 用于同页两处实例的渐变 id 防冲突。
 */
interface Props {
  uid: string;
  class?: string;
}
const { uid, class: className } = Astro.props;
const sticks = [
  { rot: -13.6, x: 83.4, h: 66, y: 66 },
  { rot: -10.2, x: 91.8, h: 77, y: 55 },
  { rot: -6.8, x: 100.2, h: 88, y: 44 },
  { rot: -3.4, x: 108.6, h: 73, y: 59 },
  { rot: 0, x: 117, h: 84, y: 48 },
  { rot: 3.4, x: 125.4, h: 69, y: 63 },
  { rot: 6.8, x: 133.8, h: 80, y: 52 },
  { rot: 10.2, x: 142.2, h: 91, y: 41 },
  { rot: 13.6, x: 150.6, h: 76, y: 56 },
];
---
<svg class:list={["jar-svg", className]} viewBox="0 0 240 300" role="img" aria-label="A bamboo jar full of fortune sticks">
  <defs>
    <linearGradient id={`bamboo-${uid}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#c08a44" />
      <stop offset="0.22" stop-color="#e0b172" />
      <stop offset="0.62" stop-color="#d3a05c" />
      <stop offset="1" stop-color="#b07a38" />
    </linearGradient>
    <linearGradient id={`goldBand-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e7cd8e" />
      <stop offset="0.5" stop-color="#c49b4c" />
      <stop offset="1" stop-color="#a67f33" />
    </linearGradient>
    <linearGradient id={`stickGrad-${uid}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f7ecd2" />
      <stop offset="0.5" stop-color="#fdf7e6" />
      <stop offset="1" stop-color="#e8d8b4" />
    </linearGradient>
  </defs>
  <ellipse cx="120" cy="285" rx="74" ry="9" fill="rgba(110,70,30,.14)" />
  <g class="tube-g">
    <g class="sticks-g">
      {sticks.map((s) => (
        <g transform={`rotate(${s.rot} 120 120)`}>
          <rect x={s.x} y={s.y} width="7.4" height={s.h} rx="3.4" fill={`url(#stickGrad-${uid})`} stroke="rgba(150,110,60,.45)" stroke-width="0.7" />
          <rect x={s.x} y={s.y} width="7.4" height="13" rx="3.4" fill="#9e2b22" />
        </g>
      ))}
    </g>
    <path d="M74 126c0-6 8-9 46-9s46 3 46 9v121c0 12-10 20-46 20s-46-8-46-20V126z" fill={`url(#bamboo-${uid})`} stroke="#9a6d31" stroke-width="1.1" />
    <path d="M86 130v116M104 128v122M136 128v122M154 130v116" stroke="rgba(120,72,24,.20)" stroke-width="1.6" stroke-linecap="round" />
    <ellipse cx="120" cy="126" rx="46" ry="11" fill="#b07a38" stroke="#9a6d31" stroke-width="1.1" />
    <ellipse cx="120" cy="127" rx="37" ry="8" fill="#5d3418" />
    <ellipse cx="120" cy="128" rx="37" ry="8" fill="#3f2210" opacity=".55" />
    <rect x="70" y="176" width="100" height="9" rx="4" fill={`url(#goldBand-${uid})`} opacity=".95" />
    <rect x="70" y="232" width="100" height="9" rx="4" fill={`url(#goldBand-${uid})`} opacity=".95" />
    <rect x="96" y="190" width="48" height="40" rx="4" fill="#8f2319" opacity=".92" />
    <text x="120" y="217" text-anchor="middle" font-family="'Noto Serif SC','Songti SC','SimSun',serif" font-size="24" fill="#f4ddb0">籤</text>
  </g>
</svg>
