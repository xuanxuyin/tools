---
import { jarMarkBareSvg } from '../lib/icons';

interface Props {
  title: string;
  description: string;
  /** 'zh-live' renders a production zh page: zh-CN html, EN nav, no lang toggle
      (the /zh/ review mirror this once served was retired 2026-11-13, backup in
      docs/luckyshake/zh-mirror-backup-2026-11-13/) */
  lang?: 'en' | 'zh-live';
  /** 404 only — keep the error page out of the index (repo discipline: the one noindex page) */
  noindex?: boolean;
  /** og:image path (site-relative) — sign archive pages pass their share card */
  image?: string;
}
const { title, description, lang = 'en', noindex = false, image } = Astro.props;
const zhLive = lang === 'zh-live';
const navEn = [
  { href: '/fortune-stick/', label: 'Fortune Stick', tone: 'red' },
  { href: '/number-oracle/', label: 'Number Oracle', tone: 'blue' },
  { href: '/magic-8-ball/', label: 'Magic 8-Ball', tone: 'navy' },
  { href: '/yes-no/', label: 'Yes or No', tone: 'green' },
  { href: '/coin-flip/', label: 'Coin Flip', tone: 'gold' },
  { href: '/fortune-cookie/', label: 'Cookie', tone: 'orange' },
  { href: '/daily-fortune/', label: 'Today', tone: 'pink' },
  { href: '/horoscope/', label: 'Horoscope', tone: 'violet' },
  { href: '/signs/', label: 'The 100', tone: 'teal' },
];
// 👤 11/12 unslop:导航安静化 —— 当前页 pill 保留工具身份色,其余纸底墨字
const here = Astro.url.pathname.replace(/index\.html$/, '').replace(/(?!^|\/)$/, '/');
const isActive = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang={zhLive ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (GA4) — single gtm.js line; the container is bound to the
         GA4 web stream in Google's admin, so no gtag('js'/'config') needed -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-T8D28VJC"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    {image && <meta name="twitter:image" content={new URL(image, Astro.site).href} />}
    <meta property="og:site_name" content="Fortune Willow" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="/"><span class="brand-mark"><Fragment set:html={jarMarkBareSvg(17)} /></span>Fortune Willow</a>
        <nav class="nav-links">
          {navEn.map((n) => <a class:list={[`tone-${n.tone}`]} href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-links">
          {navEn.map((n) => <a href={n.href}>{n.label}</a>)}
          {/* 站级入口:传统观音百签(zh 生产页,无导航位——页脚全站带出,锚文本带 zh 关键词) */}
          <a href="/guanyin-lingqian/">观音灵签 · Guanyin Oracle</a>
        </div>
        {zhLive ? (
          <p class="fine">
            Fortune Willow 仅用于娱乐与观照。签是镜，照见的是你——要紧的事，信自心的判断。
          </p>
        ) : (
          <p class="fine">
            Fortune Willow is for fun and reflection. The draw is random, the reading is real — but on
            anything that truly matters, trust yourself. Every fortune here is hand-written in-house.
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
