---
import { jarMarkBareSvg } from '../lib/icons';

interface Props {
  title: string;
  description: string;
  /** 'zh' renders the review-only Chinese layer (/zh/ pages, deleted at launch) */
  lang?: 'en' | 'zh';
}
const { title, description, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const navEn = [
  { href: '/fortune-stick/', label: 'Fortune Stick', tone: 'red' },
  { href: '/number-oracle/', label: 'Number Oracle', tone: 'blue' },
  { href: '/magic-8-ball/', label: 'Magic 8-Ball', tone: 'navy' },
  { href: '/yes-no/', label: 'Yes or No', tone: 'green' },
  { href: '/coin-flip/', label: 'Coin Flip', tone: 'gold' },
  { href: '/fortune-cookie/', label: 'Cookie', tone: 'orange' },
  { href: '/daily-fortune/', label: 'Today', tone: 'pink' },
  { href: '/horoscope/', label: 'Horoscope', tone: 'violet' },
  { href: '/signs/', label: 'The 100', tone: 'teal' },
];
const navZh = [
  { href: '/zh/fortune-stick/', label: '抽签', tone: 'red' },
  { href: '/zh/number-oracle/', label: '数字神谕', tone: 'blue' },
  { href: '/zh/magic-8-ball/', label: '魔力8号球', tone: 'navy' },
  { href: '/zh/yes-no/', label: '是与非', tone: 'green' },
  { href: '/zh/coin-flip/', label: '抛硬币', tone: 'gold' },
  { href: '/zh/fortune-cookie/', label: '签语饼', tone: 'orange' },
  { href: '/zh/daily-fortune/', label: '今日运势', tone: 'pink' },
  { href: '/zh/horoscope/', label: '星座', tone: 'violet' },
  { href: '/zh/signs/', label: '签库', tone: 'teal' },
];
const nav = zh ? navZh : navEn;
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    {zh && (
      <div class="review-banner">
        🛠 内部审阅版（中文对照）· 仅供本地看效果，上线前整站移除 —— 正式版为英文。
      </div>
    )}
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={zh ? '/zh/' : '/'}><span class="brand-mark"><Fragment set:html={jarMarkBareSvg(17)} /></span>Fortune Willow</a>
        <a href={zh ? '/' : '/zh/'} class="lang-toggle" data-lang-toggle>{zh ? 'EN' : '中文'}</a>
        <nav class="nav-links">
          {nav.map((n) => <a class:list={[`tone-${n.tone}`]} href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-links">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        {zh ? (
          <p class="fine">
            Fortune Willow 仅用于娱乐与观照自心。签是镜子，照见的始终是你自己——真正要紧的事，信你自心的判断。
            所有签文均为本站手写。（此中文版为内部审阅用，上线前移除。）
          </p>
        ) : (
          <p class="fine">
            Fortune Willow is for fun and reflection. The draw is random, the reading is real — but on
            anything that truly matters, trust yourself. Every fortune here is hand-written in-house.
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
<script>
  // Language toggle: flip the /zh prefix of the current path (runtime-known).
  // EN-only pages (e.g. /account/) have no /zh mirror — toggle falls back home.
  const t = document.querySelector<HTMLAnchorElement>('[data-lang-toggle]');
  if (t) {
    const p = window.location.pathname;
    const isZh = p === '/zh' || p === '/zh/' || p.startsWith('/zh/');
    if (!isZh && p.startsWith('/account')) t.href = '/';
    else t.href = isZh ? p.replace(/^\/zh\/?/, '/') || '/' : '/zh' + (p === '/' ? '' : p);
  }
</script>
