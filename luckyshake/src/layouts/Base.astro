---
interface Props {
  title: string;
  description: string;
  /** 'zh' renders the review-only Chinese layer (/zh/ pages, deleted at launch) */
  lang?: 'en' | 'zh';
}
const { title, description, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const navEn = [
  { href: '/fortune-stick/', label: 'Fortune Stick' },
  { href: '/number-oracle/', label: 'Number Oracle' },
  { href: '/magic-8-ball/', label: 'Magic 8-Ball' },
  { href: '/yes-no/', label: 'Yes or No' },
  { href: '/coin-flip/', label: 'Coin Flip' },
  { href: '/fortune-cookie/', label: 'Cookie' },
  { href: '/daily-fortune/', label: 'Today' },
  { href: '/horoscope/', label: 'Horoscope' },
  { href: '/signs/', label: 'The 100' },
];
const navZh = [
  { href: '/zh/fortune-stick/', label: '抽签' },
  { href: '/zh/number-oracle/', label: '数字神谕' },
  { href: '/zh/magic-8-ball/', label: '魔力8号球' },
  { href: '/zh/yes-no/', label: '是与非' },
  { href: '/zh/coin-flip/', label: '抛硬币' },
  { href: '/zh/fortune-cookie/', label: '签语饼' },
  { href: '/zh/daily-fortune/', label: '今日运势' },
  { href: '/zh/horoscope/', label: '星座' },
  { href: '/zh/signs/', label: '签库' },
];
const nav = zh ? navZh : navEn;
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    {zh && (
      <div class="review-banner">
        🛠 内部审阅版（中文对照）· 仅供本地看效果，上线前整站移除 —— 正式版为英文。
      </div>
    )}
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href={zh ? '/zh/' : '/'}><span class="brand-mark">✦</span>LuckyShake</a>
        <nav class="nav-links">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={zh ? '/' : '/zh/'} class="lang-toggle" data-lang-toggle>{zh ? 'EN' : '中文'}</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="footer-links">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        {zh ? (
          <p class="fine">
            LuckyShake 仅用于娱乐与自我梳理。随机只是工具，替代不了你自己的判断——真正重要的事，请相信你自己。
            所有签文均为本站手写。（此中文版为内部审阅用，上线前移除。）
          </p>
        ) : (
          <p class="fine">
            LuckyShake is for entertainment and reflection. Randomness is a tool, not a substitute for
            judgment — trust yourself on anything that matters. All fortunes are hand-written in-house.
          </p>
        )}
      </div>
    </footer>
  </body>
</html>
<style is:global>
  @import '../styles/global.css';
</style>
<script>
  // Language toggle: flip the /zh prefix of the current path (runtime-known).
  // EN-only pages (e.g. /account/) have no /zh mirror — toggle falls back home.
  const t = document.querySelector<HTMLAnchorElement>('[data-lang-toggle]');
  if (t) {
    const p = window.location.pathname;
    const isZh = p === '/zh' || p === '/zh/' || p.startsWith('/zh/');
    if (!isZh && p.startsWith('/account')) t.href = '/';
    else t.href = isZh ? p.replace(/^\/zh\/?/, '/') || '/' : '/zh' + (p === '/' ? '' : p);
  }
</script>
