---
import CopyButton from './CopyButton.astro';
import type { RatioRow } from '../lib/mixContent';
import type { ColorDef } from '../data/colors';

interface Props {
  rows: RatioRow[];
  /** Column labels in pctA order (the slug-sorted first color is "A") */
  a: ColorDef;
  b: ColorDef;
}

const { rows, a, b } = Astro.props;
---

<div class="mix-table" role="table" aria-label={`Mixing ratios for ${a.name} and ${b.name}`}>
  <div class="mix-tr mix-th" role="row">
    <span role="columnheader">{a.name}</span>
    <span role="columnheader">{b.name}</span>
    <span role="columnheader">Result</span>
    <span role="columnheader">HEX</span>
    <span role="columnheader" class="visually-hidden">Copy</span>
  </div>
  {rows.map((r) => (
    <div class="mix-tr" role="row">
      <span role="cell">{r.pctA}%</span>
      <span role="cell">{r.pctB}%</span>
      <span role="cell" class="mix-cell-name">
        <span class="mix-swatch" style={`background:${r.hex}`} aria-hidden="true"></span>
        {r.name}
      </span>
      <span role="cell" class="mix-cell-hex">{r.hex}</span>
      <span role="cell"><CopyButton value={r.hex} label={`${r.name} hex code`} /></span>
    </div>
  ))}
</div>

<style>
  .mix-table {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
    overflow-x: auto;
    min-width: min(100%, 26rem);
  }

  .mix-tr {
    display: grid;
    grid-template-columns: 3.5rem 3.5rem minmax(0, 1fr) 6.5rem auto;
    gap: var(--sp-2);
    align-items: center;
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--radius-sm);
  }

  .mix-tr:nth-child(odd):not(.mix-th) {
    background: color-mix(in oklab, var(--accent) 5%, transparent);
  }

  .mix-th {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .mix-cell-name {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-width: 0;
  }

  .mix-swatch {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    flex: none;
  }

  .mix-cell-hex {
    font-family: var(--mono);
    font-size: 0.9rem;
  }
</style>
